@using MainModels.DTOModels
@model PagesViewModel
@{
	ViewData["Title"] = "PayablesSuppliers";
	Layout = "~/Views/Shared/_Layout.cshtml";
	int count = 1;
}


<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
				<a href="/Accounting/Payables" class="breadcrumb-item"> Payables</a>

				<span class="breadcrumb-item active">Customer Payable</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>

<!-- Content area -->
<div class="content">

	<!-- Invoice archive -->
	<div class="card shadow-5">
		<div class="card-header header-elements-inline">
			<h5 class="card-title">Supplier Payable</h5>
			<div class="header-elements">

				<div class="header-elements d-none">
					<div class="d-flex justify-content-center">
					</div>
				</div>
			</div>
		</div>

		<table class="table table-lg invoice-archive">
			<thead>
				<tr>
					<th>#</th>
					<th>Customer Name</th>
					<th>Status</th>
					<th>Due Date</th>
					<th>Total Amount</th>
					<th>Total Received</th>
					<th>Total Balance</th>

					<th class="text-center">Actions</th>
				</tr>
			</thead>
			<tbody>
				@Html.AntiForgeryToken()
				@foreach (var item in Model.AccountPayables)
				{

					<tr class="bg-light">
						<td>@count</td>
						<td>
							<h6 class="mb-0">
								@item.SupplierBusinessName	
							</h6>
						</td>
						
						<td>
							@item.Status

						</td>
						<td>
							@item?.DueDate
						</td>
						<td>
							<h6 class="mb-0 font-weight-bold">@item?.Amount </h6>
						</td>
						<td>
							<h6 class="mb-0 font-weight-bold">
								<input data-supplierId="@item?.SupplierId"
									   data-payableentry="@item.Apid"
									   type="number"
									   step="0.01"
									   class="form-control paidAmount"
									   min="0" />
							</h6>
						</td>
						<td class="balance-cell"><h6 class="mb-0 font-weight-bold">@item?.Balance</h6></td>

						<td class="text-center">
							<div class="list-icons list-icons-extended">
								
								<button type="button" class="btn btn-sm btn-primary btn-pay"
										data-payableentry="@item.Apid"
										data-supplierId="@item.SupplierId">
									Pay
								</button>

							</div>
						</td>
					</tr>


				}
			</tbody>
		</table>
	</div>
	<!-- /invoice archive -->

</div>

<script>
	$(function () {
		// helper: get antiforgery token value
		function getAntiForgeryToken() {
			// look for hidden input generated by @Html.AntiForgeryToken()
			return $('input[name="__RequestVerificationToken"]').val();
		}

		// click handler on Receive button
		$(document).on('click', '.btn-pay', function (e) {
			e.preventDefault();
			var $btn = $(this);
			var $row = $btn.closest('tr');
			debugger
			// read data
			var apId = $btn.data('payableentry') || $row.find('.paidAmount').data('payableentry');
			var supplierId = $btn.data('supplierid') || $row.find('.paidAmount').data('supplierid');
			var $input = $row.find('.paidAmount');
			var rawAmount = $input.val();
			var amount = parseFloat(rawAmount);

			// basic validation
			if (!apId) { alert('AR id missing'); return; }
			if (!supplierId) { alert('Customer id missing'); return; }
			if (isNaN(amount) || amount <= 0) { alert('Enter a valid positive amount'); $input.focus(); return; }

			// Optionally check that amount isn't greater than balance (or allow overpay depending on your rules)
			var balanceText = $row.find('.balance-cell').text().trim();
			var currentBalance = parseFloat(balanceText.replace(/[^0-9\.\-]/g, '')) || 0;
			if (amount > currentBalance) {
				if (!confirm('Amount is greater than outstanding balance. Apply anyway?')) return;
			}

			// UI feedback: disable button while processing
			$btn.prop('disabled', true).text('Processing…');

			var token = getAntiForgeryToken();
			debugger

			$.ajax({
				url: '/Accounting/PayPayment',   // change this to your real controller/action route
				type: 'POST',
				data: {
					__RequestVerificationToken: token,
					apId: apId,
					supplierId: supplierId,
					amount: amount
				},
				success: function (res) {
					if (res && res.success) {
						// update balance & status & received amount (server should return updated values)
						if (res.newBalance !== undefined) {
							$row.find('.balance-cell').html('<h6 class="mb-0 font-weight-bold">' + parseFloat(res.newBalance).toFixed(2) + '</h6>');
						}
						if (res.status) {
							$row.find('.status-cell').text(res.status);
						}
						if (res.paidAmount !== undefined) {
							// optionally update amount-cell or another column if you track total received on list
							$row.find('.amount-cell').html('<h6 class="mb-0 font-weight-bold">' + parseFloat(res.totalAmount).toFixed(2) + '</h6>');
						}

						// clear input
						$input.val('');
						// success UI
						$btn.removeClass('btn-primary').addClass('btn-success').text('Saved');
						setTimeout(function () {
							$btn.prop('disabled', false).removeClass('btn-success').addClass('btn-primary').text('Receive');
						}, 900);
					} else {
						alert(res && res.message ? res.message : 'Failed to save payment');
						$btn.prop('disabled', false).text('Receive');
					}
				},
				error: function (xhr, status, err) {
					console.error(err);
					alert('Error saving payment: ' + (err || status));
					$btn.prop('disabled', false).text('Receive');
				}
			});
		});

		// Optional: support Enter key inside input to trigger button
		$(document).on('keypress', '.paidAmount', function (e) {
			if (e.which === 13) { // Enter
				$(this).closest('tr').find('.btn-pay').trigger('click');
				return false;
			}
		});
	});
</script>
