@using MainModels.DTOModels
@using MainModels.Util
@model PagesViewModel
@{
	ViewData["Title"] = "Requisition";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>

				<span class="breadcrumb-item active">Purchase Requisition</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>

<!-- Content area -->
<div class="content">

	<!-- Invoice archive -->
	<div class="card">

		<form id="formVariant" style="display:block" action="#">
			<div class="row p-2">
				<div class="col-md-2">
					<div id="clock" style="font-size: 24px; font-weight: bold;"></div>
					<div id="date" style="font-size: 18px; color: gray;"></div>
				</div>
				<div class="col-lg-3">
					<div class="form-group">
						<label>Company:</label>
						<select id="company" data-placeholder="Enter 'Company'" class="form-control select-minimum" data-fouc>
							<option value="@AppDataUtility.SessionUser.PersonVM.Branch.Organization.OrganizationId">@AppDataUtility.SessionUser.PersonVM.Branch.Organization.OrganizationName</option>
							<optgroup label="Company">

							</optgroup>
						</select>
					</div>
				</div>
				<div class="col-lg-3">
					<div class="form-group">
						<label>Branch:</label>
						<select id="branch" data-placeholder="Enter 'Branch'" class="form-control select-minimum" data-fouc>
							<option value="@AppDataUtility.SessionUser.PersonVM.Branch.BranchId">@AppDataUtility.SessionUser.PersonVM.Branch.BranchName</option>

							<optgroup label="Branch">

							</optgroup>
						</select>
					</div>
				</div>
				<div class="col-lg-4">
					<div class="form-group">
						<label>Supplier:</label>
						<select id="supplier" data-placeholder="Enter 'Supplier'" class="form-control select-minimum" data-fouc>
							<option>Select Supplier</option>
							<optgroup label="Supplier">
							@foreach (var item in Model.Suppliers)
								{
									<option value="@item.SupplierId"> @item.SupplierBusinessName</option>
								}
							</optgroup>
						</select>
					</div>
				</div>

			</div>


		</form>


	</div>
	<!-- /invoice archive -->
	<div class="card shadow-5">
		<table class="table table-bordered table-responsive p-2">
			<thead>
				<tr>
					<th>
						BarCode
					</th>
					<th>
						Name
					</th>
					<th>
						Color
					</th>
					<th>
						Size
					</th>
					<th>
						Material
					</th>

					<th>
						Purchase Price
					</th>
					<th>
						Qty
					</th>
					<th>
						Total Price
					</th>

				</tr>


			</thead>
			<tbody>
				<tr>
					<td>
						<input data-rowCount="1" type="text" class="form-control barCode" />
					</td>
					<td>
						<input disabled data-rowCount="1" type="text" class="form-control name" />

					</td>
					<td>
						<input disabled data-rowCount="1" type="text" class="form-control color" />

					</td>
					<td>
						<input disabled data-rowCount="1" type="text" class="form-control size" />

					</td>
					<td>
						<input disabled data-rowCount="1" type="text" class="form-control material" />

					</td>
					<td>
						<input data-rowCount="1" type="text" class="form-control purchasePrice" />
					</td>
					<td>
						<input data-rowCount="1" type="text" class="form-control qty" />
					</td>

					<td>
						<input disabled data-rowCount="1" type="text" class="form-control totalPrice" />
					</td>
				</tr>
			</tbody>
		</table>

	</div>
	<div>
		<div class="row">
			<div class="col-lg-8">
			</div>
			<div class="col-lg-4">
				<div class="card shadow-5 p-2">
					<div class="row">
						<div class="col-lg-3">
							<label> <br/>Total:</label>
						</div>
						<div class="col-lg-8">
							<div class="form-group">

								<input id="invoiceTotal" type="text" placeholder="Total" class="form-control" />
							</div>
						</div>
						<div class="col-lg-1"></div>

					</div>
					<div class="row">
						<div class="col-lg-3">
							<label><br /> Discount:</label>
						</div>
						<div class="col-lg-8">
							<div class="form-group">

								<input id="discount" value="0" type="text" placeholder="Discount" class="form-control" />
							</div>
						</div>
						<div class="col-lg-1"></div>

					</div>

					<div class="row">
						<div class="col-lg-3">
							<label><br /> Grand Total:</label>
						</div>
						<div class="col-lg-8">
							<div class="form-group">

								<input id="grandTotal" type="text" placeholder="Grand Total" class="form-control" />
							</div>
						</div>
						<div class="col-lg-1"></div>

					</div>
				
					<div class="card-footer d-flex justify-content-between align-items-center bg-white">
						<button type="submit" class="btn bg-blue">Submit form <i class="icon-paperplane ml-2"></i></button>
					</div>
				
				</div>
			</div>
		</div>
	</div>

</div>
<!-- /content area -->


<script>
	$(document).ready(function(){
		$(document).on('keydown', '.barCode', async function (e) {
			if (e.key === 'Enter') {
				e.preventDefault();

				var barCode = $(this).val();
				var rowCount = parseInt($(this).data('rowcount'));

				var objectData = {
					data: { BarCode: barCode },
					url: '/Purchase/GetVariantbyBarCode'
				};

				const result = await Utility.RequestDataAjax(objectData);

				if (result) {
					const data = result;
				AddRowData(rowCount,data);

					$(`.qty[data-rowcount="${rowCount}"]`).off('keyup').on('keyup', function () {
						var price = parseFloat($(`.purchasePrice[data-rowcount="${rowCount}"]`).val()) || 0;
						var qty = parseFloat($(this).val()) || 0;
						var total = price * qty;
						$(`.totalPrice[data-rowcount="${rowCount}"]`).val(total.toFixed(2));
						setTotalPrice();
					});
					const totalRows = $('.barCode').length;
					const isLastRow = rowCount === totalRows;
					if (isLastRow) {
						const newRowCount = rowCount + 1;
						const newRow = `
							<tr>
								<td><input data-rowcount="${newRowCount}" type="text" class="form-control barCode" /></td>
								<td><input disabled data-rowcount="${newRowCount}" type="text" class="form-control name" /></td>
								<td><input disabled data-rowcount="${newRowCount}" type="text" class="form-control color" /></td>
								<td><input disabled data-rowcount="${newRowCount}" type="text" class="form-control size" /></td>
								<td><input disabled data-rowcount="${newRowCount}" type="text" class="form-control material" /></td>
								<td><input data-rowcount="${newRowCount}" type="text" class="form-control purchasePrice" /></td>
								<td><input data-rowcount="${newRowCount}" type="text" class="form-control qty" /></td>
								<td><input disabled data-rowcount="${newRowCount}" type="text" class="form-control totalPrice" /></td>
							</tr>
						`;

						$(this).closest('tr').after(newRow);
						$(`.barCode[data-rowcount="${newRowCount}"]`).focus();
					}
					else {
						$(`.qty[data-rowcount="${rowCount}"]`).focus();
					}
				} else {
					bootboxAlertAsync("No Record Found", 'No Such Bar Code Exists');
					$(`input[data-rowcount="${rowCount}"]`).val('');
				}
			}
	  });
	  function setTotalPrice(){
		  debugger
			  let invoiceTotal = 0;
			$('.totalPrice').each(function () {
				const val = parseFloat($(this).val()) || 0;
				invoiceTotal += val;
			});

			// Display grand total
			$('#invoiceTotal').val(invoiceTotal.toFixed(2));
			(updateGrandTotal(invoiceTotal));
	   }
	   function updateGrandTotal(invoiceTotal){
				const val = parseFloat($('#discount').val()) || 0;
				let grandTotal = invoiceTotal-val;
				$('#grandTotal').val(grandTotal);
	   }
	   $('#discount').keyup(function(){
		   setTotalPrice();
	   })
	  function AddRowData(rowCount,data){
			$(`.name[data-rowcount="${rowCount}"]`).val(data.ProductName);
					$(`.color[data-rowcount="${rowCount}"]`).val(data.ColorName);
					$(`.size[data-rowcount="${rowCount}"]`).val(data.SizeName);
					$(`.material[data-rowcount="${rowCount}"]`).val(data.MaterialName);
					$(`.purchasePrice[data-rowcount="${rowCount}"]`).val(data.Cost || 0);
					$(`.qty[data-rowcount="${rowCount}"]`).val(1);
					$(`.totalPrice[data-rowcount="${rowCount}"]`).val(data.Cost);
					setTotalPrice();
	  }
	})



</script>

<script>
	function updateDateTime() {
		const now = new Date();

		// Format time
		const hours = String(now.getHours()).padStart(2, '0');
		const minutes = String(now.getMinutes()).padStart(2, '0');
		const seconds = String(now.getSeconds()).padStart(2, '0');
		const timeString = `${hours}:${minutes}:${seconds}`;

		// Format date
		const options = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
		const dateString = now.toLocaleDateString(undefined, options);

		// Update the DOM
		document.getElementById('clock').textContent = timeString;
		document.getElementById('date').textContent = dateString;
	}

	// Initial call and update every second
	updateDateTime();
	setInterval(updateDateTime, 1000);
</script>
