@using MainModels.DTOModels
@using static MainModels.DTOModels.AppConstants
@model PagesViewModel
@{
	ViewData["Title"] = "EditPurchaseOrder";
	Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
				<a href="/Purchase/Requisitions" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Purchase Requisition</a>

				<span class="breadcrumb-item active">Edit Requisitions</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>
<div class="content">
	<!-- Invoice template -->
	<div class="card shadow-5">
		<div class="card-header bg-transparent header-elements-inline">
			<h6 class="card-title">Static invoice</h6>
			<div class="header-elements">
				<button type="button" class="btn btn-light btn-sm ml-3"><i class="icon-printer mr-2"></i> Print</button>
			</div>
		</div>

		<div class="card-body">
			<input type="hidden" id="purchaseMasterId" value="@Model.PurchaseMaster.PurchaseMasterId" />
			<div class="row">
				<div class="col-sm-3">
					<select id="status" name="status" class="form-control form-control-select2" data-placeholder="Select status" disabled>
						@{
							var selectedStatus = Model.PurchaseMaster.Status ?? (int)PurchaseStatus.Draft;
						}
						@foreach (PurchaseStatus status in Enum.GetValues(typeof(PurchaseStatus)))
						{
							<option value="@((int)status)" @(selectedStatus == (int)status ? "selected" : "")>
								@status
							</option>
						}
					</select>
				</div>
				<div class="col-sm-3">
					<input type="text" readonly class="form-control" value="@Model.PurchaseMaster.Supplier.SupplierBusinessName" />
				</div>
				<div class="col-sm-3">
					<input type="text" value="@Model.PurchaseMaster.CreatedOn" readonly class="form-control" />
				</div>
				<div class="col-sm-3">
					<select id="purchaseType" name="purchaseType" class="form-control form-control-select2" data-placeholder="Select status" disabled>
						@{
							var selectedType = Model.PurchaseMaster.PurchaseType ?? (int)PurchaseType.Requisition;
						}
						@foreach (PurchaseType status in Enum.GetValues(typeof(PurchaseType)))
						{
							<option value="@((int)status)" @(selectedType == (int)status ? "selected" : "")>
								@status
							</option>
						}
					</select>
				</div>
			</div>

		</div>

		<div class="table-responsive">
			<table id="table-product" class="table table-lg">
				<thead>
					<tr>
						<th>BarCode</th>
						<th>Description</th>
						<th>Color</th>
						<th>Qty</th>

						<th>Unit Price</th>
						<th>Line Total</th>

					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model.PurchaseMaster.PurchaseDetails)
					{
						<tr>
							<td>@item.ProductVariant.BarCode</td>
							<td>
								<h6 class="mb-0">@item.ProductVariant.Product.ProductName</h6>
								<span class="text-muted">@item.ProductVariant.Product.Brand.BrandName</span>
							</td>
							<td>@item.ProductVariant.Color.ColorName</td>
							<td><input data-purchaseDetailId="@item.PurchaseDetailId" data-purchaseMasterId="@Model.PurchaseMaster.PurchaseMasterId" data-variantId="@item.VariantId" min="1" class="qty" type="number" value="@item.Qty" /></td>

							<td><input class="unitPrice" type="text" value="@item.UnitPrice" /> </td>
							<td><span class="font-weight-semibold lineTotal">@item.LineTotal.Value.ToString("F2")</span></td>
						
						</tr>

					}
				</tbody>
			</table>
		</div>

		<div class="card-body">
			<div class="d-md-flex flex-md-wrap">
				@* 	<div class="pt-2 mb-3">
					<h6 class="mb-3">Authorized person</h6>
					<div class="mb-3">
						<img src="~/global_assets/images/signature.png" width="150" alt="">
					</div>

					<ul class="list-unstyled text-muted">
						<li>Eugene Kopyov</li>
						<li>2269 Elba Lane</li>
						<li>Paris, France</li>
						<li>888-555-2311</li>
					</ul>
				</div> *@

				<div class="pt-2 mb-3 wmin-md-400 ml-auto">
					<h6 class="mb-3">Total due</h6>
					<div class="table-responsive">
						<table class="table">
							<tbody>
								<tr>
									<th>Subtotal:</th>
									<td class="text-right" id="totalAmount">@Model.PurchaseMaster.TotalAmount</td>
								</tr>
								<tr>
									<th>Discount<span class="font-weight-normal"></span></th>
									<td class="text-right"><input id="discount" type="text" value="@Model.PurchaseMaster.DiscountAmount" autocomplete="off" /></td>
								</tr>
								<tr>
									<th>Total:</th>
									<td class="text-right text-primary"><h5 class="font-weight-semibold" id="grandTotal">@Model.PurchaseMaster.GrandTotal</h5></td>
								</tr>
							</tbody>
						</table>
					</div>

					<div class="text-right mt-3">
						<button id="recievedData" type="button" class="btn btn-primary btn-labeled btn-labeled-left"><b><i class="icon-paperplane"></i></b> Send invoice</button>
					</div>
				</div>
			</div>
		</div>

		@* 	<div class="card-footer">
			<span class="text-muted">Thank you for using Limitless. This invoice can be paid via PayPal, Bank transfer, Skrill or Payoneer. Payment is due within 30 days from the date of delivery. Late payment is possible, but with with a fee of 10% per month. Company registered in England and Wales #6893003, registered office: 3 Goodman Street, London E1 8BF, United Kingdom. Phone number: 888-555-2311</span>
		</div> *@
	</div>

</div>
<script>
	$(document).ready(function(){
		$('#recievedData').click(async function(e){
			
			Utility.SpinnerMessageParent('recievedData','Loading...');
				var allRowsData = [];
			 $('#table-product tbody tr').each(function () {
				var $row = $(this);

				var rowData = {
					barCode: $row.find('td:eq(0)').text().trim(),
					productName: $row.find('td:eq(1) h6').text().trim(),
					brandName: $row.find('td:eq(1) span').text().trim(),
					color: $row.find('td:eq(2)').text().trim(),
					qty: parseFloat($row.find('.qty').val()) || 0,
					unitPrice: parseFloat($row.find('.unitPrice').val()) || 0,
					lineTotal: parseFloat($row.find('.lineTotal').text()) || 0,
					purchaseDetailId: $row.find('.qty').data('purchasedetailid'),
					purchaseMasterId: $row.find('.qty').data('purchasemasterid'),
					VariantId: $row.find('.qty').data('variantid')

				};
				debugger
				allRowsData.push(rowData);
			});
			var pmId=$('#purchaseMasterId').val()
			var grnData={
				PurchaseMasterId:pmId,
				DiscountAmount:$('#discount').val(),
				TotalAmount:parseFloat($('#totalAmount').text()),
				GrandTotal: parseFloat($('#grandTotal').text()),

				PurchaseDetails:allRowsData
			}
			debugger
			console.log(grnData);
			var formData={
				data:grnData,
				url:'/Purchase/RecieveGRN'
			}
			var submitResult = await Utility.RequestDataAjax(formData)
			if(submitResult.statusCode==='200'){
				Utility.successMessage('Item Added into Inventory Successfully');
				window.location.href='/Purchase/GoodReceivedNote';
			}
			else{
				Utility.failMessage('Unable to Add Invenvtory')
			}
			console.log(allRowsData);
		});


		var pstatusId=parseFloat($('#status').val());
			var pmId=$('#purchaseMasterId').val();
			enableDisableType(pstatusId);
		function enableDisableType(statusId){

			if(statusId==2	)
			{
					$('#purchaseType').removeAttr('disabled');
			}
			else{
					$('#purchaseType').attr('disabled', 'disabled');
			}
		}
					$(document).on('change','#status',async function(e){
					var id = parseFloat($(this).val());

							$('#purchaseType').removeAttr('disabled');
							if(id==2){
									Utility.confirmBootBox('DO you want to Procced as Purchase Order').then(async function(bootResult){
											if (bootResult) {
													const something =  await Utility.RequestDataAjax({
														data:{
																PurchaseType:2,
															PurchaseMasterId:pmId,
														Status:1
														},

															url:'/Purchase/POChangeType'
													});
													if(something){
														Utility.successMessage('Done');
														window.location.href='/Purchase/Requisitions';
													}
													else{

													}
											} else {
												console.log("User clicked NO");
											}

									});
							}
							await Utility.RequestDataAjax({
								data:{
									Status:id,
									PurchaseMasterId:pmId},
								url:'/Purchase/POChangeStatus'
							});
							enableDisableType(id);
				});

				$(document).on('change','#purchaseType',async function(e){
								var id = parseFloat($(this).val());


							await Utility.RequestDataAjax({
								data:{
									PurchaseType:id,
									PurchaseMasterId:pmId,
									Status:1},
									url:'/Purchase/POChangeType'
							});
				});

				$(document).on('keyup','.qty', async function(e){
					debugger
					var newQty = $(this).val();
					var pdId = $(this).attr('data-purchaseDetailId');
					if(newQty==0){
						$(this).val(1);
						newQty=1;
					}
					// const updateQtyResult= Utility.RequestDataAjax({
					// data:{Qty:newQty,
					// 	PurchaseMasterId:pmId,
					// 	PurchaseDetailId:pdId
					// 	},
					// 	url:'/Purchase/POChangeQty'

					// });
					// Utility.successMessage('Result Updated');
					
					 let $row = $(this).closest('tr');
					 let unitPriceText = $row.find('.unitPrice').val().replace(/[^0-9.]/g, '');
					 let unitPrice = parseFloat(unitPriceText) || 0;
					 let lineTotal = newQty * unitPrice;
					 $row.find('.lineTotal').text(lineTotal.toFixed(2));
					 let totalAmount = 0;
						$('.lineTotal').each(function () {
						totalAmount += parseFloat($(this).text()) || 0;
					});
						  $('#totalAmount').text(totalAmount.toFixed(2));
						  $('#grandTotal').text(totalAmount.toFixed(2));

				});
					$(document).on('keyup','.unitPrice', async function(e){
						
						var newUnitPrice = $(this).val();
						 let $row = $(this).closest('tr');
						 let qtyText = $row.find('.qty').val().replace(/[^0-9.]/g, '');
						 let qty = parseFloat(qtyText) || 0;
						  let lineTotal = qty * newUnitPrice;
						 console.log(`${qty} and UnitPrice ${newUnitPrice}`);
						  $row.find('.lineTotal').text(lineTotal.toFixed(2));
						 UpdateTotalAndGrandTotal();
					});
					$('#discount').keyup(function(){
						UpdateTotalAndGrandTotal()
					})

					function UpdateTotalAndGrandTotal(){
						 let totalAmount = 0;
						$('.lineTotal').each(function () {
						totalAmount += parseFloat($(this).text()) || 0;
						});
						
						  $('#totalAmount').text(totalAmount.toFixed(2));
						  var discount= parseFloat($('#discount').val());
						  totalAmount = totalAmount-discount;
						  $('#grandTotal').text(totalAmount.toFixed(2));
					}
	});
</script>