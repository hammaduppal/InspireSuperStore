@using MainModels.DTOModels
@using MainModels.Util
@model PagesViewModel
@{
	ViewData["Title"] = "Requisition";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
	<div class="row">
		<!-- Barcode Input -->
		<div class="col-md-3">
			<div class="input-group">
				<div class="input-group-prepend">
					<span class="input-group-text"><i class="icon-barcode2"></i></span>
				</div>
				<input type="text" id="barCode" name="barCode" class="form-control" autocomplete="off" placeholder="Search BarCode........." />
			</div>
		</div>
		<!-- Manual Search Input -->
		<div class="col-md-3">
			<div class="input-group">
				<div class="input-group-prepend">
					<span class="input-group-text"><i class="icon-search4"></i></span>
				</div>
				<div class="form-group-feedback form-group-feedback-right">
					<select id="productSearch" style="width: 100%" class="form-control"></select>

				</div>
			</div>
		</div>

	

	</div>

</div>

<!-- Content area -->
<div class="content">

	<!-- Invoice archive -->
	<form id="formVariant" name="formVariant" style="display:block" action="#">

		<div class="card">

			<div class="row p-2">
				<div class="col-md-2">
					<div id="clock" style="font-size: 24px; font-weight: bold;"></div>
					<div id="date" style="font-size: 18px; color: gray;"></div>
				</div>
				<div class="col-lg-3">
					<div class="form-group">
						<label>Company:</label>
						<select id="company" data-placeholder="Enter 'Company'" class="form-control select-minimum" data-fouc required>

							<option value="@AppDataUtility.SessionUser.Person.Branch.Organization.OrganizationId">
								@AppDataUtility.SessionUser.Person.Branch.Organization.OrganizationName
							</option>
							<optgroup label="Company">

							</optgroup>
						</select>
					</div>
				</div>
				<div class="col-lg-3">
					<div class="form-group">
						<label>Branch:</label>
						<select id="branch" data-placeholder="Enter 'Branch'" class="form-control select-minimum" data-fouc required>
							<option value="@AppDataUtility.SessionUser.Person.Branch.BranchId">@AppDataUtility.SessionUser.Person.Branch.BranchName</option>

							<optgroup label="Branch">

							</optgroup>
						</select>
					</div>
				</div>
				<div class="col-lg-4">
					<div class="form-group">
						<label>Supplier:</label>
						<select id="supplier" data-placeholder="Enter 'Supplier'" class="form-control select-minimum" data-fouc required>
							<option value="">Select Supplier</option>
							<optgroup label="Supplier">
								@foreach (var item in Model.Suppliers)
								{
									<option value="@item.SupplierId"> @item.SupplierBusinessName</option>
								}
							</optgroup>
						</select>
					</div>
				</div>

			</div>




		</div>
		<!-- /invoice archive -->
		<div id="invoiceRowSection" class="card shadow-5">
			<table id="purchaseRequisitionTable" class="table table-bordered table-responsive p-2">
				<thead>
					<tr>
						<th>
							BarCode
						</th>
						<th>
							Name
						</th>
						<th>
							Color
						</th>
						<th>
							Size
						</th>
						<th>
							Material
						</th>
						<th>
							Qty
						</th>
						<th>
							Purchase Price
						</th>
						
						<th>
							Total Price
						</th>
						<th>Manage</th>
					</tr>


				</thead>
				<tbody>
					
				</tbody>
			</table>

		</div>
		<div>
			<div class="row">
				<div class="col-lg-8">
				</div>
				<div class="col-lg-4">
					<div class="card shadow-5 p-2">
						<div class="row">
							<div class="col-lg-3">
								<label> <br />Total:</label>
							</div>
							<div class="col-lg-8">
								<div class="form-group">

									<input id="invoiceTotal" type="text" placeholder="Total" class="form-control" />
								</div>
							</div>
							<div class="col-lg-1"></div>

						</div>
						<div class="row">
							<div class="col-lg-3">
								<label><br /> Discount:</label>
							</div>
							<div class="col-lg-8">
								<div class="form-group">

									<input id="discount" value="0" type="text" placeholder="Discount" class="form-control" />
								</div>
							</div>
							<div class="col-lg-1"></div>

						</div>

						<div class="row">
							<div class="col-lg-3">
								<label><br /> Grand Total:</label>
							</div>
							<div class="col-lg-8">
								<div class="form-group">

									<input id="grandTotal" type="text" placeholder="Grand Total" class="form-control" />
								</div>
							</div>
							<div class="col-lg-1"></div>

						</div>

						<div class="card-footer d-flex justify-content-between align-items-center bg-white">
							<button id="requisitionsubmitBtn" type="submit" class="btn bg-blue">Submit form <i class="icon-paperplane ml-2"></i></button>
						</div>

					</div>
				</div>
			</div>
		</div>
	</form>

</div>
<!-- /content area -->
<script>
	$(document).ready(function(){
	$('#barCode').focus();
			  $(document).on('keydown', '#barCode', async function (e) {

			  if (e.key === 'Enter') {
					var barCode= $(this).val();

					 const data = await Utility.RequestDataAjax( {
					  data: { BarCode: barCode },
					  url: '/Products/GetVariantbyBarCode'
				  });
				  
				  if(data){
					appendProductToTable(data);

					$('#barCode').focus();
					$('#barCode').val('');

				  } else
				  {
					alert('Product not found!');
					$(this).val('');

				  }

				}
		  });

	
		$(document).on('input', '.lineqty', function () {
			let qty = parseFloat($(this).val()) || 0;
			let row = $(this).closest('tr');

			// Get the unit price from the currentPrice td
			let unitPrice = parseFloat(row.find('.currentPrice').text()) || 0;

			// Calculate the new line total
			let lineTotal = unitPrice * qty;

			// Update the line total cell
			row.find('.lineTotal').text(lineTotal.toFixed(2));

			// Update overall invoice total
			setTotalPrice();
		});
		$(document).on('input','#discount',function(){
			setTotalPrice();
		})
			function scrollInvoiceTableToBottom() {
				let container = $('#invoiceRowSection');
			 container.scrollTop(container[0].scrollHeight);
			}
		$(document).on('click','.removeRow',function(e){
			e.preventDefault();
				$(this).closest('tr').remove();
				setTotalPrice();
		})

			$('#productSearch').select2({
		placeholder: 'Search product by name, size, color, material...',
		minimumInputLength: 2,
		ajax: {
			url: '/Products/SearchProducts',
			type: 'POST',
			dataType: 'json',
			delay: 300,
			data: function (params) {
				return {
					SearchParams: params.term
				};
			},
			processResults: function (data) {
				return {
					results: data.map(function (item) {
						return {
							id: item.BarCode,
							text: `${item.ProductName} - ${item.SizeName || ''} ${item.ColorName || ''} ${item.MaterialName || ''}`,
							fullData: item
						};
					})
				};
			},
			cache: true
		},
		templateResult: formatProductResult,
		templateSelection: formatProductSelection
	})
	.on('select2:select', function (e) {
		const data = e.params.data;
		appendProductToTable(data.fullData);
		// clear selection after adding
		$(this).val(null).trigger('change');
	});

		
		
		function formatProductSelection(data) {
			return data.text;
		}

		function formatProductResult(data) {
			if (data.loading) return data.text;
			return $(`<div>
				<strong>${data.text}</strong><br/>
				<small>Price: ${data.fullData?.RetailPrice || 'N/A'}</small>
			</div>`);
		}	
		// On select, append to table
		// $(document).on('select2:select','#productSearch', function (e) {
		// 	debugger
		// 	const data = e.params.data;
		// 	appendProductToTable(data.fullData);
		// 	// Optionally clear
		// 	$(this).val(null).trigger('change');
		// });
	

			function appendProductToTable(result) {
			if (!result) return;

			debugger
			let isDuplicate = false;
			let incomingBarcode = String(result.BarCode); // ensure barcode is string

			$('#purchaseRequisitionTable tbody tr').each(function () {
				const barcode = String($(this).find('td').eq(0).data('barcode')); // also as string
				debugger
				if (barcode === incomingBarcode) {
					isDuplicate = true;

					let qtyInput = $(this).find('td').eq(5).find('input');
					let currentQty = parseFloat(qtyInput.val()) || 0;
					let newQty = currentQty + 1;
					qtyInput.val(newQty);

					// update line total
					let price = parseFloat(result.Cost) || 0;
					$(this).find('td').eq(7).text((price * newQty).toFixed(2));

					setTotalPrice();
					return false; // break loop
				}
			});

			if (isDuplicate) {
				return; // No need to append new row
			}

		appendRow(result,incomingBarcode);
			setTotalPrice();
			scrollInvoiceTableToBottom();
		}

		function appendRow(result,incomingBarcode){
			debugger
				let row = `
			<tr>
			<td class='barCode' data-productId="${result.ProductId}" data-barcode="${incomingBarcode}" data-variantId="${result.VariantId}">
					${result.BarCode}
				</td>
				<td data-productId="${result.ProductId}" data-barcode="${incomingBarcode}" data-variantId="${result.VariantId}">
					${result.ProductName}
				</td>
				<td data-productId="${result.ProductId}" data-barcode="${incomingBarcode}" data-variantId="${result.VariantId}">
					${result.ColorName}
				</td>
				<td>${result.SizeName}</td>
				<td>${result.MaterialName}</td>

				<td><input class='lineqty' type='number' min='1' step='1' value='1' style='max-width:50px;'/></td>
				<td class='currentPrice'>${result.Cost}</td>
				<td class='lineTotal text-center'>${(parseFloat(result.Cost) || 0).toFixed(2)}</td>
				<td>
					<div class="list-icons text-center">
						<a href="#" data-variantId="${result.VariantId}" data-productId="${result.ProductId}" class="list-icons-item text-danger-600 removeRow text-center"><i class="icon-trash"></i></a>
					</div>
				</td>
			</tr>
			`;
			$('#purchaseRequisitionTable tbody').append(row);
		}

		function setTotalPrice(){
			debugger
				let invoiceTotal = 0;
			  $('.lineTotal').each(function () {

				  const val = parseFloat($(this).text()) || 0;
				  invoiceTotal += val;
			  });
			  // Display grand total
			  $('#invoiceTotal').val(invoiceTotal.toFixed(2));
			  (updateGrandTotal(invoiceTotal));
		}

			function updateGrandTotal(invoiceTotal) {
				debugger
					const discountAmount = parseFloat($('#discount').val()) || 0;
					let subTotal = invoiceTotal - discountAmount;

					// Set Grand Total before tax
					$('#grandTotal').val(subTotal.toFixed(2));

					let taxPercent = 0;
					let taxAmount = 0;

					// Check if tax field exists and has a value
					if ($('#tax').length > 0) {
						taxPercent = parseFloat($('#tax').val()) || 0;
						if (taxPercent > 0) {
							taxAmount = (subTotal * taxPercent) / 100;
						}
					}

					// Set Tax Amount
					$('#totalTax').val(taxAmount.toFixed(2));

					// Calculate Final Total Payable (SubTotal + Tax)
					const totalPayable = subTotal + taxAmount;
					$('#totalPayable').val(totalPayable.toFixed(2));
			}

		$('#formVariant').submit(async function(e){
		e.preventDefault();
		debugger;

		const items = [];

		$('#purchaseRequisitionTable tbody tr').each(function () {
			const row = $(this);
			debugger
			// Barcode is text inside <td class='barCode'>
			const barCode = row.find('.barCode').data('barcode');

			// ProductId / VariantId are also on <td class='barCode'>
			const productId = row.find('.barCode').data('productid');
			const variantId = row.find('.barCode').data('variantid');

			// Qty is inside input
			const qty = parseFloat(row.find('.lineqty').val()) || 0;

			// Prices from td
			const purchasePrice = parseFloat(row.find('.currentPrice').text()) || 0;
			const totalPrice = parseFloat(row.find('.lineTotal').text()) || 0;

			if (barCode) {
				items.push({
					BarCode: barCode,
					Quantity: qty,
					PurchasePrice: purchasePrice,
					TotalPrice: totalPrice,
					ProductId: productId,
					VariantId: variantId
				});
			}
		});
		debugger
		const discount = parseFloat($('#discount').val()) || 0;
		const grandTotal = parseFloat($('#grandTotal').val()) || 0;
		const branchId = $('#branch').val();
		const supplierId = $('#supplier').val();

		Utility.SpinnerMessageParent('requisitionsubmitBtn','Loading..');
		const payload = {
			Items: items,
			Discount: discount,
			GrandTotal: grandTotal,
			SupplierId: supplierId,
			BranchId: branchId
		};

		const objectData = {
			data: payload,
			url: '/Purchase/AddPurchaseRequisation'
		};

		const result = await Utility.RequestDataAjax(objectData);
		Utility.StopSpinnerMessageParent('requisitionsubmitBtn');

		if(result.statusCode === '200') {
			Utility.successMessage('Record Added');
			$('#formVariant')[0].reset();
			$('#purchaseRequisitionTable tbody').empty(); // also clear table rows
		}
		else {
			Utility.infoMessage('Record Already Exist');
		}
	});

	
	})

</script>


<script>
	function updateDateTime() {
		const now = new Date();

		// Format time
		const hours = String(now.getHours()).padStart(2, '0');
		const minutes = String(now.getMinutes()).padStart(2, '0');
		const seconds = String(now.getSeconds()).padStart(2, '0');
		const timeString = `${hours}:${minutes}:${seconds}`;

		// Format date
		const options = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
		const dateString = now.toLocaleDateString(undefined, options);

		// Update the DOM
		document.getElementById('clock').textContent = timeString;
		document.getElementById('date').textContent = dateString;
	}

	// Initial call and update every second
	updateDateTime();
	setInterval(updateDateTime, 1000);
</script>
