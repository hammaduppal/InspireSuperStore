@using MainModels.DTOModels
@using MainModels.Util
@using Microsoft.AspNetCore.Mvc.Rendering
@using static MainModels.DTOModels.AppConstants
@model PagesViewModel
@{
	ViewData["Title"] = "Requisition";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>

				<span class="breadcrumb-item active">Purchase Orders</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>
<!-- Content area -->
<div class="content">

	<!-- Invoice archive -->
	<div class="card shadow-5">
		<div class="card-header header-elements-inline">
			<h5 class="card-title">Purchase Orders</h5>
			<div class="header-elements">

				<div class="header-elements d-none">
					<div class="d-flex justify-content-center">
					</div>
				</div>
			</div>
		</div>

		<table class="table table-lg invoice-archive">
			<thead>
				<tr>
					<th>#</th>
					<th>Issued to</th>
					<th>Status</th>
					<th>Issue date</th>
					<th>Total	</th>
					<th>Discount</th>
					<th>Invoice Total</th>

					<th class="text-center">Actions</th>
				</tr>
			</thead>
			<tbody>

				@foreach (var item in Model.PurchaseMasters)
				{
					var selectedStatus = item?.Status ?? (int)PurchaseStatus.Draft;
					<tr>
						<td>@item?.PurchaseNumber</td>
						<td>
							<h6 class="mb-0">
								@item?.SupplierBusinessName
							</h6>
						</td>
						<td>
							<select data-pmId="@item.PurchaseMasterId" name="status" class="form-control form-control-select2 status" data-placeholder="Select status">
								@foreach (PurchaseStatus status in Enum.GetValues(typeof(PurchaseStatus)))
								{
									<option value="@((int)status)" @(selectedStatus == (int)status ? "selected" : "")>
										@status
									</option>
								}
							</select>

						</td>
						<td>
							@TimeHelper.GetFormattedTimeSpan(DateTime.Parse(item?.CreatedOn.ToString()))
						</td>
						<td>
							<h6 class="mb-0 font-weight-bold">@item?.TotalAmount </h6>
						</td>
						<td>
							<h6 class="mb-0 font-weight-bold">@item?.DiscountAmount </h6>
						</td>
						<td>
							<h6 class="mb-0 font-weight-bold">@item?.GrandTotal </h6>
						</td>
						<td class="text-center">
							<div class="list-icons list-icons-extended">
								<a href="/Purchase/EditPurchaseOrder?Id=@item?.PurchaseMasterId" class="list-icons-item"><i class="icon-file-eye"></i></a>

							
							</div>
						</td>
					</tr>

				}
			</tbody>
		</table>
	</div>
	<!-- /invoice archive -->

</div>
<!-- /content area -->
<script>
	$(document).ready(function(){
		$(document).on('change','.status',async function(e){
		debugger
		var id = parseFloat($(this).val());
		var pmId=$(this).attr('data-pmId');
				$('#purchaseType').removeAttr('disabled');
				if(id==2){
						Utility.confirmBootBox('DO you want to Procced as Good Recieved Note').then(async function(bootResult){
								if (bootResult) {
										const changeTypeResult =  await Utility.RequestDataAjax({
											data:{
													PurchaseType:3,
													Status:2,
												PurchaseMasterId:pmId},
												url:'/Purchase/POChangeType'
										});
										if(changeTypeResult.statusCode==='200'){
											Utility.successMessage(changeTypeResult.Message);
											window.location.href='/Purchase/PurchaseOrder';
										}
										else{
											Utility.failMessage(changeTypeResult.Message);
										}
								} else {
								}

						});
				}
						else if(id==3){
										const changePostatus =  await Utility.RequestDataAjax({
											data:{
											PurchaseType:1,
											PurchaseMasterId:pmId},
											url:'/Purchase/POChangeType'
										});
										if(changePostatus.statusCode==='200')
										{
											Utility.successMessage(changePostatus.Message);
											window.location.href='/Purchase/PurchaseOrder';
										}
										else{

										}
						}
				await Utility.RequestDataAjax({
					data:{
						Status:id,
						PurchaseMasterId:pmId},
					url:'/Purchase/POChangeStatus'
				});
	});
	});
</script>