@using MainModels.DTOModels
@model PagesViewModel
@{
	ViewData["Title"] = "Add Supplier";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
				<a href="/supplier/suppliers" class="breadcrumb-item"><i class="icon-store2  mr-2"></i> Suppliers</a>


				<span class="breadcrumb-item active">Add Supplier</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>
<div class="content">
	<!-- Form validation -->
	<div class="card shadow-5">
		

		<div class="card-body">

			<form id="addNewSupplier" class="form-validate-jquery" action="#">


				<fieldset class="mb-3 ">
					<legend class="text-uppercase font-size-sm font-weight-bold">Add Supplier</legend>
				

					<div class="row">
						<div class="col-lg-5">
							<div class="form-group row">
								<label for="supplierBusinessName" class="col-form-label col-lg-4">Supplier Business<span class="text-danger">*</span></label>
								<div class="col-lg-8">
									<input type="text" id="supplierBusinessName" name="supplierBusinessName" class="form-control" autocomplete="off" required placeholder="supplier Business Name" />
								</div>
							</div>
						</div>
						<div class="col-lg-5">
							<div class="form-group row">
								<label for="supplierCode" class="col-form-label col-lg-3">Supplier Code <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<div class="form-group-feedback form-group-feedback-right">
										<input type="text" id="supplierCode" name="supplierCode" class="form-control" autocomplete="off" required placeholder="supplier Code" />
									</div>
								</div>
							</div>
						</div>
						<div class="col-lg-2">
							<div class="form-group row">
								<label for="ntn" class="col-form-label col-lg-3">Ntn <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<div class="form-group-feedback form-group-feedback-right">
										<input type="text" id="ntn" name="ntn" class="form-control" autocomplete="off" required placeholder="Ntn" />
									</div>
								</div>
							</div>
						</div>




					</div>

					<div class="row">
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="FirstName" class="col-form-label col-lg-3">First Name <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<input type="text" id="FirstName" name="FirstName" class="form-control" required placeholder="First Name" />
								</div>
							</div>
						</div>
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="LastName" class="col-form-label col-lg-3">Last Name <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<div class="form-group-feedback form-group-feedback-right">
										<input type="text" id="LastName" name="LastName" class="form-control" required placeholder="Last Name" />
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="Email" class="col-form-label col-lg-3">User Email <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<input type="email" id="Email" name="Email" autocomplete="off" class="form-control" required placeholder="User Email" />
								</div>
							</div>
						</div>
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="Mobile" class="col-form-label col-lg-3">Mobile <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<div class="form-group-feedback form-group-feedback-right">
										<input type="text" id="Mobile" name="MobileNumber" class="form-control" required placeholder="Mobile" autocomplete="off" />
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="Cnic" class="col-form-label col-lg-3">User CNIC <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<input type="text" id="Cnic" name="Cnic" class="form-control" required placeholder="User CNIC" autocomplete="off" />
								</div>
							</div>
						</div>
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="SocialSecurity" class="col-form-label col-lg-3">Social Security <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<div class="form-group-feedback form-group-feedback-right">
										<input type="text" id="SocialSecurity" name="SocialSecurity" class="form-control" required autocomplete="off" placeholder="Social Security" />
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="form-group">
						<label>Lane Address One:</label>
						<input id="addressOne" type="text" class="form-control" placeholder="Lane Address One" />
					</div>
					<div class="form-group">
						<label>Lane Address Two:</label>
						<input id="addressTwo" type="text" class="form-control" placeholder="Lane Address Two" />
					</div>
					<div class="row">
						<div class="col-lg-6">
							<div class="form-group">
								<label>Near Famous Place:</label>
								<input id="famousPlace" type="text" class="form-control" placeholder="Near Famous Place" />
							</div>
						</div>
						<div class="col-lg-6">
							<div class="form-group">
								<label>Area:</label>
								<input id="area" type="text" class="form-control" placeholder="Area" />
							</div>
						</div>
					</div>

					@await Html.PartialAsync("~/Views/Shared/CountryStateCity.cshtml", Model)

				</fieldset>


				<div class="d-flex justify-content-end align-items-center">
					<button type="reset" class="btn btn-light" id="reset">Reset <i class="icon-reload-alt ml-2"></i></button>
					<button id="addnewSupplierBtn" type="submit" class="btn btn-primary ml-3">Submit <i class="icon-paperplane ml-2"></i></button>
				</div>
			</form>
		</div>
	</div>
	<!-- /form validation -->
	



</div>


<script>
	$(document).ready(function(){
			$('#addNewSupplier').submit(async function(e){
				e.preventDefault();
				Utility.SpinnerMessageParent('newuseraddBtn','Loading..');
				var formData={
						SupplierBusinessName: $('#supplierBusinessName').val(),
						SupplierCode: $('#supplierCode').val(),
						Ntn: $('#ntn').val(),

					Person:{
						FirstName: $('#FirstName').val(),
						LastName: $('#LastName').val(),
						Email: $('#Email').val(),
						MobileNumber: $('#Mobile').val(),
						Cnic: $('#Cnic').val(),
						BranchId:$('#branch').val(),
						SocialSecurity: $('#SocialSecurity').val(),
						LaneAddress:[{
							LaneAddressOne: $('#addressOne').val(),
							LaneAddressTwo: $('#addressTwo').val(),
							FamousPlace: $('#famousPlace').val(),
							Area: $('#area').val(),
							CityId: $('#city').val(),
						}]
					}

				}


				var objectData={
				data:formData,
				url:'/Supplier/AddSupplierForm'
				}
				debugger
				const result = await Utility.RequestDataAjax(objectData);
				Utility.StopSpinnerMessageParent('newuseraddBtn');
				if(result.statusCode==='200'){
				$('#reset').click();
					Utility.successMessage(result.Message);
				}
				else if(result.statusCode==='201'){
					Utility.infoMessage(result.Message);
				}
				else if(result.statusCode==='202'){
					Utility.infoMessage(result.Message);
				}
				else{
					Utility.failMessage(result.Message);
				}
			})

	})
</script>