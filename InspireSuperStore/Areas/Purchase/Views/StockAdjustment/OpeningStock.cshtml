@using MainModels.DTOModels
@model PagesViewModel
@{
	ViewData["Title"] = "Opening Stock";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">
		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
				<span class="breadcrumb-item active">Opening Stock</span>
			</div>
			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>
</div>

<!-- Content area -->
<div class="content">
	<div class="card shadow-5">
		<div class="card-header header-elements-inline">
			<h5 class="card-title">Opening Stock List</h5>
			<div class="header-elements">
				<div class="header-elements d-none">
					<div class="d-flex justify-content-center">
						<a href="/StockAdjustment/CreateVoucher" class="btn btn-success addProduct">Add Stock Adjustment</a>
					</div>
				</div>
			</div>
		</div>

		<div class="table-responsive">
			<table class="table">
				<thead>
					<tr>
						<th class="text-center">Adjustment No</th>
						<th class="text-center">Date</th>
						<th class="text-center">Grand Total</th>
						<th class="text-center">Reference No</th>
						<th class="text-center">Manage</th>
					</tr>
				</thead>
				<tbody>
					@if (Model.PurchaseMasters != null && Model.PurchaseMasters.Any())
					{
						@foreach (var item in Model.PurchaseMasters)
						{
							<tr>
								<td class="text-center">
									<a style="color:black" href="/StockAdjustment/Details/@item.PurchaseMasterId">@item.PurchaseNumber</a>
								</td>
								<td class="text-center">@item.PurchaseDate.Value.ToShortDateString()</td>
								<td class="text-center">@item.GrandTotal</td>

								<td class="text-center">@item.PurchaseNumber</td>
							
								<td class="text-center">
									<div class="list-icons">
									@* 	<a href="/StockAdjustment/Edit/@item.PurchaseMasterId" class="list-icons-item text-primary-600"><i class="icon-pencil7"></i></a>
										<a href="#" class="list-icons-item text-danger-600" onclick="deleteAdjustment('@item.PurchaseMasterId')"><i class="icon-trash"></i></a>
										<a href="/StockAdjustment/Details/@item.PurchaseMasterId" class="list-icons-item text-teal-600"><i class="icon-cog6"></i></a>
									 *@</div>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="6" class="text-center text-muted py-4">No stock adjustment records found.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>