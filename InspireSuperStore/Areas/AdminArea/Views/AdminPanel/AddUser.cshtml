@using MainModels.DTOModels
@model PagesViewModel
@{
	ViewData["Title"] = "AddUser";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>

				<span class="breadcrumb-item active">Add User</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>
<div class="content">
	<!-- Form validation -->
	<div class="card">
		<div class="card-header">
			<div class="form-group row">
				<div class="col-lg-3">
					<div class="form-check">
					</div>
				</div>
			</div>
		</div>

		<div class="card-body">

			<form id="addNewUser" class="form-validate-jquery" action="#">


				<fieldset class="mb-3 ">
					<legend class="text-uppercase font-size-sm font-weight-bold">Add User</legend>
					<div class="row mb-3">

						<div class="col-lg-6">
							<select id="organization" class="form-control">
								<option>Select Organization</option>
								@foreach (var item in Model.Organizations)
								{
									<option value="@item.OrganizationId">
										@item.OrganizationName
									</option>
								}
							</select>
						</div>
						<div class="col-lg-6">
							<select id="branch" class="form-control">
								<option>Select Branch</option>
								
							</select>
						</div>
					</div>

					
					<div class="row">
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="UserName" class="col-form-label col-lg-3">User Name <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<input type="email" id="UserName" name="UserName" class="form-control" autocomplete="off" required placeholder="User Name" />
								</div>
							</div>
						</div>
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="Password" class="col-form-label col-lg-3">Password <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<div class="form-group-feedback form-group-feedback-right">
										<input type="password" id="Password" name="Passwords" class="form-control" autocomplete="off" required placeholder="Password" />
										<div class="form-control-feedback">
											<a id="viewPassword" href="#"><i class="icon-eye-blocked"></i></a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="FirstName" class="col-form-label col-lg-3">First Name <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<input type="text" id="FirstName" name="FirstName" class="form-control" required placeholder="First Name" />
								</div>
							</div>
						</div>
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="LastName" class="col-form-label col-lg-3">Last Name <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<div class="form-group-feedback form-group-feedback-right">
										<input type="text" id="LastName" name="LastName" class="form-control" required placeholder="Last Name" />
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="Email" class="col-form-label col-lg-3">User Email <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<input type="email" id="Email" name="Email" autocomplete="off" class="form-control" required placeholder="User Email" />
								</div>
							</div>
						</div>
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="Mobile" class="col-form-label col-lg-3">Mobile <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<div class="form-group-feedback form-group-feedback-right">
										<input type="text" id="Mobile" name="MobileNumber" class="form-control" required placeholder="Mobile" autocomplete="off" />
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="Cnic" class="col-form-label col-lg-3">User CNIC <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<input type="text" id="Cnic" name="Cnic" class="form-control" required placeholder="User CNIC" autocomplete="off" />
								</div>
							</div>
						</div>
						<div class="col-lg-6">
							<div class="form-group row">
								<label for="SocialSecurity" class="col-form-label col-lg-3">Social Security <span class="text-danger">*</span></label>
								<div class="col-lg-9">
									<div class="form-group-feedback form-group-feedback-right">
										<input type="text" id="SocialSecurity" name="SocialSecurity" class="form-control" required autocomplete="off" placeholder="Social Security" />
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="form-group">
						<label>Lane Address One:</label>
						<input id="addressOne" type="text" class="form-control" placeholder="Lane Address One" />
					</div>
					<div class="form-group">
						<label>Lane Address Two:</label>
						<input id="addressTwo" type="text" class="form-control" placeholder="Lane Address Two" />
					</div>
					<div class="row">
						<div class="col-lg-6">
							<div class="form-group">
								<label>Near Famous Place:</label>
								<input id="famousPlace" type="text" class="form-control" placeholder="Near Famous Place" />
							</div>
						</div>
						<div class="col-lg-6">
							<div class="form-group">
								<label>Area:</label>
								<input id="area" type="text" class="form-control" placeholder="Area" />
							</div>
						</div>
					</div>

					@await Html.PartialAsync("~/Views/Shared/CountryStateCity.cshtml", Model)

				</fieldset>


				<div class="d-flex justify-content-end align-items-center">
					<button type="reset" class="btn btn-light" id="reset">Reset <i class="icon-reload-alt ml-2"></i></button>
					<button id="newuseraddBtn" type="submit" class="btn btn-primary ml-3">Submit <i class="icon-paperplane ml-2"></i></button>
				</div>
			</form>
		</div>
	</div>
	<!-- /form validation -->
	<div class="row">
	</div>



</div>
<script>
	$('#organization').change(async function(){
		var oId = $(this).val();
		var formData= {
			OrganizationId:oId
		}
		var objectData={
			data:formData,
			url:'/AdminPanel/GetBranchesByOrganizationId'
		}
		const result = await Utility.RequestDataAjax(objectData);
		 result.forEach(function(branch) {
					$('#branch').append(`<option value="${branch.BranchId}">${branch.BranchName}</option>`);
			  });
	});
</script>

<script>
	$(document).ready(function(){
			$('#addNewUser').submit(async function(e){
				e.preventDefault();
				Utility.SpinnerMessageParent('newuseraddBtn','Loading..');
				var formData={
						UserName: $('#UserName').val(),
						Passwords: $('#Password').val(),
					PersonVM:{
						FirstName: $('#FirstName').val(),
						LastName: $('#LastName').val(),
						Email: $('#Email').val(),
						MobileNumber: $('#Mobile').val(),
						Cnic: $('#Cnic').val(),
						BranchId:$('#branch').val(),
						SocialSecurity: $('#SocialSecurity').val(),
						LaneAddress:[{
							LaneAddressOne: $('#addressOne').val(),
							LaneAddressTwo: $('#addressTwo').val(),
							FamousPlace: $('#famousPlace').val(),
							Area: $('#area').val(),
							CityId: $('#city').val(),
						}]
					}
						
				}
			
				
				var objectData={
				data:formData,
				url:'/AdminPanel/AddNewUser'
				}
				const result = await Utility.RequestDataAjax(objectData);
				Utility.StopSpinnerMessageParent('newuseraddBtn');
				if(result.statusCode==='200'){
					$('#addNewUser')[0].reset();
					Utility.successMessage(result.Message);
				}
				else if(result.statusCode==='201'){
					Utility.infoMessage(result.Message);
				}
				else if(result.statusCode==='202'){
					Utility.infoMessage(result.Message);
				}
				else{
					Utility.failMessage(result.Message);
				}
			})
		
	})
</script>