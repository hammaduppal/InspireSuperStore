    </div>
</div>

<!-- Save Button -->
<div class="text-center mt-4">
    <button id="btnSavePreferences" class="btn btn-success px-4">Save Preferences</button>
</div>

<style>
    /* Switch style */
    .switch {
        position: relative;
        display: inline-block;
        width: 46px;
        height: 24px;
    }

        .switch input {
            display: none;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 34px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #28a745;
    }

        input:checked + .slider:before {
            transform: translateX(22px);
        }
</style>
<script>
    $(document).ready(function () {

         $("#btnSavePreferences").click(function () {
        var formData = new FormData();

        // General Accounting Preferences
        formData.append("BranchId", $("#branch").val());

        // Fiscal Year
        formData.append("FiscalYearStartMonth", $("#FiscalYearStartMonth").val());
        formData.append("FiscalYearEndMonth", $("#FiscalYearEndMonth").val());
        formData.append("FiscalYearStartDate", $("#FiscalYearStartDate").val());
        formData.append("FiscalYearEndDate", $("#FiscalYearEndDate").val());

        // Multi-Currency
        formData.append("EnableMultiCurrency", $("#EnableMultiCurrency").is(":checked"));
        formData.append("BaseCurrencyCode", $("#BaseCurrencyCode").val());
        formData.append("DefaultExchangeRateSource", $("#DefaultExchangeRateSource").val());

        // Year Closing
        formData.append("EnableAutomaticYearClosing", $("#EnableAutomaticYearClosing").is(":checked"));
        formData.append("LockTransactionsAfterPeriodClose", $("#LockTransactionsAfterPeriodClose").is(":checked"));

        // Default Accounts
        formData.append("DefaultSalesAccount", $("#DefaultSalesAccount").val());
        formData.append("DefaultPurchaseAccount", $("#DefaultPurchaseAccount").val());
        formData.append("DefaultTaxAccount", $("#DefaultTaxAccount").val());

        // Other Options
        formData.append("AllowBackDatedTransactions", $("#AllowBackDatedTransactions").is(":checked"));

        // Debug: Log everything
        console.log("=== FormData Debug Start ===");
        for (var pair of formData.entries()) {
            console.log(pair[0] + ": ", pair[1]);
        }

        // AJAX request
        $.ajax({
            url: '/AdminPanel/SaveAccountingPreferences',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                alert("Accounting Preferences saved successfully!");
            },
            error: function (xhr, status, error) {
                alert("Error saving accounting preferences: " + error);
            }
        });
    });

       function toggleTaxRate() {
            if ($("#EnableTax").is(":checked")) {
                $("#DefaultTaxRate").closest(".col-lg-4").show();
            } else {
                $("#DefaultTaxRate").closest(".col-lg-4").hide();
            }
        }

        // Run on page load
        toggleTaxRate();

        // Run on checkbox change
        $("#EnableTax").change(function () {
            toggleTaxRate();
        });
    });
</script>

