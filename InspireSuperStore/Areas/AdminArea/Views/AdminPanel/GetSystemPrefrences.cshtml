@using MainModels.DTOModels
@model PagesViewModel
@{
    Layout = null;
}
@functions {
    string PrefValue(string? val) => string.IsNullOrEmpty(val) ? "AAA" : val;
    string PrefValueNum(int? val) => val == null ? "AAA" : val.ToString();
}
<h5 class="mb-3">General Settings</h5>
<div class="row">
    <div class="col-lg-4 mb-3">
        <label>Company Name</label>
        <input type="text" class="form-control" id="CompanyName"
               value="@(string.IsNullOrEmpty(Model.SystemPreferences.CompanyName) ? "My Company" : Model.SystemPreferences.CompanyName)">
    </div>


   
    <div class="col-lg-4 mb-3">
        <label>Currency Code</label>
        <input type="text" class="form-control" id="CurrencyCode"
               value="@(string.IsNullOrEmpty(Model.SystemPreferences.CurrencyCode) ? "RS" : Model.SystemPreferences.CurrencyCode)">
    </div>
    <div class="col-lg-4 mb-3">
        <label>Currency Symbol</label>
        <input type="text" class="form-control" id="CurrencySymbol"
               value="@(string.IsNullOrEmpty(Model.SystemPreferences.CurrencySymbol) ? "PKR" : Model.SystemPreferences.CurrencySymbol)">
    </div>
    <div class="col-lg-4 mb-3">
        <label>Decimal Places</label>
        <input type="number" class="form-control" id="DecimalPlaces"
               value="@(Model.SystemPreferences.DecimalPlaces == null ? "AAA" : Model.SystemPreferences.DecimalPlaces.ToString())">
    </div>
    <div class="col-lg-4 mb-3">
        <label>Default Language</label>
        <input type="text" disabled class="form-control" id="DefaultLanguage"
               value="@(string.IsNullOrEmpty(Model.SystemPreferences.DefaultLanguage) ? "Coming Soons Feature" : Model.SystemPreferences.DefaultLanguage)">
    </div>
    <div class="col-lg-4 mb-3">
        <label>Time Zone</label>
        <input type="text" disabled class="form-control" id="TimeZone"
               value="@(string.IsNullOrEmpty(Model.SystemPreferences.TimeZone) ? "Coming Soons Feature" : Model.SystemPreferences.TimeZone)">
    </div>
    <div class="col-lg-4 mb-3">
        <label>Date Format</label>
        <input type="text" disabled class="form-control" id="DateFormat"
               value="@(string.IsNullOrEmpty(Model.SystemPreferences.DateFormat) ? "Coming Soons Feature" : Model.SystemPreferences.DateFormat)">
    </div>

    <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
        <label>Is Affiliated Invoice</label>
        <label class="switch">
            <input type="checkbox" id="IsAffilatedInvoice"
                   @(Model.SystemPreferences.IsAffilatedInvoice ? "checked" : "")>
            <span class="slider"></span>
        </label>
    </div>
    <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
        <label>Is Restaurant Application</label>
        <label class="switch">
            <input type="checkbox" id="IsRestaurantApplication"
                   @(Model.SystemPreferences.IsRestaurantApplication ? "checked" : "")>
            <span class="slider"></span>
        </label>
    </div>
    <div class="col-lg-4 mb-3">
        <label>Company Logo URL</label>
        <input type="file" class="form-control" id="CompanyLogoFile">
    </div>
</div>

<!-- Tax & Financial -->
<h5 class="mb-3">Tax & Financial</h5>
<div class="row">
    <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
        <label>Prices Include Tax</label>
        <label class="switch">
            <input type="checkbox" id="PricesIncludeTax"
                   @(Model.SystemPreferences.PricesIncludeTax ? "checked" : "")>
            <span class="slider"></span>
        </label>
    </div>
    <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
        <label>Enable Tax</label>
        <label class="switch">
            <input type="checkbox" id="EnableTax"
                   @(Model.SystemPreferences.EnableTax ? "checked" : "")>
            <span class="slider"></span>
        </label>
    </div>
    <div class="col-lg-4 mb-3">
        <label>Default Tax Rate</label>
        <input type="number" class="form-control" id="DefaultTaxRate"
               value="@(Model.SystemPreferences.DefaultTaxRate == null ? 0 : Model.SystemPreferences.DefaultTaxRate.ToString())">
    </div>
    <div class="col-lg-4 mb-3">
        <label>Tax Registration Number</label>
        <input type="text" class="form-control" id="TaxRegistrationNumber"
               value="@(string.IsNullOrEmpty(Model.SystemPreferences.TaxRegistrationNumber) ? "00000-0" : Model.SystemPreferences.TaxRegistrationNumber)">
    </div>
  
</div>

