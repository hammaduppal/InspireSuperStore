@using MainModels.DTOModels
@model PagesViewModel
@{
    ViewData["Title"] = "SystemPrefrences";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <div class="card shadow p-3 rounded-3">
        <div class="card-header fw-bold text-center">
            System Preferences
            <select id="branch">
                @foreach (var item in Model.Branches)
                {
                    <option value="@item.BranchId">@item.BranchName</option>
                }
            </select>
        </div>
        <div class="card-body">

            <!-- General Settings -->
            <h5 class="mb-3">General Settings</h5>
            <div class="row">
                <div class="col-lg-4 mb-3">
                    <label>Company Name</label>
                    <input type="text" class="form-control" id="CompanyName"
                           value="@Model.SystemPreferences.CompanyName">
                </div>
                <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
                    <label>Is Restaurant Application</label>
                    <label class="switch">
                        <input type="checkbox" id="IsRestaurantApplication"
                               @(Model.SystemPreferences.IsRestaurantApplication ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Company Logo URL</label>
                    <input type="file" class="form-control" id="CompanyLogoFile">
                </div>

                <div class="col-lg-4 mb-3">
                    <label>Default Language</label>
                    <input type="text" class="form-control" id="DefaultLanguage"
                           value="@Model.SystemPreferences.DefaultLanguage">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Time Zone</label>
                    <input type="text" class="form-control" id="TimeZone"
                           value="@Model.SystemPreferences.TimeZone">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Date Format</label>
                    <input type="text" class="form-control" id="DateFormat"
                           value="@Model.SystemPreferences.DateFormat">
                </div>

                <div class="col-lg-4 mb-3">
                    <label>Currency Code</label>
                    <input type="text" class="form-control" id="CurrencyCode"
                           value="@Model.SystemPreferences.CurrencyCode">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Currency Symbol</label>
                    <input type="text" class="form-control" id="CurrencySymbol"
                           value="@Model.SystemPreferences.CurrencySymbol">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Decimal Places</label>
                    <input type="number" class="form-control" id="DecimalPlaces"
                           value="@Model.SystemPreferences.DecimalPlaces">
                </div>

                <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
                    <label>Is Affiliated Invoice</label>
                    <label class="switch">
                        <input type="checkbox" id="IsAffilatedInvoice"
                               @(Model.SystemPreferences.IsAffilatedInvoice ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <!-- Tax & Financial -->
            <h5 class="mb-3">Tax & Financial</h5>
            <div class="row">
                <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
                    <label>Enable Tax</label>
                    <label class="switch">
                        <input type="checkbox" id="EnableTax"
                               @(Model.SystemPreferences.EnableTax ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Default Tax Rate</label>
                    <input type="number" class="form-control" id="DefaultTaxRate"
                           value="@Model.SystemPreferences.DefaultTaxRate">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Tax Registration Number</label>
                    <input type="text" class="form-control" id="TaxRegistrationNumber"
                           value="@Model.SystemPreferences.TaxRegistrationNumber">
                </div>
                <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
                    <label>Prices Include Tax</label>
                    <label class="switch">
                        <input type="checkbox" id="PricesIncludeTax"
                               @(Model.SystemPreferences.PricesIncludeTax ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <!-- Inventory & Sales -->
            <h5 class="mb-3">Inventory & Sales</h5>
            <div class="row">
                <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
                    <label>Enable Inventory Tracking</label>
                    <label class="switch">
                        <input type="checkbox" id="EnableInventoryTracking"
                               @(Model.SystemPreferences.EnableInventoryTracking ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Default Warehouse</label>
                    <input type="text" class="form-control" id="DefaultWarehouse"
                           value="@Model.SystemPreferences.DefaultWarehouse">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Low Stock Threshold</label>
                    <input type="number" class="form-control" id="LowStockThreshold"
                           value="@Model.SystemPreferences.LowStockThreshold">
                </div>
                <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
                    <label>Allow Negative Stock</label>
                    <label class="switch">
                        <input type="checkbox" id="AllowNegativeStock"
                               @(Model.SystemPreferences.AllowNegativeStock ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <!-- Invoice & Document -->
            <h5 class="mb-3">Invoice & Document</h5>
            <div class="row">
                <div class="col-lg-4 mb-3">
                    <label>Invoice Prefix</label>
                    <input type="text" class="form-control" id="InvoicePrefix"
                           value="@Model.SystemPreferences.InvoicePrefix">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Invoice Start Number</label>
                    <input type="number" class="form-control" id="InvoiceStartNumber"
                           value="@Model.SystemPreferences.InvoiceStartNumber">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Quotation Prefix</label>
                    <input type="text" class="form-control" id="QuotationPrefix"
                           value="@Model.SystemPreferences.QuotationPrefix">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Receipt Prefix</label>
                    <input type="text" class="form-control" id="ReceiptPrefix"
                           value="@Model.SystemPreferences.ReceiptPrefix">
                </div>
                <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
                    <label>Show Logo On Invoices</label>
                    <label class="switch">
                        <input type="checkbox" id="ShowLogoOnInvoices"
                               @(Model.SystemPreferences.ShowLogoOnInvoices ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
                    <label>Show Tax Breakdown</label>
                    <label class="switch">
                        <input type="checkbox" id="ShowTaxBreakdown"
                               @(Model.SystemPreferences.ShowTaxBreakdown ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <!-- User & Security -->
            <h5 class="mb-3">User & Security</h5>
            <div class="row">
                <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
                    <label>Enable Two Factor Auth</label>
                    <label class="switch">
                        <input type="checkbox" id="EnableTwoFactorAuth"
                               @(Model.SystemPreferences.EnableTwoFactorAuth ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Session Timeout (Minutes)</label>
                    <input type="number" class="form-control" id="SessionTimeoutMinutes"
                           value="@Model.SystemPreferences.SessionTimeoutMinutes">
                </div>
                <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
                    <label>Allow Multiple Logins</label>
                    <label class="switch">
                        <input type="checkbox" id="AllowMultipleLogins"
                               @(Model.SystemPreferences.AllowMultipleLogins ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
            </div>

            <!-- Email & Communication -->
            <h5 class="mb-3">Email & Communication</h5>
            <div class="row">
                <div class="col-lg-4 mb-3">
                    <label>SMTP Server</label>
                    <input type="text" class="form-control" id="SmtpServer"
                           value="@Model.SystemPreferences.SmtpServer">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>SMTP Port</label>
                    <input type="number" class="form-control" id="SmtpPort"
                           value="@Model.SystemPreferences.SmtpPort">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>SMTP Username</label>
                    <input type="text" class="form-control" id="SmtpUserName"
                           value="@Model.SystemPreferences.SmtpUserName">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>SMTP Password</label>
                    <input type="password" class="form-control" id="SmtpPassword"
                           value="@Model.SystemPreferences.SmtpPassword">
                </div>
                <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
                    <label>Enable SSL</label>
                    <label class="switch">
                        <input type="checkbox" id="EnableSsl"
                               @(Model.SystemPreferences.EnableSsl ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Default From Email</label>
                    <input type="text" class="form-control" id="DefaultFromEmail"
                           value="@Model.SystemPreferences.DefaultFromEmail">
                </div>
            </div>

            <!-- Other Options -->
            <h5 class="mb-3">Other Options</h5>
            <div class="row">
                <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
                    <label>Enable Auto Backup</label>
                    <label class="switch">
                        <input type="checkbox" id="EnableAutoBackup"
                               @(Model.SystemPreferences.EnableAutoBackup ? "checked" : "")>
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Auto Backup Interval (Days)</label>
                    <input type="number" class="form-control" id="AutoBackupIntervalDays"
                           value="@Model.SystemPreferences.AutoBackupIntervalDays">
                </div>
                <div class="col-lg-4 mb-3">
                    <label>Backup Location</label>
                    <input type="text" class="form-control" id="BackupLocation"
                           value="@Model.SystemPreferences.BackupLocation">
                </div>
            </div>

            <!-- Save Button -->
            <div class="text-center mt-4">
                <button id="btnSavePreferences" class="btn btn-success px-4">Save Preferences</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Switch style */
    .switch {
        position: relative;
        display: inline-block;
        width: 46px;
        height: 24px;
    }

        .switch input {
            display: none;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 34px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #28a745;
    }

        input:checked + .slider:before {
            transform: translateX(22px);
        }
</style>
<script>
    $(document).ready(function () {

        $("#btnSavePreferences").click(function () {
            var formData = new FormData();

            // General Settings
            formData.append("BranchId", $("#branch").val());

            formData.append("CompanyName", $("#CompanyName").val());
            formData.append("IsRestaurantApplication", $("#IsRestaurantApplication").is(":checked"));
            formData.append("DefaultLanguage", $("#DefaultLanguage").val());
            formData.append("TimeZone", $("#TimeZone").val());
            formData.append("DateFormat", $("#DateFormat").val());
            formData.append("CurrencyCode", $("#CurrencyCode").val());
            formData.append("CurrencySymbol", $("#CurrencySymbol").val());
            formData.append("DecimalPlaces", $("#DecimalPlaces").val());
            formData.append("IsAffilatedInvoice", $("#IsAffilatedInvoice").is(":checked"));

            // Handle File Upload
            var logoFile = $("#CompanyLogoFile")[0].files[0];
            if (logoFile) {
                formData.append("CompanyLogoFile", logoFile);
            }

            // Tax & Financial
            formData.append("EnableTax", $("#EnableTax").is(":checked"));
            formData.append("DefaultTaxRate", $("#DefaultTaxRate").val());
            formData.append("TaxRegistrationNumber", $("#TaxRegistrationNumber").val());
            formData.append("PricesIncludeTax", $("#PricesIncludeTax").is(":checked"));

            // Inventory & Sales
            formData.append("EnableInventoryTracking", $("#EnableInventoryTracking").is(":checked"));
            formData.append("DefaultWarehouse", $("#DefaultWarehouse").val());
            formData.append("LowStockThreshold", $("#LowStockThreshold").val());
            formData.append("AllowNegativeStock", $("#AllowNegativeStock").is(":checked"));

            // Invoice & Document Settings
            formData.append("InvoicePrefix", $("#InvoicePrefix").val());
            formData.append("InvoiceStartNumber", $("#InvoiceStartNumber").val());
            formData.append("QuotationPrefix", $("#QuotationPrefix").val());
            formData.append("ReceiptPrefix", $("#ReceiptPrefix").val());
            formData.append("ShowLogoOnInvoices", $("#ShowLogoOnInvoices").is(":checked"));
            formData.append("ShowTaxBreakdown", $("#ShowTaxBreakdown").is(":checked"));

            // User & Security
            formData.append("EnableTwoFactorAuth", $("#EnableTwoFactorAuth").is(":checked"));
            formData.append("SessionTimeoutMinutes", $("#SessionTimeoutMinutes").val());
            formData.append("AllowMultipleLogins", $("#AllowMultipleLogins").is(":checked"));

            // Email & Communication
            formData.append("SmtpServer", $("#SmtpServer").val());
            formData.append("SmtpPort", $("#SmtpPort").val());
            formData.append("SmtpUserName", $("#SmtpUserName").val());
            formData.append("SmtpPassword", $("#SmtpPassword").val());
            formData.append("EnableSsl", $("#EnableSsl").is(":checked"));
            formData.append("DefaultFromEmail", $("#DefaultFromEmail").val());

            // Other Options
            formData.append("EnableAutoBackup", $("#EnableAutoBackup").is(":checked"));
            formData.append("AutoBackupIntervalDays", $("#AutoBackupIntervalDays").val());
            formData.append("BackupLocation", $("#BackupLocation").val());
              console.log("=== FormData Debug Start ===");
            for (var pair of formData.entries()) {
                console.log(pair[0] + ": ", pair[1]);
            }
            // AJAX
            $.ajax({
                url: '/AdminPanel/SaveSystemPrefrences',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    alert("Preferences saved successfully!");
                },
                error: function (xhr, status, error) {
                    alert("Error saving preferences: " + error);
                }
            });
        });
    });
</script>

