@using MainModels.DTOModels
@model PagesViewModel
@{
    ViewData["Title"] = "SystemPrefrences";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <div class="card shadow p-3 rounded-3">
        <div class="card-header fw-bold text-center">
            System Preferences
            @await Html.PartialAsync("/Views/Shared/_PartialBusinessBranches.cshtml")
        <div>
            <button id="fetchdata" class="btn btn-success">Fetch Prefrences</button>
        </div>
        </div>

        <div id="prefrenceDiv" class="card-body">

        </div>
    </div>
</div>

<script>
    $(document).ready(function(){
        $('#fetchdata').click(async function(e){
			 var branchId = $('#branch').val();
             const result = await Utility.RequestDataAjax({
                 url:'/AdminPanel/GetSystemPrefrences',
                 data:{
                     BranchId:branchId
                 }
             });
             $('#prefrenceDiv').html(result);
        })
    })
</script>