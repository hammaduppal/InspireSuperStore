@using MainModels.DTOModels
@model PagesViewModel
@{
	Layout = null;
}

<div class="row">
    <!-- Fiscal Year -->
    <div class="col-lg-4 mb-3">
        <label>Fiscal Year Start Month</label>
        <input type="text" class="form-control" id="FiscalYearStartMonth" disabled
               value="@(string.IsNullOrEmpty(Model.AccountingPreferences.FiscalYearStartMonth) ? "Coming Soon" : Model.AccountingPreferences.FiscalYearStartMonth)">
    </div>
    <div class="col-lg-4 mb-3">
        <label>Fiscal Year End Month</label>
        <input type="text" class="form-control" id="FiscalYearEndMonth" disabled
               value="@(string.IsNullOrEmpty(Model.AccountingPreferences.FiscalYearEndMonth) ? "Coming Soon" : Model.AccountingPreferences.FiscalYearEndMonth)">
    </div>
    <div class="col-lg-4 mb-3">
        <label>Fiscal Year Start Date</label>
        <input type="date" class="form-control" id="FiscalYearStartDate" disabled
               value="@(Model.AccountingPreferences.FiscalYearStartDate == null ? "AAA" : Model.AccountingPreferences.FiscalYearStartDate.Value.ToString("yyyy-MM-dd"))">
    </div>
    <div class="col-lg-4 mb-3">
        <label>Fiscal Year End Date</label>
        <input type="date" class="form-control" id="FiscalYearEndDate" disabled
               value="@(Model.AccountingPreferences.FiscalYearEndDate == null ? "AAA" : Model.AccountingPreferences.FiscalYearEndDate.Value.ToString("yyyy-MM-dd"))">
    </div>

    <!-- Currency -->
    <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
        <label>Enable Multi-Currency</label>
        <label class="switch">
            <input type="checkbox" id="EnableMultiCurrency" disabled
                   @(Model.AccountingPreferences.EnableMultiCurrency ? "checked" : "")>
            <span class="slider"></span>
        </label>
    </div>
    <div class="col-lg-4 mb-3">
        <label>Base Currency Code</label>
        <input type="text" class="form-control" id="BaseCurrencyCode" disabled
               value="@(string.IsNullOrEmpty(Model.AccountingPreferences.BaseCurrencyCode) ? "RS" : Model.AccountingPreferences.BaseCurrencyCode)">
    </div>
    <div class="col-lg-4 mb-3">
        <label>Default Exchange Rate Source</label>
        <input type="text" class="form-control" id="DefaultExchangeRateSource" disabled
               value="@(string.IsNullOrEmpty(Model.AccountingPreferences.DefaultExchangeRateSource) ? "Coming Soon" : Model.AccountingPreferences.DefaultExchangeRateSource)">
    </div>

    <!-- Year Closing -->
    <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
        <label>Enable Automatic Year Closing</label>
        <label class="switch">
            <input type="checkbox" id="EnableAutomaticYearClosing" disabled
                   @(Model.AccountingPreferences.EnableAutomaticYearClosing ? "checked" : "")>
            <span class="slider"></span>
        </label>
    </div>
    <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
        <label>Lock Transactions After Period Close</label>
        <label class="switch">
            <input type="checkbox" id="LockTransactionsAfterPeriodClose" disabled
                   @(Model.AccountingPreferences.LockTransactionsAfterPeriodClose ? "checked" : "")>
            <span class="slider"></span>
        </label>
    </div>

    <!-- Default Accounts -->
    <div class="col-lg-4 mb-3">
        <label>Default Sales Account</label>
        <input type="text" class="form-control" id="DefaultSalesAccount" disabled
               value="@(string.IsNullOrEmpty(Model.AccountingPreferences.DefaultSalesAccount) ? "Coming Soon" : Model.AccountingPreferences.DefaultSalesAccount)">
    </div>
    <div class="col-lg-4 mb-3">
        <label>Default Purchase Account</label>
        <input type="text" class="form-control" id="DefaultPurchaseAccount"
               value="@(string.IsNullOrEmpty(Model.AccountingPreferences.DefaultPurchaseAccount) ? "AAA" : Model.AccountingPreferences.DefaultPurchaseAccount)">
    </div>
    <div class="col-lg-4 mb-3">
        <label>Default Tax Account</label>
        <input type="text" class="form-control" id="DefaultTaxAccount" disabled
               value="@(string.IsNullOrEmpty(Model.AccountingPreferences.DefaultTaxAccount) ? "Coming Soon" : Model.AccountingPreferences.DefaultTaxAccount)">
    </div>

    <!-- Transactions -->
    <div class="col-lg-4 mb-3 d-flex justify-content-between align-items-center">
        <label>Allow Back-Dated Transactions</label>
        <label class="switch">
            <input type="checkbox" id="AllowBackDatedTransactions" 
                   @(Model.AccountingPreferences.AllowBackDatedTransactions ? "checked" : "")>
            <span class="slider"></span>
        </label>
    </div>
</div>

<!-- Save Button -->
<div class="text-center mt-4">
    <button id="btnSavePreferences" class="btn btn-success px-4">Save Preferences</button>
</div>
<style>
    /* Switch style */
    .switch {
        position: relative;
        display: inline-block;
        width: 46px;
        height: 24px;
    }

        .switch input {
            display: none;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 34px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #28a745;
    }

        input:checked + .slider:before {
            transform: translateX(22px);
        }
</style>

        <script>
                $("#btnSavePreferences").click(function () {
        var formData = new FormData();

        // General Accounting Preferences
        formData.append("BranchId", $("#branch").val());

        // Fiscal Year
        formData.append("FiscalYearStartMonth", $("#FiscalYearStartMonth").val());
        formData.append("FiscalYearEndMonth", $("#FiscalYearEndMonth").val());
        formData.append("FiscalYearStartDate", $("#FiscalYearStartDate").val());
        formData.append("FiscalYearEndDate", $("#FiscalYearEndDate").val());

        // Multi-Currency
        formData.append("EnableMultiCurrency", $("#EnableMultiCurrency").is(":checked"));
        formData.append("BaseCurrencyCode", $("#BaseCurrencyCode").val());
        formData.append("DefaultExchangeRateSource", $("#DefaultExchangeRateSource").val());

        // Year Closing
        formData.append("EnableAutomaticYearClosing", $("#EnableAutomaticYearClosing").is(":checked"));
        formData.append("LockTransactionsAfterPeriodClose", $("#LockTransactionsAfterPeriodClose").is(":checked"));

        // Default Accounts
        formData.append("DefaultSalesAccount", $("#DefaultSalesAccount").val());
        formData.append("DefaultPurchaseAccount", $("#DefaultPurchaseAccount").val());
        formData.append("DefaultTaxAccount", $("#DefaultTaxAccount").val());

        // Other Options
        formData.append("AllowBackDatedTransactions", $("#AllowBackDatedTransactions").is(":checked"));

      

        // AJAX request
        $.ajax({
            url: '/AdminPanel/SaveAccountingPreferences',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                alert("Accounting Preferences saved successfully!");
            },
            error: function (xhr, status, error) {
                alert("Error saving accounting preferences: " + error);
            }
        });
    });

        </script>