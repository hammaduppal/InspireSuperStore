@using MainModels.DTOModels
@using MainModels.Util
@model PagesViewModel
@{
	ViewData["Title"] = "EditProduct";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>

				<span class="breadcrumb-item active">Employees</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>

<!-- Content area -->
<div class="content">


	<div class="card shadow-5">
		<div class="card-header header-elements-inline">
			<h5 class="card-title">Employees</h5>
			<div class="header-elements">

				<div class="header-elements d-none">
					<div class="d-flex justify-content-center">
						<a href="/AdminPanel/AddEmployee" class="btn btn-success addProduct">Add Employee</a>

					</div>
				</div>
			</div>
		</div>


		<div class="table-responsive">
			<table class="table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Employee Code</th>

						<th>Branch Name</th>
						<th>Organization Name</th>


						<th>CreatedOn</th>
						<th>Status</th>
						<th>Manage</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model.Employees)
					{
						<tr>
							<td>@item.Person.FirstName, @item.Person.LastName</td>
							<td>@item.EmployeeCode</td>

							<td><a href="#">@item.Person?.Branch?.BranchName</a></td>
							<td><a href="#">@item.Person?.Branch?.Organization.OrganizationName</a></td>

							<td>@TimeHelper.GetFormattedTimeSpan(item.CreatedOn.Value)</td>
							<td>
								@Html.CheckBox("IsSalePerson", item.IsSalePerson, new { @class = "form-input-styled activeUnactive", data_value = item.EmployeeId })

							
							</td>
							<td>
								@if (item.IsActive.Value)
								{
									<span class="badge  badge-success">Active</span>


								}
								else
								{
									<span class="badge badge-secondary">UnActive</span>

								}
							</td>
							<td class="text-center">
@* 								<div class="list-icons">
									<a href="/AdminPanel/EditUser/@item.EmployeeId" class="list-icons-item text-primary-600"><i class="icon-pencil7"></i></a>
								</div> *@
							</td>
						</tr>

					}
				</tbody>
			</table>

		</div>
	</div>


</div>

<script>
	$(document).on('click', '.activeUnactive', function (e) {
				var Id = $(this).attr('data-value');
				var formData={
				EmployeeId:Id,
					IsSalePerson: $(this).is(':checked')
					}
				$.ajax({
					url:'/AdminPanel/EmployeeIsSalePerson',
					method:'POST',
					data:formData,
					success:function(result){
							if(result.statusCode==='200'){
								Utility.successMessage('Record Updated');
								setTimeout(function(){
									location.reload();

								},1000)
							}
							else{
								Utility.failMessage('Some issue in Updating Record');

							}
					}
				})
			});

</script>
<!-- /content area -->
