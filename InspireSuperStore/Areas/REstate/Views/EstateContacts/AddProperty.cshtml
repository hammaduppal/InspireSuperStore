@using MainModels.DTOModels
@using MainModels.Util
@using MarketBal.Helper
@model PagesViewModel
@{
    ViewData["Title"] = "Add Property";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
    <div class="page-header-content header-elements-md-inline">
        <div class="d-flex">
            <div class="breadcrumb">
                <a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
                <span class="breadcrumb-item active">Add Property</span>
            </div>
            <a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
        </div>
    </div>
</div>

<div class="content">
    <div class="card">
        <div class="card-header header-elements-inline">
            <h5 class="card-title">Add Real Estate Property</h5>
        </div>
        <div class="card-body">
            <form id="AddPropertyForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()


                <!-- Removed asp-validation-summary and replaced asp-for bindings with plain name/id attributes -->

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label>Title</label>
                        <input name="Title" id="Title" class="form-control" required />
                    </div>
                    <div class="form-group col-md-6">
                        <label>Property Code</label>
                        <input name="PropertyCode" id="PropertyCode" class="form-control" readonly placeholder="Will be generated by server" />
                        <span class="form-text text-muted">Property code will be generated by the backend on save.</span>
                    </div>
                </div>

                <div class="form-group">
                    <label>Description</label>
                    <textarea name="Description" id="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>Property Type</label>
                        <select name="PropertyTypeId" id="PropertyTypeId" class="form-control" required>
                            <option value="">Select</option>
                            @foreach (var type in Model.PropertyTypes)
                            {
                                <option value="@type.PropertyTypeId">@type.PropertyTypeName</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <label>Purpose</label>
                        <select name="PurposeTypeId" id="PurposeTypeId" class="form-control" required>
                            <option value="">Select</option>
                            @foreach (var purpose in Model.PropertyPurposes)
                            {
                                <option value="@purpose.PurposeTypeId">@purpose.PurposeTypeName</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <label>City</label>
                        <select name="CityId" id="CityId" class="form-control" required>
                            <option value="">Select city</option>
                            @foreach (var item in Model.Cities)
                            {
                                <option value="@item.CityId">@item.CityName</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>Address Details</label>
                    <input name="AddressDetails" id="AddressDetails" class="form-control" />
                </div>

                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label>Price</label>
                        <input name="Price" id="Price" type="number" step="any" class="form-control" />
                    </div>
                    <div class="form-group col-md-3">
                        <label>Security Deposit</label>
                        <input name="SecurityDeposit" id="SecurityDeposit" type="number" step="any" class="form-control" />
                    </div>
                    <div class="form-group col-md-3">
                        <label>Bedrooms</label>
                        <input name="Bedrooms" id="Bedrooms" type="number" class="form-control" />
                    </div>
                    <div class="form-group col-md-3">
                        <label>Bathrooms</label>
                        <input name="Bathrooms" id="Bathrooms" type="number" class="form-control" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label>Covered Area (SqFt)</label>
                        <input name="CoveredAreaSqFt" id="CoveredAreaSqFt" type="number" step="any" class="form-control" />
                    </div>
                    <div class="form-group col-md-4">
                        <label>Base Size (SqFt)</label>
                        <input name="BaseSizeInSqFt" id="BaseSizeInSqFt" type="number" step="any" class="form-control" />
                    </div>
                    <div class="form-group col-md-4">
                        <label>Display Unit</label>
                        <select name="DisplayUnitId" id="DisplayUnitId" class="form-control">
                            <option value="">Select</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label>Latitude</label>
                        <input name="Latitude" id="Latitude" type="number" step="any" class="form-control" />
                    </div>
                    <div class="form-group col-md-3">
                        <label>Longitude</label>
                        <input name="Longitude" id="Longitude" type="number" step="any" class="form-control" />
                    </div>
                    <div class="form-group col-md-3">
                        <label>Year Built</label>
                        <input name="YearBuilt" id="YearBuilt" type="number" class="form-control" />
                    </div>
                    <div class="form-group col-md-3">
                        <label>Parking Spaces</label>
                        <input name="ParkingSpaces" id="ParkingSpaces" type="number" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-check form-check-inline">
                        <label class="form-check-label">   <input type="checkbox" name="IsPriceNegotiable" id="IsPriceNegotiable" class="form-check-input prop-checkbox" /> Price Negotiable</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <label class="form-check-label">   <input type="checkbox" name="HasGas" id="HasGas" class="form-check-input prop-checkbox" /> Has Gas</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <label class="form-check-label">     <input type="checkbox" name="HasElectricity" id="HasElectricity" class="form-check-input prop-checkbox" /> Has Electricity</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <label class="form-check-label"> <input type="checkbox" name="HasWaterSupply" id="HasWaterSupply" class="form-check-input prop-checkbox" /> Has Water</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <label class="form-check-label"> <input type="checkbox" name="HasSewerage" id="HasSewerage" class="form-check-input prop-checkbox" /> Has Sewerage</label>
                    </div>
                </div>

                    
                <div class="form-group col-md-3">
                    <label>Year Built</label>
                    <input name="YearBuilt" id="YearBuilt" type="number" class="form-control" />
                </div>
                <div class="form-group col-md-3">
                    <label>Parking Spaces</label>
                    <input name="ParkingSpaces" id="ParkingSpaces" type="number" class="form-control" />
                </div>

                

                <div class="form-group">
                    <label>Property Media (images)</label>
                    <div id="dropZone" class="border rounded p-4 text-center cursor-pointer" style="min-height:160px; display:flex; align-items:center; justify-content:center; flex-direction:column;">
                        <p class="mb-2"><strong>Drag & drop images here</strong></p>
                        <p class="text-muted mb-0">or click anywhere in this box to browse</p>
                        <input type="file" id="propertyFilesInput" class="property-media-input" name="PropertyMediaFiles" accept="image/*" multiple style="display:none;" />
                    </div>
                    <div id="previewContainer" class="mt-3 d-flex flex-wrap"></div>
                </div>

                <div class="form-group">
                    <label>Video URLs</label>
                    <div id="videoUrlsContainer">
                        <div class="input-group mb-2 video-url-row" id="video_url_row_0">
                            <input type="url" id="VideoUrl_0" name="VideoUrls" class="form-control video-url-input" placeholder="https://" />
                            <div class="input-group-append">
                                <button type="button" class="btn btn-outline-success btn-add-video">+</button>
                            </div>
                        </div>
                    </div>
                    <small class="form-text text-muted">Add one or more video URLs (YouTube/Vimeo).</small>
                </div>
                <div class="form-group">
                    <button type="submit" id="btnSaveProperty" class="btn btn-primary">Save Property</button>
                    <a asp-action="Index" asp-controller="EstateContacts" asp-area="REstate" class="btn btn-secondary ml-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

   

<style>
    #dropZone {
        width: 100%;
        box-sizing: border-box;
        cursor: pointer;
    }

    #previewContainer img {
        max-width: 140px;
        max-height: 120px;
        margin: 6px;
        object-fit: cover;
        border-radius: 4px;
    }
</style>

<script>
    // Global array to manage dropped/browsed files reliably
    var selectedFiles = [];
    var videoCounter = 1;

    $(document).ready(function() {
        var dropZone = document.getElementById('dropZone');
        var fileInput = document.getElementById('propertyFilesInput');
        var previewContainer = document.getElementById('previewContainer');

        // Setup DropZone Events
        if (dropZone) {
            dropZone.addEventListener('click', function() {
                if (fileInput) fileInput.click();
            });
            dropZone.addEventListener('dragover', function(e) {
                e.preventDefault();
                dropZone.classList.add('bg-light');
            });
            dropZone.addEventListener('dragleave', function() {
                dropZone.classList.remove('bg-light');
            });
            dropZone.addEventListener('drop', function(e) {
                e.preventDefault();
                dropZone.classList.remove('bg-light');
                handleNewFiles(e.dataTransfer.files);
            });
        }

        if (fileInput) {
            fileInput.addEventListener('change', function(e) {
                handleNewFiles(e.target.files);
            });
        }

        function handleNewFiles(files) {
            if (!files || files.length === 0) return;

            Array.from(files).forEach(function(file) {
                if (!file.type.startsWith('image/')) return;

                // Push to centralized array
                selectedFiles.push(file);
                var fileIndex = selectedFiles.length - 1;

                var reader = new FileReader();
                reader.onload = function(ev) {
                    var wrap = document.createElement('div');
                    wrap.style.position = 'relative';
                    wrap.setAttribute('data-file-index', fileIndex);

                    var img = document.createElement('img');
                    img.src = ev.target.result;
                    img.alt = file.name;

                    var removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.className = 'btn btn-sm btn-danger';
                    removeBtn.style.position = 'absolute';
                    removeBtn.style.right = '4px';
                    removeBtn.style.top = '4px';
                    removeBtn.textContent = 'x';

                    removeBtn.addEventListener('click', function() {
                        var index = parseInt(wrap.getAttribute('data-file-index'));
                        selectedFiles[index] = null; // Mark removed
                        previewContainer.removeChild(wrap);
                    });

                    wrap.appendChild(img);
                    wrap.appendChild(removeBtn);
                    previewContainer.appendChild(wrap);
                };
                reader.readAsDataURL(file);
            });

            // Reset input so re-selecting same file triggers change event
            $(fileInput).val('');
        }

        // Dynamic Video URLs handlers
        $(document).on('click', '.btn-add-video', function() {
            var container = $('#videoUrlsContainer');
            var rowId = 'video_url_row_' + videoCounter;
            var inputId = 'VideoUrl_' + videoCounter;

            var rowHtml = '<div class="input-group mb-2 video-url-row" id="' + rowId + '">' +
                '<input type="url" id="' + inputId + '" name="VideoUrls" class="form-control video-url-input" placeholder="https://" />' +
                '<div class="input-group-append">' +
                '<button type="button" class="btn btn-outline-success btn-add-video">+</button>' +
                '<button type="button" class="btn btn-outline-danger btn-remove-video">-</button>' +
                '</div></div>';

            container.append(rowHtml);
            videoCounter++;
        });

        $(document).on('click', '.btn-remove-video', function() {
            $(this).closest('.video-url-row').remove();
        });

        // Form Submission & Data Harvesting
        $('#AddPropertyForm').submit(async function(e) {
            e.preventDefault();
            debugger

            // Client-side required fields validation
            var requiredFields = [
                { selector: '#Title', name: 'Title' },
                { selector: '#PropertyTypeId', name: 'Property Type' },
                { selector: '#PurposeTypeId', name: 'Purpose' },
                { selector: '#CityId', name: 'City' }
            ];

            var firstInvalid = null;
            for (var i = 0; i < requiredFields.length; i++) {
                var rf = requiredFields[i];
                var $el = $(rf.selector);
                var val = $el.val();
                if (val === undefined || val === null || (typeof val === 'string' && val.trim() === '')) {
                    $el.addClass('is-invalid');
                    if (!firstInvalid) firstInvalid = { el: $el, name: rf.name };
                } else {
                    $el.removeClass('is-invalid');
                }
            }

            if (firstInvalid) {
                firstInvalid.el.focus();
                alert(firstInvalid.name + ' is required.');
                return;
            }

            // Remove validation marker on change/input
            $(document).on('input change', '#Title,#PropertyTypeId,#PurposeTypeId,#CityId', function() {
                $(this).removeClass('is-invalid');
            });

            var formData = new FormData();

            // Direct Inputs harvesting by ID
            formData.append("Title", $("#Title").val() || "");
            formData.append("PropertyCode", $("#PropertyCode").val() || "");
            formData.append("Description", $("#Description").val() || "");
            formData.append("PropertyTypeId", $("#PropertyTypeId").val() || "");
            formData.append("PurposeTypeId", $("#PurposeTypeId").val() || "");
            formData.append("CityId", $("#CityId").val() || "");
            formData.append("AddressDetails", $("#AddressDetails").val() || "");
            formData.append("Price", $("#Price").val() || 0);
            formData.append("SecurityDeposit", $("#SecurityDeposit").val() || 0);
            formData.append("Bedrooms", $("#Bedrooms").val() || 0);
            formData.append("Bathrooms", $("#Bathrooms").val() || 0);
            formData.append("CoveredAreaSqFt", $("#CoveredAreaSqFt").val() || 0);
            formData.append("BaseSizeInSqFt", $("#BaseSizeInSqFt").val() || 0);
            formData.append("DisplayUnitId", $("#DisplayUnitId").val() || "");
            formData.append("Latitude", $("#Latitude").val() || 0);
            formData.append("Longitude", $("#Longitude").val() || 0);
            formData.append("YearBuilt", $("#YearBuilt").val() || 0);
            formData.append("ParkingSpaces", $("#ParkingSpaces").val() || 0);


            $(".prop-checkbox").each(function() {
                var elementId = $(this).attr('id');
                var isChecked = $(this).is(":checked");
                formData.append(elementId, isChecked);
            });

            $(".video-url-input").each(function() {
                var urlVal = $(this).val();
                if (urlVal && urlVal.trim() !== "") {
                    formData.append("VideoUrls", urlVal.trim());
                }
            });

            selectedFiles.forEach(function(file) {
                if (file !== null) {
                    formData.append("PropertyMediaFiles", file);
                }
            });

           

            // Append antiforgery token if present in form and send via fetch for testing
            var antiToken = $("input[name='__RequestVerificationToken']").val();
            if (antiToken) {
                formData.append('__RequestVerificationToken', antiToken);
            }

            var postUrl = '@Url.Action("AddProperty", "EstateContacts", new { area = "REstate" })';
            var res = await Utility.RequestFileAjax({
                url: postUrl,
                data: formData,
                type: 'POST'
            });

            console.log('Server response:', res);
            if (res && res.status === 'success') {
                alert('Form submitted successfully (server acknowledged). Check console for details.');
            } else {
                alert('Server returned an error. Check console for details.');
            }
        });
    });
</script>