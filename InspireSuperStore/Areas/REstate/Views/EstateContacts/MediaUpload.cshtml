@using MainModels.DTOModels
@using MainModels.Util
@using MarketBal.Helper
@model PagesViewModel
@{
    ViewData["Title"] = "Labour";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
    <div class="page-header-content header-elements-md-inline">

        <div class="d-flex">
            <div class="breadcrumb">
                <a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>

                <span class="breadcrumb-item active">Gallery</span>
            </div>

            <a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
        </div>
    </div>


</div>

<!-- Content area -->
<!-- Content area -->
<div class="content">

	<!-- Media library -->
	<div class="card">
		<div class="card-header header-elements-inline">
			<h5 class="card-title">Gallery</h5>
			<div class="header-elements">

				<div class="header-elements d-none">
					<div class="d-flex justify-content-center">
						<a id="" href="/EstateContacts/AddMedia" class="btn btn-success ">Add Media</a>

					</div>
				</div>
			</div>
		</div>

		<table class="table table-striped media-library">
			<thead>
				<tr>
					<th><input type="checkbox" class="form-input-styled"></th>
					<th>Preview</th>
					<th>Title</th>
					<th>Description</th>
					<th class="text-center">Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model.MediaData)
				{
					<tr>
						<td><input type="checkbox" class="form-input-styled"></td>
						<td>
							@* Show first RelinksFiles entry if present - could be image or video *@
							@if (item.RelinksFiles != null && item.RelinksFiles.Count > 0)
							{
								var firstUrl = item.RelinksFiles.ToList().FirstOrDefault().ReLinkFileUrl ?? string.Empty;
								var ext = System.IO.Path.GetExtension(firstUrl ?? "").ToLowerInvariant();
								var isImage = ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif" || ext == ".webp";
								var isVideo = ext == ".mp4" || ext == ".webm" || ext == ".ogg";

								if (isImage)
								{
									<a href="@firstUrl" data-popup="lightbox">
										<img src="@PagesViewModel.SystemSettings.ContentAPIUrl/@firstUrl" alt="" class="img-preview rounded">
									</a>
								}
								else if (isVideo)
								{
									<video controls class="img-preview rounded" style="max-width:150px; max-height:100px;">
										<source src="@firstUrl" type="video/mp4" />
										Your browser does not support the video tag.
									</video>
								}
								else
								{
									<a href="@firstUrl" target="_blank">
										<img src="../../../../global_assets/images/placeholders/placeholder.jpg" alt="" class="img-preview rounded">
									</a>
								}
							}
							else
							{
								<a href="../../../../global_assets/images/placeholders/placeholder.jpg" data-popup="lightbox">
									<img src="../../../../global_assets/images/placeholders/placeholder.jpg" alt="" class="img-preview rounded">
								</a>
							}
						</td>
						<td><span href="#">@item.Title</span></td>
						<td><span href="#">@item.Description</span></td>
						
						<td class="text-center">
							<div class="list-icons">
								<div class="list-icons-item dropdown">
									<a href="#" class="list-icons-item caret-0 dropdown-toggle" data-toggle="dropdown">
										<i class="icon-menu9"></i>
									</a>

									<div class="dropdown-menu dropdown-menu-right">
										<a href="/EstateContacts/EditMediaUpload?mediaId=@item.RelinksDataId" class="dropdown-item"><i class="icon-pencil7"></i> View / Edit</a>
										<a href="#" class="dropdown-item"><i class="icon-copy4"></i> Copy file</a>
										<a href="#" class="dropdown-item"><i class="icon-eye-blocked"></i> Unpublish</a>
										<div class="dropdown-divider"></div>
										<a href="#" class="dropdown-item"><i class="icon-bin"></i> Move to trash</a>
									</div>
								</div>
							</div>
						</td>
					</tr>

				}
			
				
			</tbody>
		</table>
	</div>

</div>
<script>
    $(document).ready(function(){
        $('.table').DataTable();

   
    });
</script>