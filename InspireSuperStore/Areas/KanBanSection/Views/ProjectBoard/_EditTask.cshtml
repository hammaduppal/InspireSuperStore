@using MainModels.DTOModels
@using MainModels.Util
@model PagesViewModel

<div class="modal-body p-3">
    <div class="row">

        <div class="col-lg-8 border-right-md border-light">

            <div class="d-flex align-items-start mb-3">
                <i class="icon-notebook text-muted mr-3 mt-1 fa-2x"></i>
                <div class="w-100">
                    <style>
                        /* Styled to match your borderless header inputs look */
                        .editable-task-title {
                            border: 1px solid transparent;
                            background: transparent;
                            font-size: 1.5rem; /* Matches h4 sizing metrics */
                            padding: 2px 6px;
                            border-radius: 3px;
                            transition: all 0.15s ease-in-out;
                        }

                            .editable-task-title:focus {
                                background: #fff;
                                border-color: #5c6bc0;
                                outline: none;
                                box-shadow: 0 0 0 1px #5c6bc0;
                            }
                    </style>

                    <input type="text"
                           id="txt-task-title-modal"
                           class="font-weight-semibold mb-1 text-dark w-100 editable-task-title"
                           value="@Model.Task.Title"
                           data-old-val="@Model.Task.Title" />
                    <span class="text-muted small">in column <span class="badge badge-light font-weight-semibold">@Model.Task.ColumnName</span></span>
                </div>
            </div>
           
            <div class="mb-4 pl-4">
                <h6 class="font-weight-semibold text-body mb-2"><i class="icon-file-text2 mr-2 text-muted"></i> Description</h6>
                <textarea id="description" class="bg-light p-3 rounded text-muted font-size-sm form-control">@Html.Raw(Model.Task.Description)</textarea>
                <div class="text-right mt-2">
                    <button id="saveDesc" data-taskId="@Model.Task.TaskId" class="btn btn-indigo btn-sm font-weight-semibold px-3">Save</button>
                </div>
            </div>
            <script>
                 $('#saveDesc').click(function(e){
                    e.preventDefault(); // Prevent accidental form submissions or page jumps

                    // Fix: Access summernote directly from the existing element
                    var descHtml = $('#description').summernote('code');

                    var formData = {
                        Description: descHtml,
                        TaskId: $(this).attr('data-taskId') // Make sure this matches your HTML casing
                    };

                    $.ajax({
                        url: '/ProjectBoard/UpdateTaskDescription',
                        type: 'POST',
                        contentType: 'application/json; charset=utf-8', // Explicit encoding
                        data: JSON.stringify(formData), // CRITICAL: Must turn the object into a JSON string
                        success: function(result){
                            // Fix: Match the C# response object property casing (lowercase 's' and 'm')
                            if(result.statusCode === '200') {
                                Utility.successMessage(result.message);
                            }
                            else {
                                Utility.failMessage(result.message);
                            }
                        },
                        error: function(err) {
                            Utility.failMessage("An error occurred while communication with the server.");
                        }
                    });
                });
            </script>
            <script>
                                $(document).on('focusout', '#txt-task-title-modal', function() {
                    var inputEl = $(this);
                    var currentTitle = inputEl.val().trim();
                    var oldTitle = inputEl.data('old-val');
                    var taskId = $('#saveDesc').attr('data-taskId'); // Extract our global task GUID reference

                    // 1. Guardrail: If input text is cleared completely, restore old text string and abort
                    if (currentTitle === "") {
                        inputEl.val(oldTitle);
                        return;
                    }

                    // 2. Dispatch save operational command only if something shifted
                    if (currentTitle !== oldTitle) {
                        $.ajax({
                            url: '/ProjectBoard/UpdateTaskTitle',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                TaskId: taskId,
                                Title: currentTitle
                            }),
                            success: function(res) {
                                if (res.success) {
                                    // Update cache baseline state tracker
                                    inputEl.data('old-val', currentTitle);

                                    // UX Polish: Dynamically update the specific task card's header text on the background Kanban board view instantly
                                    $(`.card-limitless[data-card-id="${taskId}"]`).find('.text-body').text(currentTitle);

                                    console.log("Task title updated successfully.");
                                } else {
                                    Utility.failMessage("Could not update task title: " + res.message);
                                    inputEl.val(oldTitle); // Revert UI
                                }
                            },
                            error: function() {
                                Utility.failMessage("Communication error updating task title component.");
                                inputEl.val(oldTitle);
                            }
                        });
                    }
                });

                // Allow the user to press 'Enter' to submit the header change instantly
                $(document).on('keypress', '#txt-task-title-modal', function(e) {
                    if (e.which == 13) {
                        e.preventDefault();
                        $(this).blur(); // Forces focusout block above to fire
                    }
                });


            </script>
            <div class="mb-4 pl-4">
                <h6 class="font-weight-semibold text-body mb-2"><i class="icon-attachment mr-2 text-muted"></i> Attachments</h6>
                <div class="row">
                    @if (Model.Task.TaskAttachments != null)
                    {
                        foreach (var item in Model.Task.TaskAttachments)
                        {
                            <div class="col-sm-6 mb-2">
                                <div class="border rounded p-2 d-flex align-items-center bg-white shadow-sm">
                                   @*  <i class="icon-file-pdf text-danger fa-2x mr-2"></i> *@
                                    <div class="text-truncate mr-2">
                                        <a href="@PagesViewModel.SystemSettings.ContentAPIUrl/@item.AttachmentUrl" class="font-weight-semibold text-body font-size-sm text-truncate d-block">Download</a>
                                     @*    <span class="text-muted small">1.4 Mbs</span> *@
                                    </div>
                                    @if (@AppDataUtility.SessionUser.Id == item.UserId)
                                    {
                                        <button class="btn btn-link text-muted ml-auto p-0"><i class="icon-trash text-danger"></i></button>
                                    }
                                </div>
                            </div>

                        }
                    }

                </div>
                <input type="file" id="file-attachment-uploader" multiple style="display: none;" />
                <button type="button" class="btn btn-light btn-sm text-muted mt-1" id="btn-trigger-upload">
                    <i class="icon-plus2 mr-1"></i> Add Attachment
                </button>
            </div>

            <hr class="border-light my-4">

            <div class="pl-4">
                <h6 class="font-weight-semibold text-body mb-3"><i class="icon-bubble2 mr-2 text-muted"></i> Discussion</h6>

                @{
                // Read directly from your custom session manager instance layout context
                var activePerson = AppDataUtility.SessionUser?.Person;
                var sessionF = activePerson?.FirstName ?? "System";
                var sessionL = activePerson?.LastName ?? "User";

                // Compute current initial tags markers strings elements fields
                var currentFInit = !string.IsNullOrEmpty(sessionF) ? sessionF.Substring(0, 1).ToUpper() : "";
                var currentLInit = !string.IsNullOrEmpty(sessionL) ? sessionL.Substring(0, 1).ToUpper() : "";
                var sessionInitials = !string.IsNullOrEmpty(currentFInit + currentLInit) ? (currentFInit + currentLInit) : "??";
                }

                <div class="media mb-3 border p-2 bg-light rounded shadow-sm">
                    <div class="mr-3">
                        <div class="avatar-placeholder bg-indigo text-white font-weight-bold d-flex align-items-center justify-content-center rounded-circle"
                             style="width:36px; height:36px; font-size:12px;"
                             title="@sessionF @sessionL">
                            @sessionInitials
                        </div>
                    </div>
                    <div class="media-body">
                        <textarea id="txt-new-task-comment" class="form-control font-size-sm border-0 bg-transparent p-0" rows="2" placeholder="Write a professional update or comment..."></textarea>
                        <hr class="my-1 border-light">
                        <div class="text-right mt-2">
                            <button type="button" id="btn-save-task-comment" class="btn btn-indigo btn-sm font-weight-semibold px-3">Save Comment</button>
                        </div>
                    </div>
                </div>

                @{
                    var currentSessionUserId = AppDataUtility.SessionUser?.Id ?? 0;
                }

                <div class="comment-list mt-4" id="task-comments-stream-container" style="max-height: 400px; overflow-y: auto; padding-right: 5px;">
                    @if (Model.Task.TaskComments != null)
                    {
                        // Order by Descending so newest entries stay right at the top
                        foreach (var comment in Model.Task.TaskComments.Where(c => c.IsDeleted == false).OrderByDescending(c => c.CreatedOn))
                        {
                            var isMyComment = comment.UserId == currentSessionUserId;

                            <div class="d-flex mb-3 align-items-start @(isMyComment ? "justify-content-end text-right" : "") comment-node-row">

                                @if (!isMyComment)
                                {
                                    <div class="mr-2 flex-shrink-0">
                                        @{
                                            var authF = AppDataUtility.SessionUser?.Person?.FirstName ?? "";
                                            var authL = AppDataUtility.SessionUser?.Person?.LastName ?? "";
                                            var authInitials = $"{(authF.Length > 0 ? authF.Substring(0, 1) : "")}{(authL.Length > 0 ? authL.Substring(0, 1) : "")}".ToUpper();
                                        }
                                        <div class="avatar-placeholder bg-secondary text-white font-weight-bold d-flex align-items-center justify-content-center rounded-circle" style="width:32px; height:32px; font-size:10px;" title="@authF @authL">
                                            @(string.IsNullOrEmpty(authInitials) ? "?" : authInitials)
                                        </div>
                                    </div>
                                }

                                <div class="media-body font-size-sm max-width-75">
                                    <div class="bg-light p-2 rounded @(isMyComment ? "bg-indigo-50 border-indigo-100" : "bg-white border-light") border shadow-sm text-left text-dark">
                                        <div class="d-flex justify-content-between align-items-center mb-1 font-size-xs text-muted">
                                            <span class="font-weight-semibold text-body mr-3">@(isMyComment ? "You" : $"{AppDataUtility.SessionUser?.Person?.FirstName} {AppDataUtility.SessionUser?.Person?.LastName}")</span>
                                            <span>@TimeHelper.GetFormattedTimeSpan(comment.CreatedOn.Value)</span>
                                        </div>
                                        <p class="mb-0 text-muted" style="white-space: pre-line;">@comment.TaskComments</p>
                                    </div>
                                </div>

                                @if (isMyComment)
                                {
                                    <div class="ml-2 flex-shrink-0">
                                        @{
                                            var myF = AppDataUtility.SessionUser?.Person?.FirstName ?? "";
                                            var myL = AppDataUtility.SessionUser?.Person?.LastName ?? "";
                                            var myInitials = $"{(myF.Length > 0 ? myF.Substring(0, 1) : "")}{(myL.Length > 0 ? myL.Substring(0, 1) : "")}".ToUpper();
                                        }
                                        <div class="avatar-placeholder bg-indigo text-white font-weight-bold d-flex align-items-center justify-content-center rounded-circle" style="width:32px; height:32px; font-size:10px;" title="@myF @myL">
                                            @(string.IsNullOrEmpty(myInitials) ? "ME" : myInitials)
                                        </div>
                                    </div>
                                }

                            </div>
                        }
                    }
                </div>
            </div>

        </div>
       
        <div class="col-lg-4 pl-lg-4 mt-3 mt-lg-0">

            <div class="mb-4">
                <span class="text-muted text-uppercase font-weight-semibold font-size-sm letter-spacing-1 d-block mb-3">Workspace Controls</span>

                <div class="mb-3">
                    <label class="text-muted small font-weight-semibold mb-1 d-block">Assigned Team Members</label>
                    <div class="d-flex flex-wrap align-items-center mb-2" id="assignedMembers">
                        @if (Model.Task.TaskAssignedUsers != null)
                        {
                            foreach (var member in Model.Task.TaskAssignedUsers)
                            {
                                <div class="badge badge-light border border-light p-1 pr-2 rounded-round d-flex align-items-center mr-2 mb-1" data-userid="@member.TaskAssignedUserId">
                                    @if (!string.IsNullOrEmpty(member.ImageUrl))
                                    {
                                        <img src="@PagesViewModel.SystemSettings.ContentAPIUrl/@member.ImageUrl" class="rounded-circle mr-1" width="18" height="18" alt="User">
                                    }
                                    <span class="text-body font-weight-semibold font-size-sm">@member.FirstName @member.LastName</span>
                                </div>
                            }
                        }
                    </div>
                    <div class="position-relative">
                        <button id="assignMemberBtn" data-taskid="@Model.Task.TaskId" class="btn btn-light btn-block btn-sm text-left text-muted"><i class="icon-user-plus mr-2"></i> Assign a member...</button>
                        <div id="assignUserDropdown" class="card" style="position:absolute; z-index:2000; display:none; width:100%; max-height:260px; overflow:auto;">
                            <div class="card-body p-2" id="assignUserList">
                                <!-- populated by AJAX -->
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="text-muted small font-weight-semibold mb-1 d-block">Task Priority</label>
                    <div class="dropdown">
                        @if (Model.Task.Priority == ProjectTaskPriority.High.ToString())
                        {
                            <button class="btn btn-light btn-block btn-sm dropdown-toggle text-left font-weight-semibold border-danger-300 text-danger-700" id="btn-priority-display" type="button" data-toggle="dropdown">
                                <i class="icon-primitive-dot mr-2 text-danger"></i> High Priority
                            </button>
                        }
                        else if (Model.Task.Priority == ProjectTaskPriority.Normal.ToString())
                        {
                            <button class="btn btn-light btn-block btn-sm dropdown-toggle text-left font-weight-semibold border-primary-300 text-primary-700" id="btn-priority-display" type="button" data-toggle="dropdown">
                                <i class="icon-primitive-dot mr-2 text-primary"></i> Normal Priority
                            </button>
                        }
                        else if (Model.Task.Priority == ProjectTaskPriority.Low.ToString())
                        {
                            <button class="btn btn-light btn-block btn-sm dropdown-toggle text-left font-weight-semibold border-success-300 text-success-700" id="btn-priority-display" type="button" data-toggle="dropdown">
                                <i class="icon-primitive-dot mr-2 text-success"></i> Low Priority
                            </button>
                        }

                        <div class="dropdown-menu dropdown-menu-right w-100" id="priority-change-menu">
                            <a class="dropdown-item text-danger" href="#" data-priority="@ProjectTaskPriority.High.ToString()">
                                <i class="icon-primitive-dot mr-2 text-danger"></i> High
                            </a>
                            <a class="dropdown-item text-primary" href="#" data-priority="@ProjectTaskPriority.Normal.ToString()">
                                <i class="icon-primitive-dot mr-2 text-primary"></i> Normal
                            </a>
                            <a class="dropdown-item text-success" href="#" data-priority="@ProjectTaskPriority.Low.ToString()">
                                <i class="icon-primitive-dot mr-2 text-success"></i> Low
                            </a>
                        </div>
                    </div>
                </div>
                <style>
                    /* Clean inline date picker look */
                    .inline-date-picker {
                        border: none;
                        background: transparent;
                        font-weight: 600;
                        padding: 0;
                        color: #333;
                        text-align: right;
                        cursor: pointer;
                        max-width: 130px;
                    }

                        .inline-date-picker:focus {
                            outline: none;
                            background-color: #fff;
                            box-shadow: 0 0 0 1px #5c6bc0;
                            border-radius: 2px;
                            padding: 0 4px;
                        }
                        /* Placeholder fallback styling for null dates */
                        .inline-date-picker.date-empty {
                            color: #999 !important;
                            font-weight: normal;
                        }
                </style>
                <div class="mb-3">
                    <label class="text-muted small font-weight-semibold mb-1 d-block">Dates Tracking</label>
                    <div class="bg-light p-2 rounded border border-light font-size-sm">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small">Started:</span>
                            <input type="date"
                                   id="dt-start-date"
                                   class="inline-date-picker @(Model.Task.StartDate.HasValue ? "" : "date-empty")"
                                   value="@(Model.Task.StartDate.HasValue? Model.Task.StartDate.Value.ToString("yyyy-MM-dd") : "")" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Due Date:</span>
                            <input type="date"
                                   id="dt-due-date"
                                   class="inline-date-picker text-danger font-weight-semibold"
                                   value="@(Model.Task.DueDate.HasValue? Model.Task.DueDate.Value.ToString("yyyy-MM-dd") : "")" />
                        </div>
                    </div>
                </div>



            </div>

        </div>

    </div>
</div>
<script>
     $(document).on('click', '#btn-save-task-comment', function(e) {
        e.preventDefault();

        var btnEl = $(this);
        var txtArea = $('#txt-new-task-comment');
        var commentText = txtArea.val().trim();
        var taskId = $('#saveDesc').attr('data-taskId'); // Active task running reference

        if (commentText === "") return;

        // Transition state block to prevent multiple form posts
        btnEl.attr('disabled', 'disabled').text("Saving...");

        $.ajax({
            url: '/ProjectBoard/SaveTaskComment',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                TaskId: taskId,
                CommentText: commentText
            }),
            success: function(res) {
                if (res.success) {
                    // Clear the editor text workspace instantly
                    txtArea.val('');

                    // Build modern activity log component structure with returning transaction items variables tokens
                    var newCommentHtml = `
                        <div class="media mb-3 border-bottom border-light pb-2 comment-node-row" style="display:none;">
                            <div class="mr-3">
                                <div class="avatar-placeholder bg-secondary text-white font-weight-bold d-flex align-items-center justify-content-center rounded-circle" style="width:32px; height:32px; font-size:10px;">${res.authorInitials}</div>
                            </div>
                            <div class="media-body font-size-sm">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="font-weight-semibold text-body">${res.authorName}</span>
                                    <span class="text-muted small">Just now</span>
                                </div>
                                <p class="text-muted mb-1">${commentText}</p>
                            </div>
                        </div>`;

                    // Prepend item down the viewport timeline layout and animate appearance
                    $('#task-comments-stream-container').prepend(newCommentHtml);
                    $('.comment-node-row').first().fadeIn(300);
                    Utility.successMessage('Message Saved');
                    console.log("Activity stream tracking trace updated successfully.");
                } else {
                    Utility.failMessage("Could not post comment trace tracking details: " + res.message);
                }
            },
            complete: function() {
                // Re-enable actions buttons interfaces indicators
                btnEl.removeAttr('disabled').text("Save Comment");
            }
        });
    });

</script>
<script>
    $(document).ready(function(){
     $('#description').summernote();
    })
</script>
<script>
        (function(){
            var $assignBtn = $('#assignMemberBtn');
            var $dropdown = $('#assignUserDropdown');
            var $list = $('#assignUserList');

            function renderUserBadge(userId, firstName, lastName, imageUrl){
                var $badge = $('<div/>', { 'class': 'badge badge-light border border-light p-1 pr-2 rounded-round d-flex align-items-center mr-2 mb-1' });
                if(imageUrl){
                    $badge.append('<img src="'+imageUrl+'" class="rounded-circle mr-1" width="18" height="18" alt="User">');
                }
                $badge.append('<span class="text-body font-weight-semibold font-size-sm">'+firstName+' '+lastName+'</span>');
                return $badge;
            }

            $assignBtn.on('click', function(e){
                e.preventDefault();
                var taskId = $(this).attr('data-taskid');
                if($dropdown.is(':visible')){
                    $dropdown.hide();
                    return;
                }

                // If list already populated, just show
                if($list.children().length > 0){
                    $dropdown.show();
                    return;
                }

                // Fetch project users for this task
                $.ajax({
                    url: '/ProjectBoard/GetProjectUsers',
                    type: 'GET',
                    data: { taskId: taskId },
                    success: function(res){
                        if(res && res.success){
                            $list.empty();
                            if(res.users && res.users.length){
                                res.users.forEach(function(u){
                                    var $row = $('<div/>', { 'class': 'd-flex align-items-center p-1 assign-user-item', 'data-userid': u.userId });
                                    if(u.imageUrl){
                                        $row.append('<img src="'+u.imageUrl+'" class="rounded-circle mr-2" width="28" height="28" alt="User">');
                                    } else {
                                        $row.append('<div class="avatar-placeholder bg-light text-muted rounded-circle mr-2 d-flex align-items-center justify-content-center" style="width:28px;height:28px;font-size:11px;">'+(u.firstName?u.firstName.charAt(0):'U')+'</div>');
                                    }
                                    $row.append('<div class="flex-grow-1"><div class="font-weight-semibold">'+u.firstName+' '+u.lastName+'</div></div>');
                                    var $assignAction = $('<button/>', { 'class': 'btn btn-sm btn-outline-primary ml-2 assign-user-action', text: 'Assign' });
                                    $row.append($assignAction);
                                    $list.append($row);
                                });
                            }
                            else{
                                $list.append('<div class="text-muted small">No project members found. Add members to the project first.</div>');
                            }
                            $dropdown.show();
                        }
                        else{
                            Utility.failMessage(res && res.message ? res.message : 'Failed to load project users');
                        }
                    },
                    error: function(err){
                        Utility.failMessage('Failed to load project users');
                    }
                });
            });

            // Delegate click for assign action
            $list.on('click', '.assign-user-action', function(e){
                e.preventDefault();
                var $row = $(this).closest('.assign-user-item');
                var userId = $row.attr('data-userid');
                var taskId = $assignBtn.attr('data-taskid');
                if(!userId) return;

                var payload = { TaskId: taskId, UserId: userId };
                $.ajax({
                    url: '/ProjectBoard/AssignUser',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: JSON.stringify(payload),
                    success: function(res){
                        if(res && res.success){
                            // Add badge to assigned members list
                            var name = $row.find('.font-weight-semibold').text().trim();
                            var parts = name.split(' ');
                            var firstName = parts[0] || '';
                            var lastName = parts.slice(1).join(' ');
                            var img = $row.find('img').attr('src') || '';
                            var $badge = renderUserBadge(userId, firstName, lastName, img);
                            $('#assignedMembers').append($badge);
                            Utility.successMessage('User assigned to task');
                            $dropdown.hide();
                        }
                        else{
                            Utility.failMessage(res && res.message ? res.message : 'Failed to assign user');
                        }
                    },
                    error: function(){
                        Utility.failMessage('Failed to assign user');
                    }
                });
            });

            // click outside to close
            $(document).on('click', function(e){
                if($(e.target).closest('#assignUserDropdown, #assignMemberBtn').length === 0){
                    $dropdown.hide();
                }
            });

            $(document).on('click', '#priority-change-menu .dropdown-item', function(e) {
                    e.preventDefault();

                    var selectedItem = $(this);
                    var priorityString = selectedItem.data('priority'); // Returns "High", "Normal", or "Low"
                    var taskId = $('#saveDesc').attr('data-taskId');    // Read your active Task GUID reference

                    // Determine target CSS styles based on selection to update your button look dynamically
                    var btnColorClass = "text-primary-700";
                    var borderColorClass = "border-primary-300";
                    var dotColorClass = "text-primary";

                    if (priorityString === "High") {
                        btnColorClass = "text-danger-700";
                        borderColorClass = "border-danger-300";
                        dotColorClass = "text-danger";
                    } else if (priorityString === "Low") {
                        btnColorClass = "text-success-700";
                        borderColorClass = "border-success-300";
                        dotColorClass = "text-success";
                    }

                    var payload = {
                        TaskId: taskId,
                        Priority: priorityString
                    };

                    $.ajax({
                        url: '/ProjectBoard/UpdateTaskPriority',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        success: function(res) {
                            if (res.success) {
                                // Wipe clean old contextual state classes from the active toggle button
                                $('#btn-priority-display')
                                    .removeClass('text-danger-700 text-primary-700 text-success-700 border-danger-300 border-primary-300 border-success-300')
                                    .addClass(btnColorClass + ' ' + borderColorClass)
                                    .html(`<i class="icon-primitive-dot mr-2 ${dotColorClass}"></i> ${priorityString} Priority`);

                                Utility.successMessage("Task priority modified successfully.");
                            } else {
                                Utility.failMessage("Could not update priority: " + res.message);
                            }
                        },
                        error: function() {
                            Utility.failMessage("Communication error updating priority state.");
                        }
                    });


             });

             $(document).on('change', '#dt-start-date, #dt-due-date', function() {
                var inputEl = $(this);
                var dateVal = inputEl.val(); // Returns "YYYY-MM-DD" or empty string ""
                var isStartDate = inputEl.attr('id') === 'dt-start-date';
                var taskId = $('#saveDesc').attr('data-taskId');

                // Manage empty tracking styles for the Start Date field configuration
                if (isStartDate) {
                    if (dateVal === "") {
                        inputEl.addClass('date-empty');
                    } else {
                        inputEl.removeClass('date-empty');
                    }
                }

                $.ajax({
                    url: '/ProjectBoard/UpdateTaskDates',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        TaskId: taskId,
                        DateValue: dateVal === "" ? null : dateVal, // Send null seamlessly if cleared
                        IsStartDate: isStartDate
                    }),
                    success: function(res) {
                        if (res.success) {
                            Utility.successMessage("Schedule deadline updated successfully.");
                        } else {
                            Utility.failMessage("Failed to save schedule change: " + res.message);
                        }
                    },
                    error: function() {
                        Utility.failMessage("Error communicating date modifications.");
                    }
                });
            });


            $(document).on('click', '#btn-trigger-upload', function() {
                 $('#file-attachment-uploader').click();
            });

    // Capture input change event when manager selects files
    $(document).on('change', '#file-attachment-uploader', function() {
        var files = this.files;
        var taskId = $('#saveDesc').attr('data-taskId'); // Extract running task GUID

        if (files.length === 0) return;

        // Instantiating binary Multi-part payload container object
        var formData = new FormData();
        formData.append("TaskId", taskId);

        // Loop and append every selected file down the streaming index context array
        for (var i = 0; i < files.length; i++) {
            formData.append("Files", files[i]);
        }

        // Visual loading state indicator adjustment
        $('#btn-trigger-upload').html('<i class="icon-spinner2 spinner mr-1"></i> Uploading...').attr('disabled', 'disabled');

        $.ajax({
            url: '/ProjectBoard/UploadAttachments',
            type: 'POST',
            data: formData,
            processData: false,  // CRITICAL: Prevent jQuery from converting FormData to string sequence parameters
            contentType: false,  // CRITICAL: Tells the browser engine to configure accurate boundary tags multi-part headers
            success: function(res) {
                if (res.success) {
                    // Loop through array elements returned from the database layer tracking pipeline
                    res.uploadedFiles.forEach(function(file) {
                        var fileCardHtml = `
                            <div class="col-sm-6 mb-2 file-attachment-node" data-attachment-id="${file.attachmentId}" style="display:none;">
                                <div class="border rounded p-2 d-flex align-items-center bg-white shadow-sm">
                                    <i class="icon-file-text3 text-blue mr-2 fa-2x"></i>
                                    <div class="text-truncate mr-2">
                                        <a href="${file.filePath}" target="_blank" class="font-weight-semibold text-body font-size-sm text-truncate d-block" title="${file.fileName}">
                                            ${file.fileName}
                                        </a>
                                        <span class="text-muted small">Just now</span>
                                    </div>
                                    <button type="button" class="btn btn-link text-muted ml-auto p-0 btn-delete-attachment"><i class="icon-trash text-danger"></i></button>
                                </div>
                            </div>`;

                        // Prepend card and animate opening appearance
                        $('#task-attachments-list').prepend(fileCardHtml);
                        $('.file-attachment-node[data-attachment-id="' + file.attachmentId + '"]').fadeIn(300);
                    });

                    Utility.successMessage("All attachments parsed and saved successfully.");
                } else {
                    Utility.failMessage("Upload failed: " + res.message);
                }
            },
            complete: function() {
                // Restore trigger button states indicators interface controls
                $('#btn-trigger-upload').html('<i class="icon-plus2 mr-1"></i> Add Attachment').removeAttr('disabled');
                $('#file-attachment-uploader').val(''); // Reset uploader clear memory stack cache
            }
        });
    });

    // ==========================================
    // DYNAMIC DISMISS ATTACHMENT CARD (SOFT-DELETE)
    // ==========================================
    $(document).on('click', '.btn-delete-attachment', function(e) {
        e.preventDefault();
        var nodeEl = $(this).closest('.file-attachment-node');
        var attachmentId = nodeEl.data('attachment-id');

        if (confirm("Are you sure you want to delete this attachment link?")) {
            $.ajax({
                url: '/ProjectBoard/DeleteAttachment',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ AttachmentId: attachmentId }),
                success: function(res) {
                    if (res.success) {
                        nodeEl.fadeOut(250, function() { $(this).remove(); });
                    } else {
                        alert("Unable to delete item: " + res.message);
                    }
                }
            });
        }
    });
        })();
</script>
