@using MainModels.DTOModels
@using MainModels.Util
@model PagesViewModel
@{
	ViewData["Title"] = "CreateInvoice";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="page-header page-header-light">
	<div class="row">
		<!-- Barcode Input -->
		<div class="col-md-3">
			<div class="input-group">
				<div class="input-group-prepend">
					<span class="input-group-text"><i class="icon-barcode2"></i></span>
				</div>
				<input type="text" id="barCode" name="barCode" class="form-control" autocomplete="off" placeholder="Search BarCode........." />
			</div>
		</div>
		<!-- Manual Search Input -->
		<div class="col-md-3">
			<div class="input-group">
				<div class="input-group-prepend">
					<span class="input-group-text"><i class="icon-search4"></i></span>
				</div>
				<div class="form-group-feedback form-group-feedback-right">
					<select id="productSearch" style="width: 100%" class="form-control"></select>

				</div>
			</div>
		</div>
		<div class="col-lg-3">
			<div class="input-group">
				<select id="customers" class="form-control">
					@foreach (var item in Model.Customers)
					{
						<option value="@item.CustomerId">@item.CustomerName + @item.Mobile </option>

					}
				</select>
				<div class="input-group-append">
					<button id="addCustomer" class="btn btn-light" type="button"><i class="icon-user-plus"></i></button>
				</div>
			</div>
		</div>
		@if(AppDataUtility.SystemPreferences.IsAffilatedInvoice)
		{
			<div class="col-lg-3">
				<div class="input-group">
					<select class="form-control">
						<option>Walk-in Customer</option>
						<option>John Smith</option>
						<option>Maria Garcia</option>
					</select>
				</div>
			</div>
		}
	
	</div>
	<script>
		$('#addCustomer').on('click',async function () {
			var result = await Utility.RequestAjax('/Account/_AddCustomerForm');
			$('.modal-title-horizontal').html('Add New Customer');
			$('#modal-body-horizontal').html(result);
			$('#modal_form_horizontal').modal();
		});
			$(document).on('submit','#addNewCustomer',async function(e){
			  e.preventDefault();
			     var formData = {
					FirstName: $('#firstName').val(),
					LastName: $('#lastName').val(),
					MobileNumber: $('#mobile').val(),
					Email: $('#email').val(),
					Address: $('#address').val(),
					CityId: $('#city').val()
				};
				console.log(formData);
				var objectData={
					url:'/Account/AddNewCustomer',
					data:formData,
				}
				var result =await Utility.RequestDataAjax(objectData);
				if(result.statusCode==='200'){
					debugger
					$('#modal_form_horizontal').modal('hide');
					var customers = await Utility.RequestAjax('/AdminPanel/GetCustomers');
					var $select = $('#customers');
					$select.empty();

					// Populate new options
					customers.forEach(function (item) {
						var isSelected = item.CustomerId === result.CustomerId; // check if it's the newly added
						var option = $('<option>', {
							value: item.CustomerId,
							text: item.CustomerName + ' ' + item.Mobile,
							selected: isSelected
						});
						$select.append(option);
					});

				}
		    })
		
	</script>
	

</div>



<div class="content">



	
