							});

							$(document).on('click', '.subcatBtn', async function () {
									var subcategoryId = $(this).data('subcatid');
									var getsubcatProducts = await Utility.RequestDataAjax({
										url:'/Products/GetProductBySubCategoryId',
										data:{
											SubCategoryId:subcategoryId
										}
									})
									console.log(getsubcatProducts);
									renderTopFiveProducts(getsubcatProducts.TopProducts);
									renderAllProducts(getsubcatProducts.AllProducts);

							});








								function renderTopFiveProducts(topProducts) {
											const $wrap = $('#topfiveProducts');

											if (!Array.isArray(topProducts) || topProducts.length === 0) {
											$wrap.html('<div class="col-12 text-muted">No top products found.</div>');
											return;
											}

											const html = topProducts.slice(0, 5).map(p => {
											const price =
												(p.CurrentPrice ?? p.PromotionPrice ?? p.SalesPrice ?? p.RetailPrice ?? 0);
											const priceText = Number(price).toLocaleString(undefined, {
												minimumFractionDigits: 2,
												maximumFractionDigits: 2
											});

											return `
												<div class="col-md-3 mb-3">
												<div class="card card-body text-center p-2 h-100" style="cursor: pointer;" data-variant-id="${p.VariantId}">
													<h6 class="font-weight-semibold mb-0">${escapeHtml(p.ProductName ?? 'Unnamed')}</h6>
													<span class="text-muted">$${priceText}</span>
												</div>
												</div>`;
											}).join('');

											$wrap.html(html);
								}

							function renderAllProducts(allProducts) {
							  const $tbody = $('#searchResultTable tbody');

							  if (!Array.isArray(allProducts) || allProducts.length === 0) {
								$tbody.html('<tr><td colspan="5" class="text-muted text-center">No products found.</td></tr>');
								return;
							  }

							  const rows = allProducts.map(p => {
								const stock = p.QoH ?? 0; // quantity on hand
								const price = p.CurrentPrice ?? p.PromotionPrice ?? p.SalesPrice ?? p.RetailPrice ?? 0;
								const priceText = Number(price).toLocaleString(undefined, {
								  minimumFractionDigits: 2,
								  maximumFractionDigits: 2
								});

								// Stock level color
								let stockClass = 'text-success';
								if (stock === 0) stockClass = 'text-danger';
								else if (stock < 20) stockClass = 'text-warning';

								// Add/Out button
								const buttonHtml = stock > 0
								  ? `<button class="btn btn-primary btn-sm" data-variant-id="${p.VariantId}">Add</button>`
								  : `<button class="btn btn-light btn-sm" disabled>Out</button>`;

								return `
								  <tr>
									<td><div class="font-weight-semibold">${escapeHtml(p.ProductName ?? 'Unnamed')}</div></td>
									<td>${escapeHtml(p.BarCode ?? '')}</td>
									<td class="text-center ${stockClass} font-weight-bold">${stock}</td>
									<td class="text-right">$${priceText}</td>
									<td class="text-center">${buttonHtml}</td>
								  </tr>
								`;
							  }).join('');

							  $tbody.html(rows);
							}

								function escapeHtml(str) {
									return String(str).replace(/[&<>"'`=\/]/g, s =>
									({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;','/':'&#x2F;','`':'&#x60;','=':'&#x3D;'}[s])
									);
								}
							
								$(document).on('click', '#backbtn', async function () {
									var departments = await Utility.RequestDataAjax({url:'/AttributeManager/GetDepartments'})
									var html = '';
										if (departments && departments.length > 0) {
										departments.forEach(function (cat) {
											html += `<button type="button" class="btn btn-light depBtn" data-depid="${cat.DepartmentId}">
														${cat.DepartmentName}
											</button>`;
										});
									} else {
										html = '<p>No Departments found.</p>';
									}
									// Replace department buttons with category buttons
									$('#dcs').html(html);
								});
						</script>
						
