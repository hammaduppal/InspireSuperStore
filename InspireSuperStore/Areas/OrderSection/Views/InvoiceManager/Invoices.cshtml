@using MainModels.DTOModels
@using MainModels.Util
@model PagesViewModel
@{
	ViewData["Title"] = "Invoices";
	Layout = "~/Views/Shared/_Layout.cshtml";
	int count = 1;
}
<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>

				<span class="breadcrumb-item active">Sale Invoices</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>

<!-- Content area -->
<div class="content">


	<div class="card shadow-5">
		<div class="card-header header-elements-inline">
			<h5 class="card-title">Sale Invoices</h5>
			<div class="header-elements">

				<div class="header-elements d-none">
					<div class="d-flex justify-content-center">
						<a id="addOrders" href="/InvoiceManager/CreateInvoice" class="btn btn-success ">Add Invoice</a>

					</div>
				</div>
			</div>
		</div>

		<div class="table-responsive">
			<table id="invoiceTable" class="table">
				<thead>
					<tr>
						<th>#</th>
						<th>Customer Name</th>

						<th>Invoice Source</th>
						<th>Payment Status</th>
						<th>Payment Method</th>
						<th>Invoice Status</th>
						@if (AppDataUtility.SystemPreferences.EnableTax)
						{
							<th>Total Tax</th>

						}

						<th>Grand Total</th>
						<th>Invoice Date</th>

						<th>Manage</th>


					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model.Invoices)
					{
						if (item.PaymentStatusId==1)
						{
							<tr class="table-success">
								<td>@count</td>
								<td>@item?.Customer?.FirstName @item?.Customer?.LastName</td>
								<td>@item?.InvoiceSource?.SourceName</td>
								<td>@item?.PaymentStatus?.Name</td>

								<td>@item?.PaymentMethod.Name</td>
								<td>
									<select data-ordermasterid="@item?.InvoiceMasterId" id="orderStatusId" class="form-control" name="OrderStatusId">
										@foreach (AppConstants.PaymentStatus status in Enum.GetValues(typeof(AppConstants.PaymentStatus)))
										{
											<option value="@((int)status)" @(item?.PaymentStatusId == (int)status ? "selected" : "")>
												@status.ToString()
											</option>
										}
									</select>
								</td>

								@if (AppDataUtility.SystemPreferences.EnableTax)
								{
									<td>@item?.TotalTax</td>

								}
								<td>@item?.GrandTotal.ToString("N2")</td>

								<td>@TimeHelper.GetFormattedTimeSpan(item.CreatedDate)</td>
								<td>

									<div class="list-icons">
										<a href="/PosManager/Order/@item.InvoiceMasterId" class="list-icons-item text-primary-600"><i class="icon-pencil7"></i></a> &nbsp;
										@if (item.PaymentStatusId == 5)
										{
											<a class="list-icons-item text-danger "><i class="icon-trash"></i></a>
										}
										else
										{
											<a href="/InvoiceManager/CancelInvoice" data-invoiceId="@item.InvoiceMasterId" class="list-icons-item text-danger cancelInvoice"><i class="icon-trash "></i></a>
										}
										&nbsp;
										<a href="#" class="list-icons-item text-success-600 printInvoice" data-invoiceId="@item.InvoiceMasterId"><i class="icon-printer"></i></a>


									</div>

								</td>
							</tr>

						}
						else if(item.PaymentStatusId==2)
						{
							<tr class="table-warning">
								<td>@count</td>
								<td>@item?.Customer?.FirstName @item?.Customer?.LastName</td>
								<td>@item?.InvoiceSource?.SourceName</td>
								<td>@item?.PaymentStatus?.Name</td>

								<td>@item?.PaymentMethod.Name</td>
								<td>
									<select data-ordermasterid="@item?.InvoiceMasterId" id="orderStatusId" class="form-control" name="OrderStatusId">
										@foreach (AppConstants.PaymentStatus status in Enum.GetValues(typeof(AppConstants.PaymentStatus)))
										{
											<option value="@((int)status)" @(item?.PaymentStatusId == (int)status ? "selected" : "")>
												@status.ToString()
											</option>
										}
									</select>
								</td>

								@if (AppDataUtility.SystemPreferences.EnableTax)
								{
									<td>@item?.TotalTax</td>

								}
								<td>@item?.GrandTotal.ToString("N2")</td>

								<td>@TimeHelper.GetFormattedTimeSpan(item.CreatedDate)</td>
								<td>

									<div class="list-icons">
										<a href="/PosManager/Order/@item.InvoiceMasterId" class="list-icons-item text-primary-600"><i class="icon-pencil7"></i></a> &nbsp;
										@if (item.PaymentStatusId == 5)
										{
											<a class="list-icons-item text-danger "><i class="icon-trash"></i></a>
										}
										else
										{
											<a href="/InvoiceManager/CancelInvoice" data-invoiceId="@item.InvoiceMasterId" class="list-icons-item text-danger cancelInvoice"><i class="icon-trash "></i></a>
										}
										&nbsp;
										<a href="#" class="list-icons-item text-success-600 printInvoice" data-invoiceId="@item.InvoiceMasterId"><i class="icon-printer"></i></a>


									</div>

								</td>
							</tr>

						}
						else if(item.PaymentStatusId==3)
						{
							<tr class="table-success">
								<td>@count</td>
								<td>@item?.Customer?.FirstName @item?.Customer?.LastName</td>
								<td>@item?.InvoiceSource?.SourceName</td>
								<td>@item?.PaymentStatus?.Name</td>

								<td>@item?.PaymentMethod.Name</td>
								<td>
									<select data-ordermasterid="@item?.InvoiceMasterId" id="orderStatusId" class="form-control" name="OrderStatusId">
										@foreach (AppConstants.PaymentStatus status in Enum.GetValues(typeof(AppConstants.PaymentStatus)))
										{
											<option value="@((int)status)" @(item?.PaymentStatusId == (int)status ? "selected" : "")>
												@status.ToString()
											</option>
										}
									</select>
								</td>

								@if (AppDataUtility.SystemPreferences.EnableTax)
								{
									<td>@item?.TotalTax</td>

								}
								<td>@item?.GrandTotal.ToString("N2")</td>

								<td>@TimeHelper.GetFormattedTimeSpan(item.CreatedDate)</td>
								<td>

									<div class="list-icons">
										<a href="/PosManager/Order/@item.InvoiceMasterId" class="list-icons-item text-primary-600"><i class="icon-pencil7"></i></a> &nbsp;
										@if (item.PaymentStatusId == 5)
										{
											<a class="list-icons-item text-danger "><i class="icon-trash"></i></a>
										}
										else
										{
											<a href="/InvoiceManager/CancelInvoice" data-invoiceId="@item.InvoiceMasterId" class="list-icons-item text-danger cancelInvoice"><i class="icon-trash "></i></a>
										}
										&nbsp;
										<a href="#" class="list-icons-item text-success-600 printInvoice" data-invoiceId="@item.InvoiceMasterId"><i class="icon-printer"></i></a>


									</div>

								</td>
							</tr>

						}
						else if(item.PaymentStatusId==5)
						{
							<tr class="table-danger">
								<td>@count</td>
								<td>@item?.Customer?.FirstName @item?.Customer?.LastName</td>
								<td>@item?.InvoiceSource?.SourceName</td>
								<td>@item?.PaymentStatus?.Name</td>

								<td>@item?.PaymentMethod.Name</td>
								<td>
									<select data-ordermasterid="@item?.InvoiceMasterId" id="orderStatusId" class="form-control" name="OrderStatusId">
										@foreach (AppConstants.PaymentStatus status in Enum.GetValues(typeof(AppConstants.PaymentStatus)))
										{
											<option value="@((int)status)" @(item?.PaymentStatusId == (int)status ? "selected" : "")>
												@status.ToString()
											</option>
										}
									</select>
								</td>

								@if (AppDataUtility.SystemPreferences.EnableTax)
								{
									<td>@item?.TotalTax</td>

								}
								<td>@item?.GrandTotal.ToString("N2")</td>

								<td>@TimeHelper.GetFormattedTimeSpan(item.CreatedDate)</td>
								<td>

									<div class="list-icons">
										<a href="/PosManager/Order/@item.InvoiceMasterId" class="list-icons-item text-primary-600"><i class="icon-pencil7"></i></a> &nbsp;
										@if (item.PaymentStatusId == 5)
										{
											<a class="list-icons-item text-danger "><i class="icon-trash"></i></a>
										}
										else
										{
											<a href="/InvoiceManager/CancelInvoice" data-invoiceId="@item.InvoiceMasterId" class="list-icons-item text-danger cancelInvoice"><i class="icon-trash "></i></a>
										}
										&nbsp;
										<a href="#" class="list-icons-item text-success-600 printInvoice" data-invoiceId="@item.InvoiceMasterId"><i class="icon-printer"></i></a>


									</div>

								</td>
							</tr>

						}
					

						
						count++;
					}
				</tbody>
			</table>

		</div>
	</div>


</div>


<!-- /content area -->
<script>
	$(document).ready(function(){

		$('.printInvoice').click(function(e){
			e.preventDefault();
			var invoiceId = $(this).attr('data-invoiceid');
			var payload={
				InvoiceMasterId:invoiceId
			}
				$.ajax({
					url: '/InvoiceManager/GetDuplicateInvoice',
					type: 'POST',
					data: payload,

					xhrFields: {
						responseType: 'blob'  // expecting PDF back
					},
					success: function (data) {
						console.log('Hello Dumpling');

						console.log(data);
						var blob = new Blob([data], { type: "application/pdf" });
						var url = URL.createObjectURL(blob);
						window.open(url, "_blank");
					},
					error: function (xhr, status, error) {
						alert("Error saving invoice: " + error);
					}
				});
		})


		$('.cancelInvoice').click(async function(e){
			e.preventDefault();
			var url= $(this).attr('href');
					var invoiceId = $(this).attr('data-invoiceId');
			Utility.confirmBootBox('Do you Want to Cancel Invoice').then(async function(bootresult){
				if(bootresult){
					
					console.log(url);
					console.log(invoiceId);
					var formData={
						InvoiceMasterId:invoiceId
					}
					var objectDaa={
						url:url,
						data:formData
					}

					const respo = await Utility.RequestDataAjax(objectDaa);
				}else
				{
						console.log("User clicked NO");
						// cancel logic
				}


			});

		});





		$('#orderStatusId').change(async function(){
			var newstatusId = $(this).val();
			var omid = $(this).attr('data-ordermasterid');

			const result = await Utility.RequestDataAjax({
				url:'/OrderManager/UpdateOrderStatus',
				data:{
					OrderStatusId:newstatusId,
					OrderMasterId:omid
				}
			})
			if(result.statusCode==='200')
			{
			Utility.successMessage(result.Message);

			}
			else{
			Utility.failMessage(result.Message);

			}

		});

		window.invoiceTable=new DataTable('#invoiceTable');
	});
</script>
