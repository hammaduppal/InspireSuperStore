@using MainModels.DTOModels
@using MainModels.Util
@model PagesViewModel
@{
	ViewData["Title"] = "Orders";
	Layout = "~/Views/Shared/_Layout.cshtml";
	int count = 1;
}
<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>

				<span class="breadcrumb-item active">Orders</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>

<!-- Content area -->
<div class="content">


	<div class="card shadow-5">
		<div class="card-header header-elements-inline">
			<h5 class="card-title">Orders</h5>
			<div class="header-elements">

				<div class="header-elements d-none">
					<div class="d-flex justify-content-center">
						<a id="addOrders" href="/OrderManager/CreateOrder" class="btn btn-success ">Add Orderss</a>

					</div>
				</div>
			</div>
		</div>


		<div class="table-responsive">
			<table class="table">
				<thead>
					<tr>
						<th>#</th>
						<th>Customer Name</th>

						<th>Order Source</th>
						<th>Payment Status</th>
						<th>Payment Method</th>
						<th>Order Status</th>
						<th>Grand Total</th>
						<th>Order Date</th>

						<th>Parent Id</th>
						<th>Manage</th>


					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model.OrderMaster)
					{

						<tr>
							<td>@count</td>
							<td>@item?.Customer?.FirstName @item?.Customer?.LastName</td>
							<td>@item.OrderSource.SourceName</td>
							<td>@item.PaymentStatus.Name</td>

							<td>@item.PaymentMethod.Name</td>
							<td>
								<select data-ordermasterid="@item.OrderMasterId" id="orderStatusId" class="form-control" name="OrderStatusId">
									@foreach (AppConstants.OrderStatusEnum status in Enum.GetValues(typeof(AppConstants.OrderStatusEnum)))
									{
										<option  value="@( (int)status )" @(item.OrderStatusId == (int)status ? "selected" : "")>
											@status.ToString()
										</option>
									}
								</select>
							</td>


							<td>@item.GrandTotal</td>
							<td>@TimeHelper.GetFormattedTimeSpan(item.CreatedDate.Value)</td>
							<td>@item.ParentOrderId</td>
							<td>

								<div class="list-icons">
									<a href="/PosManager/Order/@item.OrderMasterId" class="list-icons-item text-primary-600"><i class="icon-pencil7"></i></a> &nbsp;
									<a href="#" class="list-icons-item text-danger-600"><i class="icon-trash"></i></a> &nbsp;
									<a href="#" class="list-icons-item text-success-600"><i class="icon-printer"></i></a>


								</div>

							</td>
						</tr>
						count++;
					}
				</tbody>
			</table>

		</div>
	</div>


</div>


<!-- /content area -->
<script>
	$(document).ready(function(){
		$('#orderStatusId').change(async function(){
			var newstatusId = $(this).val();
			var omid = $(this).attr('data-ordermasterid');
	
			const result = await Utility.RequestDataAjax({
				url:'/OrderManager/UpdateOrderStatus',
				data:{
					OrderStatusId:newstatusId,
					OrderMasterId:omid
				}
			})
			if(result.statusCode==='200')
			{
			Utility.successMessage(result.Message);

			}
			else{
			Utility.failMessage(result.Message);

			}

		});
	
	});
</script>