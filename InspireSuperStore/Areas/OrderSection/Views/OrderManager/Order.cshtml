<script>

	$(document).on('click', '#btn-submit-order', function () {
		UpdateOrder();
	});

	function UpdateOrder() {
		const $rows = $('#invoiceTable tbody tr');
		if ($rows.length === 0) {
			alert('Please add at least one product.');
			return;
		}

		const totalAmount = parseFloat($('#totalAmount').text()) || 0;
		const totalTax = parseFloat($('#totalTax').text()) || 0;
		const grandTotal = parseFloat($('#grandTotal').text()) || 0;
		const totalPayable = parseFloat($('#totalPayable').text()) || 0;
		const discount = parseFloat($('#discount').val()) || 0;

		const salesPersonId = $('#salesPerson').val() || null;
		const tableId = $('#servingTable').val() || null;
		const customerId = $('#customer').val() || null;
		const paymentMethodId = $('#paymentMethod').val() || null;
			const orderMasterId = $('#OrderMasterId').val();
			const orderStatusId = $('#orderStatus').val();

		var isRestaurantApp = `@AppDataUtility.SystemPreferences.IsRestaurantApplication.ToString()`.toLowerCase() === "true";
		var isAffilatedInvoice = `@AppDataUtility.SystemPreferences.IsAffilatedInvoice.ToString()`.toLowerCase() === "true";

		if (isAffilatedInvoice && !salesPersonId) {
			alert('Select Sale Person.');
			return;
		}

		if (isRestaurantApp && !tableId) {
			alert('Select Table.');
			return;
		}

		const items = [];
		$rows.each(function () {
			const $tr = $(this);

			const $firstTd = $tr.find('td').first();

			const qty = parseFloat($tr.find('.lineqty').val()) || 0;
			const unitPrice = parseFloat($tr.find('.currentPrice').text()) || 0;
			const taxRate = parseFloat($tr.find('.taxPercent').text()) || 0;
			const taxAmount = parseFloat($tr.find('.taxAmount').text()) || 0;
			const lineTotal = unitPrice * qty;
			const lineTotalWithTax = lineTotal + taxAmount;
			items.push({
				OrderDetailId: $tr.data('orderdetailid') || null, // attach existing ID if available
				ProductId: $firstTd.data('productid'),
				VariantId: $firstTd.data('variantid'),
				Quantity: qty,
				UnitPrice: unitPrice,
				TaxRate: taxRate,
				TaxAmount: taxAmount,
				LineTotal: lineTotal,
				LineTotalWithTax: lineTotalWithTax
			});
		});


		const payload = {
			OrderMasterId:orderMasterId,
			TotalAmount: totalAmount,
			TotalTax: totalTax,
			OrderStatusId:orderStatusId,
			GrandTotal: grandTotal,
			DiscountAmount: discount,
			NetAmount: totalPayable,
			PaymentMethodId: paymentMethodId,
			EmployeeId: salesPersonId,
			ServingTableId: tableId,
			CustomerId: customerId,
			OrderDetails: items
		};
		console.log(payload);
		console.log(items);
		Utility.SpinnerMessage('btn-submit-order');
		$.ajax({
			url: '/OrderManager/UpdateOrder',
			type: 'POST',
			data: payload, // send as JSON
			success: function (data) {
				Utility.StopSpinnerMessage('btn-submit-order');
				if (data.statusCode === "200") {
					Utility.successMessage(data.Message);
				} else {
					Utility.failMessage(data.Message);
				}
				console.log(data);
			},
			error: function (xhr, status, error) {
				Utility.StopSpinnerMessage('btn-submit-order');
				alert("Error saving invoice: " + error);
			}
		});
	}





















