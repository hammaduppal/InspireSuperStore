@using MainModels.DTOModels
@using MainModels.Util
@using static MainModels.DTOModels.AppConstants
@model PagesViewModel
@{
	ViewData["Title"] = "Order";
	Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
				<a href="/Purchase/SaleOrder" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Sale Order</a>

				<span class="breadcrumb-item active">Edit Sales Order</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>
<div class="page-header page-header-light">
	<div class="row">
		<!-- Barcode Input -->
		<div class="col-md-3">
			<div class="input-group">
				<div class="input-group-prepend">
					<span class="input-group-text"><i class="icon-barcode2"></i></span>
				</div>
				<input type="text" id="barCode" name="barCode" class="form-control" autocomplete="off" placeholder="Search BarCode........." />
			</div>
		</div>
		<!-- Manual Search Input -->
		<div class="col-md-3">
			<div class="input-group">
				<div class="input-group-prepend">
					<span class="input-group-text"><i class="icon-search4"></i></span>
				</div>
				<div class="form-group-feedback form-group-feedback-right">
					<select id="productSearch" style="width: 100%" class="form-control"></select>

				</div>
			</div>
		</div>

	</div>


</div>

<div class="content">
	<div class="">
		<style>
			#invoiceSummary * {
				padding-top: 0 !important;
				padding-bottom: 0 !important;
			}
		</style>
		<div class="card" id="invoiceSummary">

			<div class="card-body">
				<style>
					#invoice-section label,
					#invoice-section .form-control {
						margin: 0 !important;
						padding: 2px 4px; /* Optional: tighter spacing */
					}
				</style>

				<div id="invoice-section" class="row">
					<div class="col-lg-3">
						<div class="input-group">

							<select id="customer" class="form-control">
								<option value="@Model?.Order?.Customer?.CustomerId">@Model.Order?.Customer?.FirstName</option>
								@foreach (var item in Model.Customers)
								{
									<option value="@item.CustomerId">@item.Person?.FirstName @item.Person?.LastName @item?.CustomerCode</option>

								}
							</select>

							<div class="input-group-append">
								<button id="addCustomer" class="btn btn-light" type="button"><i class="icon-user-plus"></i></button>
							</div>
						</div>
					</div>
					@if (AppDataUtility.SystemPreferences.IsAffilatedInvoice)
					{
						<div class="col-lg-2">
							<label>Sale Person</label>

							<select id="salesPerson" class="form-control" required>
								<option value="@Model.Order?.Employee?.EmployeeId">@Model.Order?.Employee?.FirstName , @Model.Order?.Employee?.EmployeeCode </option>
								@foreach (var item in Model.Employees)
								{
									<option value="@item?.EmployeeId">@item?.FirstName , @item?.EmployeeCode</option>
								}
							</select>
						</div>
					}

					@if (AppDataUtility.SystemPreferences.IsRestaurantApplication)
					{
						<div class="col-lg-2">
							<label>Serving Table</label>

							<select id="servingTable" class="form-control" required>
								<option value="@Model.Order?.ServingTable?.ServingTableId"> @Model.Order?.ServingTable?.TableName</option>
								@foreach (var item in Model.ServingTables)
								{
									<option value="@item?.ServingTableId">@item?.TableName</option>
								}
							</select>
						</div>
					}

					<div class="col-lg-2  text-center">
						<label>Payment Method</label>
						<select id="paymentMethod" class="form-control">
							<option value="@Model.Order?.PaymentMethod?.PaymentMethodId">@Model.Order?.PaymentMethod?.Name</option>
							@foreach (var item in Model.PaymentMethods)
							{
								<option value="@item?.PaymentMethodId">@item?.Name</option>
							}
						</select>
					</div>

					<div class="col-lg-1 text-center">
						<label>Payment</label>
						<input id="cashReceived" type="text" class="form-control text-center" />
					</div>

					<div class="col-lg-1  text-center">
						<label>Balance</label>
						<input id="balance" type="text" class="form-control text-right" />
					</div>


				</div>

			</div>
		</div>
	</div>

	<!-- Invoice template -->
	<div class="card shadow-5">
		<div class="card-header bg-transparent header-elements-inline">
			<input type="hidden" id="OrderMasterId" value="@Model.Order?.OrderMasterId" />
			<div class="row">
				<div class="col-sm-3">
					<select id="orderStatus" name="status" class="form-control form-control-select2" data-placeholder="Select status">
						@{
							var selectedStatus = Model.Order?.OrderStatusId;
						}
						@foreach (AppConstants.OrderStatusEnum status in Enum.GetValues(typeof(AppConstants.OrderStatusEnum)))
						{
							<option value="@((int)status)" @(selectedStatus == (int)status ? "selected" : "")>
								@status
							</option>
						}
					</select>
				</div>
				<div class="col-sm-3">
					<input type="text" readonly class="form-control" value="" />
				</div>
				<div class="col-sm-3">
					<input type="text" value="@TimeHelper.GetFormattedTimeSpan(Model.Order.CreatedDate.Value)" readonly class="form-control" />
				</div>
				<div class="col-sm-3">
					<select id="purchaseType" name="purchaseType" class="form-control form-control-select2" data-placeholder="Select status" disabled>
						@{
							var selectedType = Model.Order.OrderStatusId;
						}
						@foreach (OrderStatusEnum status in Enum.GetValues(typeof(OrderStatusEnum)))
						{
							<option value="@((int)status)" @(selectedType == (int)status ? "selected" : "")>
								@status
							</option>
						}
					</select>
				</div>
			</div>

			<div class="header-elements">
				<button type="button" class="btn btn-light btn-sm ml-3"><i class="icon-printer mr-2"></i> Print</button>
			</div>
		</div>



		<div class="table-responsive">
			<table id="invoiceTable" class="table table-lg">
				<thead>
					<tr>
						<th class="text-center">BarCode</th>
						<th class="text-center">Description</th>
						<th class="text-center">Color</th>
						<th class="text-center">Size</th>

						<th class="text-center">Qty</th>

						<th class="text-center">Unit Price</th>
						<th class="text-center">Tax%age</th>

						<th class="text-center">Tax Amounnt</th>
						<th class="text-center">Line Total</th>
						<th class="text-center">Manage</th>



					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model.Order.OrderDetails)
					{
						<tr data-orderdetailid="@item.OrderDetailId">
							<td class="text-center"
								data-productId="@item.ProductId"
								data-variantId="@item?.Variant?.VariantId"
								data-barcode="@item?.Variant?.BarCode">
								@item?.Variant?.BarCode
							</td>


							<td class="text-center"
								data-productId="@item.ProductId"
								data-variantId="@item?.Variant?.VariantId"
								data-barcode="@item?.Variant?.BarCode">
								@item?.Variant?.ProductName
								<br />
								<span class="text-muted">@item?.Variant?.BrandName</span>
							</td>

							<td class="text-center">@item?.Variant?.ColorName</td>
							<td class="text-center">@item?.Variant?.SizeName</td>

							<td class="text-center">
								<input class="lineqty text-center"
									   type="number" min="1" step="1"
									   value="@item?.Quantity"
									   style="max-width:50px;" />
							</td>

							<td class="currentPrice text-center">@item?.UnitPrice?.ToString("0.00")</td>
							<td class="taxPercent text-center">@item?.TaxRate?.ToString("0")</td>
							<td class="taxAmount text-center">@item?.TaxAmount?.ToString("0.00")</td>

							<td class="lineTotal text-center">@item?.LineTotalWithTax?.ToString("0.00")</td>

							<td class="text-center">
								<div class="list-icons">
									<a href="#" data-variantId="@item?.VariantId" data-productId="@item?.ProductId"
									   class="list-icons-item text-danger-600 removeRow text-center">
										<i class="icon-trash"></i>
									</a>
								</div>
							</td>
						</tr>
					}
				</tbody>

			</table>
		</div>

		<div class="card-body">
			<div class="d-md-flex flex-md-wrap">
				@* 	<div class="pt-2 mb-3">
					<h6 class="mb-3">Authorized person</h6>
					<div class="mb-3">
						<img src="~/global_assets/images/signature.png" width="150" alt="">
					</div>

					<ul class="list-unstyled text-muted">
						<li>Eugene Kopyov</li>
						<li>2269 Elba Lane</li>
						<li>Paris, France</li>
						<li>888-555-2311</li>
					</ul>
				</div> *@

				<div class="pt-2 mb-3 wmin-md-400 ml-auto">
					<h6 class="mb-3">Total due</h6>
					<div class="table-responsive">
						<table class="table">
							<tbody>
								<tr>
									<th>Total Amount:</th>
									<td class="text-right" id="totalAmount">@Model.Order.TotalAmount</td>
								</tr>
								<tr>
									<th>Total Tax:</th>
									<td class="text-right" id="totalTax">@Model.Order.TaxAmount</td>
								</tr>
								<tr>
									<th>Discount:</th>
									<td class="text-center">
										<input class="form-control" id="discount" type="number" min="0" step="0.01" value="@Model.Order.DiscountAmount" />
									</td>
								</tr>
								<tr>
									<th>Grand Total:</th>
									<td class="text-right text-primary">
										<h5 class="font-weight-semibold" id="grandTotal">@Model.Order.GrandTotal</h5>
									</td>
								</tr>
								<tr>
									<th>Payable:</th>
									<td class="text-right text-success">
										<h5 class="font-weight-semibold" id="totalPayable">@Model.Order.GrandTotal</h5>
									</td>
								</tr>
							</tbody>
						</table>

					</div>
					<div class="btn-group w-100">
						<button id="btn-submit-order" type="button" class="btn btn-success btn-lg" style="flex-grow: 2;">Update Order</button>
						<button id="btn-submit-createInvoice" type="button" class="btn btn-primary btn-lg" style="flex-grow: 2;">Create Invoice</button>
						@if (AppDataUtility.SystemPreferences.IsRestaurantApplication)
						{

						}
						else
						{
							<button id="btn-submit-invoice" type="button" class="btn btn-success btn-lg" style="flex-grow: 2;">PAY</button>

						}
					</div>
				</div>
			</div>
		</div>

		@* 	<div class="card-footer">
			<span class="text-muted">Thank you for using Limitless. This invoice can be paid via PayPal, Bank transfer, Skrill or Payoneer. Payment is due within 30 days from the date of delivery. Late payment is possible, but with with a fee of 10% per month. Company registered in England and Wales #6893003, registered office: 3 Goodman Street, London E1 8BF, United Kingdom. Phone number: 888-555-2311</span>
		</div> *@
	</div>

</div>
