		})

</script>

<script>
	$(document).ready(function(){
		var pstatusId=parseFloat($('#status').val());
			var pmId=$('#OrderMasterId').val();
			enableDisableType(pstatusId);
		function enableDisableType(statusId){

			if(statusId==2	)
			{
					$('#purchaseType').removeAttr('disabled');
			}
			else{
					$('#purchaseType').attr('disabled', 'disabled');
			}
		}
					$(document).on('change','#status',async function(e){
					var id = parseFloat($(this).val());

							$('#purchaseType').removeAttr('disabled');
							if(id==2){
									Utility.confirmBootBox('DO you want to Procced as Sale Order').then(async function(bootResult){
											if (bootResult) {
													const something =  await Utility.RequestDataAjax({
														data:{
																PurchaseType:3,
																Status:2,
															OrderMasterId:pmId},
															url:'/Purchase/POChangeType'
													});
													if(something.statusCode==='200'){
														Utility.successMessage(something.Message);
														window.location.href='/Purchase/SaleOrder';
													}
													else{

													}
											} else {
												console.log("User clicked NO");
											}

									});
							}
							else if(id==3){
									const changePostatus =  await Utility.RequestDataAjax({
														data:{
																PurchaseType:1,
															OrderMasterId:pmId},
															url:'/Purchase/POChangeType'
													});
													if(changePostatus){
														Utility.successMessage('Done');
														window.location.href='/Purchase/SaleOrder';
													}
													else{

													}
							}
							await Utility.RequestDataAjax({
								data:{
									Status:id,
									OrderMasterId:pmId},
								url:'/Purchase/POChangeStatus'
							});
							enableDisableType(id);
				});

				$(document).on('change','#purchaseType',async function(e){
								var id = parseFloat($(this).val());


							await Utility.RequestDataAjax({
								data:{
										PurchaseType:id,
									OrderMasterId:pmId},
									url:'/Purchase/POChangeType'
							});
				});

				$(document).on('change','.qty', async function(e){
					var newQty = $(this).val();
					var pdId = $(this).attr('data-purchaseDetailId');
					if(newQty==0){
						$(this).val(1);
					}
					const updateQtyResult= Utility.RequestDataAjax({
					data:{Qty:newQty,
						OrderMasterId:pmId,
						PurchaseDetailId:pdId
						},
						url:'/Purchase/POChangeQty'

					});
					Utility.successMessage('Result Updated');

					 let $row = $(this).closest('tr');
					 let unitPrice = parseFloat($row.find('.unitPrice').text()) || 0;
					 let lineTotal = newQty * unitPrice;
					$row.find('.lineTotal').text(lineTotal.toFixed(2));
					  let totalAmount = 0;
						$('.lineTotal').each(function () {
							totalAmount += parseFloat($(this).text()) || 0;
						});
						  $('#totalAmount').text(totalAmount.toFixed(2));
						  $('#grandTotal').text(totalAmount.toFixed(2));

				});




	});
</script>
<script>
	$(document).ready(function(){

		$('#barCode').focus();
		  $(document).on('keydown', '#barCode', async function (e) {

			  if (e.key === 'Enter') {
					var barCode= $(this).val();

					 const data = await Utility.RequestDataAjax( {
					  data: { BarCode: barCode },
					  url: '/Products/GetVariantbyBarCode'
				  });

				  if(data){
					appendProductToTable(data);

						$(this).focus();
					$('#barCode').val('');

				  } else
				  {
					alert('Product not found!');
					$(this).val('');

				  }

				}
		  });

		function appendProductToTable(result) {
			if (!result) return;


			let isDuplicate = false;
			let incomingBarcode = String(result.BarCode); // ensure barcode is string

			$('#invoiceTable tbody tr').each(function () {
				const barcode = String($(this).find('td').eq(0).data('barcode')); // barcode stored in first <td>

				if (barcode === incomingBarcode) {
					isDuplicate = true;

					let qtyInput = $(this).find('td').eq(4).find('input');
					let currentQty = parseFloat(qtyInput.val()) || 0;
					let newQty = currentQty + 1;
					qtyInput.val(newQty);

					// Get unit price and tax rate from row
					let unitPrice = parseFloat($(this).find('.currentPrice').text()) || 0;
					let taxRate = parseFloat($(this).find('.taxPercent').text()) || 0;

					// Recalculate
					let lineAmount = unitPrice * newQty;
					let taxAmount = (lineAmount * taxRate) / 100;
					let total = lineAmount + taxAmount;

					// Update row cells
					$(this).find('.taxAmount').text(taxAmount.toFixed(2));
					$(this).find('.lineTotal').text(total.toFixed(2));

					setTotalPrice();
					return false; // break loop
				}
			});

			if (isDuplicate) {
				return; // No need to append new row
			}

		appendRow(result,incomingBarcode);
			setTotalPrice();
		}

			$(document).on('input', '.lineqty', function () {
				let qty = parseFloat($(this).val()) || 0;
				let row = $(this).closest('tr');

				// Get the unit price and tax rate from the row
				let unitPrice = parseFloat(row.find('.currentPrice').text()) || 0;
				let taxRate = parseFloat(row.find('.taxPercent').text()) || 0;

				// Calculate amounts
				let lineTotal = unitPrice * qty;
				let taxAmount = (lineTotal * taxRate) / 100;
				let lineTotalWithTax = lineTotal + taxAmount;

				// Update UI
				row.find('.taxAmount').text(taxAmount.toFixed(2));
				row.find('.lineTotal').text(lineTotal.toFixed(2));
				row.find('.lineTotalWithTax').text(lineTotalWithTax.toFixed(2));

				// Update overall invoice total
				setTotalPrice();
			});

		$(document).on('input','#discount',function(){
			setTotalPrice();
		})




		$('#productSearch').select2({
			placeholder: 'Search product by name, size, color, material...',
			minimumInputLength: 2,
			ajax: {
				url: '/Products/SearchProducts',
				type: 'POST',
				dataType: 'json',
				delay: 300,
				data: function (params) {
					return {
						SearchParams: params.term
					};
				},
				processResults: function (data) {
					// Expected: [{id, text, fullProductObject}]
					return {
						results: data.map(function (item) {
							return {
								id: item.BarCode, // or item.id
								text: `${item.ProductName} - ${item.SizeName || ''} ${item.ColorName || ''} ${item.MaterialName || ''}`,
								fullData: item
							};
						})
					};
				},
				cache: true
			},
			templateResult: formatProductResult,
			templateSelection: formatProductSelection
		});

		// On select, append to table
		$('#productSearch').on('select2:select', function (e) {
			const data = e.params.data;
			appendProductToTable(data.fullData);
			// Optionally clear
			$(this).val(null).trigger('change');
		});

		function formatProductResult(data) {
			if (data.loading) return data.text;
			return $(`<div>
				<strong>${data.text}</strong><br/>
				<small>Price: ${data.fullData?.RetailPrice || 'N/A'}</small>
			</div>`);
		}


		$(document).on('click','.removeRow',function(e){
			e.preventDefault();
				$(this).closest('tr').remove();
				setTotalPrice();
		})



		function formatProductSelection(data) {
			return data.text;
		}

		function appendRow(result, incomingBarcode) {
		// -----------------------------
		// Variables & calculations
		// -----------------------------
		let unitPrice = parseFloat(result.CurrentPrice) || 0;
		let taxRate = parseFloat(result.TaxRate) || 0;
		let qty = 1; // default for new row

		let lineAmount = unitPrice * qty;
		let taxAmount = (lineAmount * taxRate) / 100;
		let total = lineAmount + taxAmount;

		// Server-side flag injected into JS
		let enableTax = @AppDataUtility.SystemPreferences.EnableTax.ToString().ToLower();
		// true / false

		let row = "";

		// -----------------------------
		// HTML structure
		// -----------------------------
		if (enableTax) {
			// With tax columns
			row = `
				<tr  data-orderdetailid="">
									<td class="text-center" data-productId="${result.ProductId}" data-barcode="${incomingBarcode}" data-variantId="${result.VariantId}">
						${result.BarCode}
					</td>
					<td data-productId="${result.ProductId}" class="text-center" data-barcode="${incomingBarcode}" data-variantId="${result.VariantId}">
						${result.ProductName}
					</td>
					<td class="text-center">${result.ColorName}</td>

					<td class="text-center">${result.SizeName}</td>
					<td class="text-center">
						<input class='lineqty text-center' type='number' min='1' step='1' value='${qty}' style='max-width:50px;'/>
					</td>
					<td class='currentPrice text-center'>${unitPrice.toFixed(2)}</td>
					<td class='taxPercent text-center'>${taxRate.toFixed(2)}</td>
					<td class='taxAmount text-center'>${taxAmount.toFixed(2)}</td>
					<td class='lineTotal text-center'>${total.toFixed(2)}</td>
					<td class="text-center">
						<div class="list-icons">
							<a href="#" data-variantId="${result.VariantId}" data-productId="${result.ProductId}"
							   class="list-icons-item text-danger-600 removeRow text-center">
							   <i class="icon-trash"></i>
							</a>
						</div>
					</td>
				</tr>`;
		} else {
			// Without tax columns
			row = `
				<tr>
					<td data-productId="${result.ProductId}" data-barcode="${incomingBarcode}" data-variantId="${result.VariantId}">
						${result.ProductName}
					</td>
					<td class="text-center">${result.SizeName}</td>
					<td class="text-center">
						<input class='lineqty text-center' type='number' min='1' step='1' value='${qty}' style='max-width:50px;'/>
					</td>
					<td class='currentPrice text-right'>${unitPrice.toFixed(2)}</td>
					<td class='lineTotal text-right'>${lineAmount.toFixed(2)}</td>
					<td class="text-center">
						<div class="list-icons">
							<a href="#" data-variantId="${result.VariantId}" data-productId="${result.ProductId}"
							   class="list-icons-item text-danger-600 removeRow text-center">
							   <i class="icon-trash"></i>
							</a>
						</div>
					</td>
				</tr>`;
		}

		// -----------------------------
		// Append row
		// -----------------------------
		$('#invoiceTable tbody').append(row);
	}


		function setTotalPrice() {
		let totalAmount = 0;
		let totalTax = 0;

		$('#invoiceTable tbody tr').each(function () {
			let qty = parseFloat($(this).find('.lineqty').val()) || 0;
			let unitPrice = parseFloat($(this).find('.currentPrice').text()) || 0;
			let taxRate = parseFloat($(this).find('.taxPercent').text()) || 0;

			let lineTotal = unitPrice * qty;
			let taxAmount = (lineTotal * taxRate) / 100;

			totalAmount += lineTotal;
			totalTax += taxAmount;
		});

		let grandTotal = totalAmount + totalTax;

		// discount (allow numeric input, default 0)
		let discount = parseFloat($('#discount').val()) || 0;
		if (discount > grandTotal) discount = grandTotal; // prevent negative payable

		let payable = grandTotal - discount;

		// Update UI (use text for <td>, val for <input>)
		$('#totalAmount').text(totalAmount.toFixed(2));
		$('#totalTax').text(totalTax.toFixed(2));
		$('#grandTotal').text(grandTotal.toFixed(2));
		$('#totalPayable').text(payable.toFixed(2));
	}


		$(document).on('input', '#cashReceived', function () {
			let payable = parseFloat($('#totalPayable').val()) || 0;
			let cashRecived = parseFloat($(this).val());
			// Get the unit price from the currentPrice td
			let balance =cashRecived - payable || 0;
			balance = Math.floor(balance);
			$('#balance').val(balance);
		});

	})
</script>
