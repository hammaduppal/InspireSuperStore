@using MainModels.DTOModels
@using MainModels.Util
@model PagesViewModel
@{
	ViewData["Title"] = "EditProduct";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>

				<a href="/Products/Products" class="breadcrumb-item"><i class="icon-database mr-2"></i> Products</a>
				<span class="breadcrumb-item active">Edit Product</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>

<!-- Content area -->
<div class="content">
	<input type="hidden" value="@Model.Product.ProductId" id="productId" />


	<!-- Badges -->
	<div class="row">

		<div class="col-md-12">
			<div class="card shadow-5">


				<div class="card-body">
					<ul class="nav nav-pills nav-justified">
						<li id="productDescTab" class="nav-item"><a href="#productPill" class="nav-link active" data-toggle="tab">ProductDetails  </a></li>
						@if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin, UserRolesConstants.Product, UserRolesConstants.PowerUser, UserRolesConstants.Purchase))
						{
							<li id="imageTab" class="nav-item"><a href="#imagePill" data-value="@Model.Product.ProductId" class="nav-link" data-toggle="tab">Images </a></li>
							<li data-uomId="@Model.Product.UOMId" id="variantsTab" class="nav-item"><a href="#variantPill" class="nav-link" data-toggle="tab">Variants </a></li>

						}
					</ul>

					<div class="tab-content">
						<div class="tab-pane fade show active" id="productPill">
							<div class="row">
								<div class="col-lg-8">
									<div class="row">
										<div class="col-md-12">

											<form id="descForm">

												<fieldset>

													<div class="form-group">
														<label>Product Name</label>
														<input id="productName" type="text" class="form-control" value="@Model.Product.ProductName" placeholder="Enter Product Name" required />
													</div>

													<div class="form-group">
														<label>Product Description</label>

														<button id="regenerate"><i class="icon-reload-alt"></i></button>
														<textarea id="description" class="form-control" placeholder="Product Description" required> @Model.Product.ProductDescription</textarea>
													</div>
													<div class="form-group">
														<label>Additional Information</label>
														<button id="addInfo"><i class="icon-reload-alt"></i></button>

														<textarea id="additionalInformation" class="form-control" placeholder="Product Description" required> @Model.Product.AdditionalInformation</textarea>
													</div>

													<div class="row">
														<div class="col-md-11">
														</div>
														<div class="col-md-1">
															<a id="unlockbtn" href="/Unlock"> <i class="icon-file-locked"></i></a>

														</div>
													</div>


													<div class="row">



														<div class="col-md-6">
															<div class="form-group">
																<label>Department Name</label>
																<select disabled id="dep" data-placeholder="Enter 'as'" class="form-control select-minimum" data-fouc>
																	<option>@Model.Product.DepartmentName</option>
																	<optgroup label="Departments">
																		@foreach (var item in Model.Departments)
																		{
																			<option value="@item.DepartmentId">@item.DepartmentName</option>
																		}
																	</optgroup>
																</select>


															</div>
														</div>

														<div class="col-md-6">
															<div class="form-group">
																<label>Category Name</label>
																<select disabled id="cat" data-placeholder="Enter 'cat'" class="form-control select-minimum" data-fouc>
																	<option>@Model.Product.CategoryName</option>
																	<optgroup label="Categories">

																	</optgroup>
																</select>
															</div>
														</div>
													</div>
													<div class="row">
														<div class="col-md-6">
															<div class="form-group">
																<label>SubCategory Name</label>
																<select disabled id="subcat" data-placeholder="Enter 'sub cat'" class="form-control select-minimum" data-fouc>
																	<option value="@Model.Product.SubCategoryId">@Model.Product.SubCategoryName</option>
																	<optgroup label="SUB Categories">

																	</optgroup>
																</select>
															</div>
														</div>

														<div class="col-md-6">
															<div class="form-group">
																<label>UOM Name</label>
																<select disabled id="uom" data-placeholder="Enter 'cat'" class="form-control select-minimum" data-fouc>

																	<option value="@Model.Product.UOMId">@Model.Product.UOMName</option>
																	<optgroup label="UOM">
																		@foreach (var item in Model.UOMs)
																		{
																			<option value="@item.Uomid">@item.UOMName</option>
																		}
																	</optgroup>
																</select>
															</div>
														</div>
														<div class="col-md-6">
															<div class="form-group">
																<label>Brand Name</label>
																<select disabled id="brand" data-placeholder="Enter 'cat'" class="form-control select-minimum" data-fouc>
																	<option value="@Model.Product.BrandId">@Model.Product.BrandName</option>
																	<optgroup label="Brands">
																		@foreach (var item in Model.Brands)
																		{
																			<option value="@item.BrandId">@item.BrandName</option>
																		}
																	</optgroup>
																</select>
															</div>
														</div>
														<div class="col-md-6">
															<div class="form-group">
																<label>Brand Model</label>
																<select disabled id="brandModel" data-placeholder="Enter 'Brand Model'" class="form-control select-minimum" data-fouc>
																	<option value="@Model.Product.BrandModelId">@Model.Product.ModelName</option>

																	<optgroup label="Brand Models">

																	</optgroup>
																</select>
															</div>
														</div>
													</div>
												</fieldset>
												<div>
													<button id="descFormSubmitBtn" class="btn btn-success" type="submit">Update</button>
												</div>
											</form>



										</div>


									</div>
								</div>
								<div class="col-lg-4">


									<div class="card-img-actions px-5 pt-1">
										<img class="card-img fixed-image img-fluid" src="@PagesViewModel.SystemSettings.ContentAPIUrl/@Model?.Product?.ImageUrl" alt="">

									</div>



								</div>

							</div>


						</div>

						<div class="tab-pane fade" id="imagePill">
						</div>

						<div class="tab-pane fade" id="variantPill">
						</div>


					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- /badges -->


</div>
<script>

</script>
<!-- /content area -->
<script>
	$(document).ready(function(){
			 $('#description').summernote();
			 $('#additionalInformation').summernote();


			 
			 $('#regenerate').click(async function(e){
				 e.preventDefault();
				 var productName = $('#productName').val();
				 Utility.SpinnerMessage('regenerate');
				 var objectData={
					 url:'/Products/CreateDescriptionPrompt',
					 data:{
						 ProductName:productName
					 }
				 }
				 Utility.StopSpinnerMessage('regenerate');
				 const result = await Utility.RequestDataAjax(objectData);
				 $('#description').summernote('code', result.Prompt);
			 });
			
			 $('#addInfo').click(async function(e){
				 e.preventDefault();
				 Utility.SpinnerMessage('addInfo');

				 var productName = $('#productName').val();
				 var objectData={
					 url:'/Products/CreateAdditionalInformation',
					 data:{
						 ProductName:productName
					 }
				 }
				 Utility.StopSpinnerMessage('addInfo');

				 const result = await Utility.RequestDataAjax(objectData);
				 $('#additionalInformation').summernote('code', result.Prompt);
			 });
	});
	$('#productDescTab').click(function(){
		location.reload();
	})
	$('#unlockbtn').click(function(e){
		e.preventDefault();
		$('#modal-unlock').modal();
		//alert('calling Unclock');
	});

	$('#unlockForm').submit(async function(e){
		e.preventDefault();

		var formData={
			UnlockKey: encrypt($('#unlockPassword').val())
		}
		var objectData={
			data:formData,
			url:'/Account/DecryptSomeThing'
		}
		const result = await Utility.RequestDataAjax(objectData);
		if(result.statusCode==='200'){
			$('#dep, #cat, #subcat,#uom,#brand,#brandModel').removeAttr('disabled');
			$('#modal-unlock').modal('hide');
					 Utility.successMessage(result.Message);

		}
		else{
				 Utility.failMessage(result.Message);
		}
		console.log(formData);


	});
	$(document).ready(function(e){
			var id= `@Model.Product.ProductId`;
			$('#descForm').submit(async function(e){
					e.preventDefault();
					var desc = $('#description').summernote();
					var addInfo = $('#additionalInformation').summernote();


					Utility.SpinnerMessageParent('descFormSubmitBtn','Loading..');
					var formData = {
					ProductName: $('#productName').val(),
					ProductDescription:desc.summernote('code'),
					AdditionalInformation:addInfo.summernote('code'),
					ProductId:id,
					SubCategoryId: $('#subcat').val(),
					UOMId: $('#uom').val(),
					BrandId: $('#brand').val(),
					BrandModelId:$('#brandModel').val()
				 };
				 var objectData={
					 data:formData,
					 url:'/Products/UpdateDescriptionSection'
				 }
				 const result = await Utility.RequestDataAjax(objectData);
				 Utility.StopSpinnerMessageParent('descFormSubmitBtn');
				 if(result.statusCode==='200')
				 {
					 Utility.successMessage(result.Message);
				 }
				 else{
					 Utility.failMessage(result.Message);
				 }
			   console.log(formData);
			});
				$('#dep').change(async function(e){


					var depId = $(this).val();
						var formData={
							DepartmentId :depId
						}
						var objectData={
							data:formData,
							url:'/AttributeManager/GetCategorybyDepartment'
						}
						const result = await Utility.RequestDataAjax(objectData);

							$('#cat').empty();
							$('#subcat').empty();
							$('#cat').append(`<option>Select Category</option>`);
								  result.forEach(function(cat) {
										$('#cat').append(`<option value="${cat.CategoryId}">${cat.CategoryName}</option>`);
								  });



				});

				$('#cat').change(async function(e){


					var catid = $(this).val();
						var formData={
							CategoryId :catid
						}
						var objectData={
							data:formData,
							url:'/AttributeManager/GetSubCategorybyCategory'
						}
						const result = await Utility.RequestDataAjax(objectData);

							$('#subcat').empty();
							$('#subcat').append(`<option>Select Sub Category</option>`);
								  result.forEach(function(subcat) {
										$('#subcat').append(`<option value="${subcat.SubCategoryId}">${subcat.SubCategoryName}</option>`);
								  });



				});

				$('#brand').change(async function () {
		var brandId = $(this).val();

		// Always clear the dropdown first
		$('#brandModel').empty();
		$('#brandModel').append('<option value="">Select Model</option>');

		if (!brandId) return; // Stop if no brand is selected

		var formData = { BrandId: brandId };
		var objectData = {
			data: formData,
			url: '/AttributeManager/BrandModel'
		};

		try {
			var result = await Utility.RequestDataAjax(objectData);

			if (result && result.length > 0) {
				$.each(result, function (i, item) {
					$('#brandModel').append(
						`<option value="${item.BrandModelId}">${item.ModelName}</option>`
					);
				});
			} else {
				$('#brandModel').append('<option value="">No models found</option>');
			}
		} catch (error) {
			console.error('Error loading brand models:', error);
			$('#brandModel').append('<option value="">Error loading models</option>');
		}
	});



				//CategoryId: $('#cat').val(),
			$('#variantsTab').click(async function(){
				var uomId = $(this).attr('data-uomid')

				var formData={
					ProductId:id,
					UOMId:uomId
				}
				var objectData={
					data:formData,
					url:'/Products/_GetProductVariants'
				}
				const variantResult = await Utility.RequestDataAjax(objectData);
				$('#variantPill').html(variantResult);
			});

		$('#imageTab').click(function(){

		var formData={
			ProductId:id
		}
		$.ajax({
			url:'/Products/_GetProductImages',
			data:formData,
			type:'POST',
			success:function(result){
				$('#imagePill').html(result);
			}
		})
		})


	})
	 function LoadImageTab(){
		 var id= `@Model.Product.ProductId`;
			 var formData={
				ProductId:id
				}
				$.ajax({
				url:'/Products/_GetProductImages',
				data:formData,
				type:'POST',
				success:function(result){
					console.log(result);
					$('#imagePill').html(result);
				}
			})
	 }

	 function LoadVariantTab(){
		 var id= `@Model.Product.ProductId`;
			 var formData={
				ProductId:id
				}
				$.ajax({
				url:'/Products/_GetProductVariants',
				data:formData,
				type:'POST',
				success:function(result){
					console.log(result);
					$('#variantPill').html(result);
				}
			})
	 }

</script>