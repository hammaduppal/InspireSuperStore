@using MainModels.DTOModels
@model PagesViewModel
@{
	ViewData["Title"] = "EditProduct";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/Products" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Products</a>
				<span class="breadcrumb-item active">Edit Product</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>

<!-- Content area -->
<div class="content">
	<input type="hidden" value="@Model.Product.ProductId" id="productId" />


	<!-- Badges -->
	<div class="row">

		<div class="col-md-12">
			<div class="card shadow-5">
			

				<div class="card-body">
					<ul class="nav nav-pills nav-justified">
						<li class="nav-item"><a href="#justified-badge-pill1" class="nav-link active" data-toggle="tab">ProductDetails  </a></li>
						<li id="imageTab" class="nav-item"><a href="#imagePill" data-value="@Model.Product.ProductId" class="nav-link" data-toggle="tab">Images </a></li>
						<li data-uomId="@Model.Product.UOMId" id="variantsTab" class="nav-item"><a href="#variantPill" class="nav-link" data-toggle="tab">Variants </a></li>

						<li class="nav-item dropdown">
							<a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">Other Settings</a>
							<div class="dropdown-menu dropdown-menu-right">
								<a href="#justified-badge-pill4" class="dropdown-item" data-toggle="tab">Dropdown pill</a>
								<a href="#justified-badge-pill5" class="dropdown-item" data-toggle="tab">Another pill</a>
							</div>
						</li>
					</ul>

					<div class="tab-content">
						<div class="tab-pane fade show active" id="justified-badge-pill1">
							<div class="row">
								<div class="col-lg-8">
									<div class="row">
										<div class="col-md-12">
											<fieldset>
												<legend class="font-weight-semibold"><i class="icon-home "></i> Product details</legend>

												<div class="form-group">
													<label>Product Name</label>
													<input id="productName" type="text" class="form-control" value="@Model.Product.ProductName" placeholder="Enter Product Name" required />
												</div>

												<div class="form-group">
													<label>Product Description</label>
													<textarea id="description" class="form-control" placeholder="Product Description" required> @Model.Product.ProductDescription</textarea>
												</div>
												<div class="row">
													<div class="col-md-6">
														<div class="form-group">
															<label>Department Name</label>
															<input id="dep" type="text" class="form-control" value="@Model.Product.DepartmentName" readonly placeholder="Enter Product Name" required />

														</div>
													</div>

													<div class="col-md-6">
														<div class="form-group">
															<label>Category Name</label>
															<input id="cat" type="text" class="form-control" value="@Model.Product.CategoryName" readonly placeholder="Enter Product Name" required />

														</div>
													</div>
												</div>
												<div class="row">
													<div class="col-md-6">
														<div class="form-group">
															<label>SubCategory Name</label>
															<input id="subcat" type="text" class="form-control" value="@Model.Product.SubCategoryName" readonly placeholder="Enter Product Name" required />

														</div>
													</div>

													<div class="col-md-6">
														<div class="form-group">
															<label>UOM Name</label>
															<input id="uom" type="text" class="form-control" value="@Model.Product.UOMName" readonly placeholder="Enter Product Name" required />

														</div>
													</div>
												</div>
											

											

											</fieldset>
										</div>


									</div>
								</div>
								<div class="col-lg-4">
									
									
											<div class="card-img-actions px-5 pt-1">
										<img class="card-img fixed-image img-fluid" src="@PagesViewModel.SystemSettings.ContentAPIUrl/@Model?.Product?.ImageUrl" alt="">
												
											</div>

									
									
								</div>

							</div>


						</div>

						<div class="tab-pane fade" id="imagePill">
							Food truck fixie locavore, accusamus mcsweeney's marfa nulla single-origin coffee squid laeggin.
						</div>

						<div class="tab-pane fade" id="variantPill">
							DIY synth PBR banksy irony. Leggings gentrify squid 8-bit cred pitchfork. Williamsburg whatever.
						</div>

						<div class="tab-pane fade" id="justified-badge-pill4">
							Aliquip jean shorts ullamco ad vinyl cillum PBR. Homo nostrud organic, assumenda labore aesthet.
						</div>
						<div class="tab-pane fade" id="justified-badge-pill5">
							Aliquip jean shorts ullamco ad vinyl cillum PBR. Homo nostrud organic, assumenda labore aesthet.
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- /badges -->


</div>
<!-- /content area -->
<script>
	$(document).ready(function(e){
			var id= `@Model.Product.ProductId`;
			$('#variantsTab').click(async function(){
				var uomId = $(this).attr('data-uomid')
				
				var formData={
					ProductId:id,
					UOMId:uomId
				}
				var objectData={
					data:formData,
					url:'/Products/_GetProductVariants'
				}
				const variantResult = await Utility.RequestDataAjax(objectData);
				$('#variantPill').html(variantResult);
			});

		$('#imageTab').click(function(){
			
		var formData={
			ProductId:id
		}
		$.ajax({
			url:'/Products/_GetProductImages',
			data:formData,
			type:'POST',
			success:function(result){
				$('#imagePill').html(result);
			}
		})
		})

		
	})
	 function LoadImageTab(){
		 var id= `@Model.Product.ProductId`;
			 var formData={
				ProductId:id
				}
				$.ajax({
				url:'/Products/_GetProductImages',
				data:formData,
				type:'POST',
				success:function(result){
					console.log(result);
					$('#imagePill').html(result);
				}
			})
	 }

	 function LoadVariantTab(){
		 var id= `@Model.Product.ProductId`;
			 var formData={
				ProductId:id
				}
				$.ajax({
				url:'/Products/_GetProductVariants',
				data:formData,
				type:'POST',
				success:function(result){
					console.log(result);
					$('#variantPill').html(result);
				}
			})
	 }

</script>