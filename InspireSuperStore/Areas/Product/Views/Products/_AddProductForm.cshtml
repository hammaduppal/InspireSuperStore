@using MainModels.DTOModels
@model PagesViewModel
<div class="card">


	<div class="card-body">
		<form id="addProduct" action="#">
			<div class="row">
				<div class="col-md-12">
					<fieldset>
						<legend class="font-weight-semibold"><i class="icon-home "></i> Product details</legend>

						<div class="form-group">
							<label>Product Name</label>
							<input id="productName" type="text" class="form-control" placeholder="Enter Product Name" required />
						</div>

						<div class="form-group">
							<label>Product Description</label>
							<textarea id="description" class="form-control" placeholder="Product Description" required></textarea>
						</div>


						<div class="form-group">
							<div class="input-group">
								<select id="dep" class="form-control" required>
									<option value=""> Select Department</option>
									@foreach (var item in Model.Departments)
									{
										<option value="@item.DepartmentId	">@item.DepartmentName </option>

									}
								</select>
								<div class="input-group-append">
									<a id="" href="/AttributeManager/_GetAddDepartmentForm" class="btn btn-light adddcs"><i class="icon-database-add mr-1"></i></a>
									<a id="" href="/AttributeManager/GetDepartments" data-selectName="dep" class="btn btn-light refreshdcs"><i class="icon-database-refresh  mr-1"></i></a>



								</div>
							</div>
						</div>
						<div class="form-group">
							<div class="input-group">
								<select id="cat" class="form-control" required>
									<option value=""> Select Category</option>

								</select>

								<div class="input-group-append">
									<a id="" href="/AttributeManager/_GetAddCategoryForm" class="btn btn-light adddcs"><i class="icon-database-add mr-1"></i></a>
									<a id="" href="/AttributeManager/GetCategorybyDepartment" data-selectName="cat" class="btn btn-light refreshdcs"><i class="icon-database-refresh  mr-1"></i></a>



								</div>
							</div>
						</div>

						<div class="form-group">
							<div class="input-group">
								<select id="subcat" class="form-control" required="required">
									<option value=""> Select SubCategory</option>
								</select>
								<div class="input-group-append">
									<a id="" href="/AttributeManager/_GetAddSubCategoryForm" class="btn btn-light adddcs"><i class="icon-database-add mr-1"></i></a>
									<a id="" href="/AttributeManager/GetSubCategorybyCategory" data-selectName="subcat" class="btn btn-light refreshdcs"><i class="icon-database-refresh  mr-1"></i></a>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-md-6">
								<div class="form-group">
									<div class="input-group">
										<select id="uom" class="form-control" required>
											<option value=""> Select Uom</option>
											@foreach (var item in Model.UOMs)
											{
												<option value="@item.Uomid">@item.UOMName</option>

											}
										</select>


									</div>
								</div>

							</div>

							<div class="col-md-6">
								<div class="form-group">
									<div class="input-group">
										<select id="brand" class="form-control" required>
											<option value=""> Select Brand</option>
											@foreach (var item in Model.Brands)
											{
												<option value="@item.BrandId">@item.BrandName</option>

											}
										</select>


									</div>
								</div>

							</div>
							<div class="col-md-6">
								<div class="form-group">
									<div class="input-group">
										<select id="brandModel" class="form-control" required>
											<option value=""> Select Model</option>

										</select>


									</div>
								</div>

							</div>


						</div>

					</fieldset>
				</div>

				<script>
					$('#brand').change(async function () {
						var brandId = $(this).val();

						// Always clear the dropdown first
						$('#brandModel').empty();
						$('#brandModel').append('<option value="">Select Model</option>');

						if (!brandId) return; // Stop if no brand is selected

						var formData = { BrandId: brandId };
						var objectData = {
							data: formData,
							url: '/AttributeManager/BrandModel'
						};

						try {
							var result = await Utility.RequestDataAjax(objectData);

							if (result && result.length > 0) {
								$.each(result, function (i, item) {
									$('#brandModel').append(
										`<option value="${item.BrandModelId}">${item.ModelName}</option>`
									);
								});
							} else {
								$('#brandModel').append('<option value="">No models found</option>');
							}
						} catch (error) {
							console.error('Error loading brand models:', error);
							$('#brandModel').append('<option value="">Error loading models</option>');
						}
					});

				</script>
			</div>

			<div class="text-right">
				<button type="button" class="btn btn-link" data-dismiss="modal">Close</button>

				<button id="btnSubmit" type="submit" class="btn btn-primary">Submit form <i class="icon-paperplane ml-2"></i></button>
			</div>
		</form>
	</div>
</div>
<script>
	$(document).ready(function(){
		$('#addProduct').submit(async function(e){
			e.preventDefault();

			const validate = Utility.validateFormAndInputs('#addProduct');
				const isFormValid = validate();

				if(isFormValid)
				{
					var formData={
						ProductName:$('#productName').val(),
						ProductDescription:$('#description').val(),
						SubCategoryId:$('#subcat').val(),
						Uomid:$('#uom').val(),
						BrandId:$('#brand').val(),
						BrandModelId:$('#brandModel').val()

					}
					debugger
					var endPoint = '/Products/AddProduct'
					var sendObject={
						url:endPoint,
						data:formData
					}
					const result = await Utility.RequestDataAjax(sendObject);
					console.log(result);
					if(result.statusCode==='200'){

						window.location.href='/Products/EditProduct?productId='+result.ProductId;
					}
					else{
								Utility.failMessage('Please Try Again Later');

					}
				}
		});

		$('.adddcs').click(function(e){
			e.preventDefault();
			var url = $(this).attr('href');
			$.ajax({
				url:url,
				type:'POST',
				success:function(result){

						$('.mini-modal-title').html('Add Attribute');
						$('.mini-modal-body').html(result);
						$('#modal_mini').modal(
						{
						 backdrop: 'static',
						 keyboard: false
						}
						);


				}
			})
		});

		$('#dep').change(async function () {
			var id = $(this).val(); // "this" refers correctly to the changed element
			var formData = {
				DepartmentId: id
			};
			var dataObject = {
				url: '/AttributeManager/GetCategorybyDepartment',
				data: formData
			};
			var result = await Utility.RequestDataAjax(dataObject);
				$('#cat').empty();
				$('#cat').append(`<option>Select Category</option>`);
								  result.forEach(function(resu) {
										$('#cat').append(`<option value="${resu.CategoryId}">${resu.CategoryName}</option>`);
								  });
		});

				$('#cat').change(async function () {
					var id = $(this).val(); // "this" refers correctly to the changed element
					var formData = {
						CategoryId: id
					};
					var dataObject = {
						url: '/AttributeManager/GetSubCategorybyCategory',
						data: formData
					};
					var result = await Utility.RequestDataAjax(dataObject);
						$('#subcat').empty();
							$('#subcat').append(`<option>Select Category</option>`);
										  result.forEach(function(resu) {
										$('#subcat').append(`<option value="${resu.SubCategoryId}">${resu.SubCategoryName}</option>`);
					  });
				});


		$('.refreshdcs').click(async function(e){
			e.preventDefault();

			var url = $(this).attr('href');
			var selectItem = $(this).attr('data-selectName');
			if(selectItem==='cat'){
				var depId = $('#dep').val();
				var formData={
					DepartmentId : depId
				}
				var dataObject= {
					url:url,
					data:formData
				}
				var result = await Utility.RequestDataAjax(dataObject);
				$(`#${selectItem}`).empty();
				result.forEach(function(res){
					$(`#${selectItem}`).append(`<option value="${res.CategoryId}">${res.CategoryName}</option>`);
				});
			}
			else if(selectItem === 'subcat'){

					var catId = $('#cat').val();
				var formData={
					CategoryId : catId
				}
				var dataObject= {
					url:url,
					data:formData
				}
				var result = await Utility.RequestDataAjax(dataObject);
				$(`#${selectItem}`).empty();
				result.forEach(function(res){
					$(`#${selectItem}`).append(`<option value="${res.SubCategoryId}">${res.SubCategoryName}</option>`);
				});
			}
			else{
				var result = await Utility.RequestAjax(url);
					$('#dep').empty();
				result.forEach(function(res){
					$(`#${selectItem}`).append(`<option value="${res.DepartmentId}">${res.DepartmentName}</option>`);
				});
			}


		})

	})
</script>