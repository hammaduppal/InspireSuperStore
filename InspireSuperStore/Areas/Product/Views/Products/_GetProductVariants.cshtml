@using MainModels.DTOModels
@using MainModels.Util
@using static MainModels.DTOModels.AppConstants
@model PagesViewModel

<div class="row">
	<div class="container>">
		<div class="row">


			<div class="col-md-11">
			</div>
			@if (AppDataUtility.SessionUser.Person.Branch.IsMasterBranch == true)
			{
				<div class="col-md-1">
					<button class="btn btn-success" id="addVariant">Show Form </button>
				</div>
			}

		</div>
	</div>
	<form id="formVariant" style="display:none" action="#">
		<div class="row">
			<div class="col-md-2">
				<div class="form-group">
					<label>Product SubUOM</label>
					<select id="subUom" name="subUom" class="form-control">
						@if (Model.SubUOMs != null)
						{
							@foreach (var item in Model.SubUOMs)
							{
								<option value="@item.SubUomId">@item.SubUOMName</option>
							}
						}
					</select>
				</div>
			</div>

			<div class="col-md-2">
				<div class="form-group">
					<label>Product Size</label>
					<select id="size" name="size" class="form-control">
						@if (Model.Sizes != null)
						{
							@foreach (var item in Model.Sizes)
							{
								<option value="@item.SizeId">@item.SizeName</option>
							}
						}
					</select>
				</div>
			</div>

			<div class="col-md-2">
				<div class="form-group">
					<label>Product Color</label>
					<select id="color" name="color" class="form-control">
						@foreach (var item in Model.Colors)
						{
							<option value="@item.ColorId">@item.ColorName</option>
						}
					</select>
				</div>
			</div>

			<div class="col-md-2">
				<div class="form-group">
					<label>Product Material</label>
					<select id="material" name="material" class="form-control">
						@foreach (var item in Model.Materials)
						{
							<option value="@item.MaterialId">@item.MaterialName</option>
						}
					</select>
				</div>
			</div>

			<div class="col-md-2">
				<div class="form-group">
					<label>Qty Per Unit</label>
					<input type="text" id="qtyPerUnit" value="1" disabled name="qtyPerUnit" class="form-control" placeholder="Qty Per Unit" />
				</div>
			</div>

			<div class="col-md-2">
				<div class="form-group">
					<label>BarCode</label>
					<input type="text" id="barCode" name="barCode" class="form-control" placeholder="BarCode" />
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-md-2">
				<div class="form-group">
					<label>Cost</label>
					<input type="text" id="cost" name="cost" class="form-control" placeholder="Cost" />
				</div>
			</div>

			<div class="col-md-2">
				<div class="form-group">
					<label>Retail Price</label>
					<input type="text" id="retailPrice" name="retailPrice" class="form-control" placeholder="Retail Price" />
				</div>
			</div>

			<div class="col-md-2">
				<div class="form-group">
					<label>Sale Price</label>
					<input type="text" id="salePrice" name="salePrice" class="form-control" placeholder="Sale Price" />
				</div>
			</div>

			<div class="col-md-2">
				<div class="form-group">
					<label>Promotion Price</label>
					<input type="text" id="promotionPrice" name="promotionPrice" class="form-control" placeholder="Promotion Price" />
				</div>
			</div>


			<div class="col-md-1">
				<label>Is Serial</label>
				<label class="switch">
					<input type="checkbox" id="isSerial">
					<span class="slider"></span>
				</label>

			</div>

			<div class="col-md-1">
				<div class="form-group">
					<label>Min</label>
					<input type="number" id="min" name="min" min="1" value="1" class="form-control" placeholder="Min" />
				</div>
			</div>

			<div class="col-md-1">
				<div class="form-group">
					<label>Max</label>
					<input type="number" id="max" min="2" name="max" value="2" class="form-control" placeholder="Max" />
				</div>
			</div>
			<div class="col-md-2">
				<div class="form-group">
					<label>Type of Tax</label>
					<select id="taxSlabs" class="form-control">
						@foreach (var item in Model.TaxSlabs)
						{
							<option value="@item.TaxSlabId">@item.SlabName</option>
						}

					</select>
					
				</div>
			</div>
		</div>

		<div class="text-right">
			<button type="submit" class="btn btn-primary">Submit <i class="icon-paperplane ml-2"></i></button>
		</div>
	</form>

</div>


<style>
	.selectable-img {
		border: 2px solid transparent;
		cursor: pointer;
		transition: border-color 0.3s;
	}

	.image-radio:checked + img.selectable-img {
		border-color: #007bff;
	}
</style>

<div class="row">
	@{
		int i = 1;
	}
	@foreach (var item in Model.ProductVariants)
		{
		i++;
		<div class="col-lg-12">
			<p class="">
				ProductName: <span class="font-weight-semibold">@item.ProductName,</span>
				Product Size:  <span class="font-weight-semibold">@item.SizeName,</span>

				ProductColor: <span class="font-weight-semibold">@item.ColorName,</span>
				Product Material: <span class="font-weight-semibold">@item.MaterialName,</span>

			</p>
			<div class="alert alert-primary shadow-3">
				<div class="row">
					<div class="col-lg-6">
						<div class="row">
							<div class="col-md-2">
								<div class="form-group">
									<label>Cost</label>
									<input type="text"
										   id="cost-@i"
										   name="cost"
										   value="@item.Cost"
										   data-variantId="@item.VariantId"
										   class="form-control cost"
										   data-datatype="Cost"
										   onchange="Utility.validateNumericValue(this, @PagesViewModel.SystemSettings.DecimalPoint)" 431`
										   placeholder="COST" />
								</div>
							</div>
							<div class="col-md-2">
								<div class="form-group">
									<label>R-Price</label>
									<input type="text" name="retail"
										   id="rPrice-@i"
										   value="@item.RetailPrice" class="form-control retailPrice" placeholder="Min"
										   onchange="Utility.validateNumericValue(this, @PagesViewModel.SystemSettings.DecimalPoint)"
										   data-datatype="RetailPrice"
										   data-variantId="@item.VariantId" />
								</div>
							</div>

							<div class="col-md-2">
								<div class="form-group">
									<label>S-Price</label>
									<input type="text" name="sale"
										   id="sPrice-@i"
										   value="@item.SalePrice" class="form-control salePrice" placeholder="Sale Price"
										   data-variantId="@item.VariantId"
										   data-datatype="SalePrice"
										   onchange="Utility.validateNumericValue(this, @PagesViewModel.SystemSettings.DecimalPoint)" />
								</div>
							</div>
							<div class="col-md-2">
								<div class="form-group">
									<label>P-Price</label>
									<input type="text" name="promo"
										   id="pPrice-@i"
										   value="@item.PromotionPrice" class="form-control promotionPrice" placeholder="Promotion Price"
										   data-variantId="@item.VariantId"
										   data-datatype="PromotionPrice"
										   onchange="Utility.validateNumericValue(this, @PagesViewModel.SystemSettings.DecimalPoint)" />
								</div>
							</div>

							<div class="col-md-3">
								<div class="form-group">
									<label>BarCode</label>
									<input type="text" name="qpu"
										   id="barCode-@i"
										   value="@item.BarCode" class="form-control barcode" placeholder="BarCode"
										   data-variantId="@item.VariantId"
										   data-datatype="BarCode" />
								</div>
							</div>

							<div class="col-md-1">
								<div class="form-group">
									<label>Q/U</label>
									<input type="text" name="qpu"
										   id="qpu-@i"
										   value="@item.QuantityPerUnit" class="form-control quantityperUnit" placeholder="Q/U"
										   data-variantId="@item.VariantId"
										   data-datatype="QuantityPerUnit"
										   onchange="Utility.validateNumericValue(this, @PagesViewModel.SystemSettings.DecimalPoint)" />
								</div>
							</div>



						</div>
					</div>
					<div class="col-lg-1">
						<div class="row">
							<div class="col-md-6">
								<div class="form-group">
									<label>Min</label>
									<input type="text" name="min" value="@item.MinQty" class="form-control min" placeholder="Min"
										   id="min-@i"
										   data-variantId="@item.VariantId"
										   data-datatype="MinQty"
										   onchange="Utility.validateNumericValue(this, 0)" />
								</div>
							</div>

							<div class="col-md-6">
								<div class="form-group">
									<label>Max</label>
									<input type="text" name="min"
										   id="max-@i"
										   value="@item.MaxQty" class="form-control max" placeholder="Max"
										   data-variantId="@item.VariantId"
										   data-datatype="MaxQty"
										   onchange="Utility.validateNumericValue(this, 0)" />
								</div>
							</div>
						</div>


					</div>
					<div class="col-lg-2">
						@if (item.PriceFormat == (int)EnumPriceFormat.RetailPrice)
						{
							<label><input id="setPrice-@item.VariantId" type="radio" class="setPrice" data-variantId="@item.VariantId" data-priceType="@EnumPriceFormat.RetailPrice" name="setPrice-@item.VariantId" checked />Retail Price</label>
						}
						else
						{
							<label><input id="setPrice-@item.VariantId" type="radio" class="setPrice" data-variantId="@item.VariantId" data-priceType="@EnumPriceFormat.RetailPrice" name="setPrice-@item.VariantId" />Retail Price</label>
						}

						@if (item.PriceFormat == (int)EnumPriceFormat.SalesPrice)
						{
							<label><input id="setPrice-@item.VariantId" type="radio" class="setPrice" data-variantId="@item.VariantId" data-priceType="@EnumPriceFormat.SalesPrice" name="setPrice-@item.VariantId" checked />Sale Pricee</label>
						}
						else
						{
							<label><input id="setPrice-@item.VariantId" type="radio" class="setPrice" data-variantId="@item.VariantId" data-priceType="@EnumPriceFormat.SalesPrice" name="setPrice-@item.VariantId" />Sales Price</label>

						}
						@if (item.PriceFormat == (int)EnumPriceFormat.PromotionPrice)
						{
							<label><input id="setPrice-@item.VariantId" type="radio" class="setPrice" data-variantId="@item.VariantId" data-priceType="@EnumPriceFormat.PromotionPrice" name="setPrice-@item.VariantId" checked />Promotion Price</label>
						}
						else
						{
							<label><input id="setPrice-@item.VariantId" type="radio" class="setPrice" data-variantId="@item.VariantId" data-priceType="@EnumPriceFormat.PromotionPrice" name="setPrice-@item.VariantId" />Promotion Price</label>
						}




					</div>
					<div class="col-md-2">
						<div class="form-group">
							<label>Qty</label>
							<input readonly type="text" name="retail"
								   id="rPrice-@i"
								   value="@item.Qty" class="form-control qty" placeholder="Qty" />
						</div>
					</div>
					<div class="col-lg-3">
						@foreach (var img in Model.ProductImages)
						{
							var imageId = $"{item.VariantId}-{img.ProductImageId}";
							var radioName = $"selectedImage_{item.VariantId}"; // Unique name per variant

							<label>
								<input type="radio"
									   data-productImageId="@img.ProductImageId"
									   data-variantId="@item.VariantId"
									   name="@radioName"
									   value="@img.ProductImageId"
									   class="image-radio d-none"
									   id="@imageId"
									   @(img.ProductImageId == item.VariantImageId ? "checked" : "") />
								<img src="@PagesViewModel.SystemSettings.ContentAPIUrl/@img.ImageUrl"
									 class="p-2 selectable-img"
									 style="min-width:50px; max-width:50px;"
									 width="50" height="50" />
							</label>
						}
					</div>
					<div class="col-lg-8">
						<label>Allowed Branches</label>
						@if (AppDataUtility.SessionUser.Person.Branch.IsMasterBranch==true)
						{
							<div class="row">
								@foreach (var branch in Model.Branches)
								{
									var isMaster = branch.BranchId == AppDataUtility.SessionUser.Person.Branch.BranchId;

									// check if this branch exists in AllowedBranches / BranchStock
									var isChecked = item.AllowedBranches.Any(ab => ab.BranchId == branch.BranchId);

									<div class="col-md-3">
										<input type="checkbox" class="branch-checkbox"
											   data-variantid="@item.VariantId"
											   name="SelectedBranchIds"
											   value="@branch.BranchId"
											   @(isChecked ? "checked" : "")
											   @(isMaster ? "checked disabled" : "") />
										<label>@branch.BranchName</label>
									</div>
								}
							</div>
						}





					</div>
				</div>
			</div>
		</div>

	}


</div>

<script>
			$(document).ready( function () {
				$('.branch-checkbox').on('click', async function () {
					var branchId = $(this).val();
					var variantId = $(this).data('variantid'); // get VariantId from data attribute
					var isChecked = $(this).is(':checked');

					console.log('VariantId:', variantId, 'BranchId:', branchId, 'Checked:', isChecked);
					var result = await Utility.RequestDataAjax({
						url:'/Products/SaveVariantBranches',
						data:{
							VariantId:variantId,
							BranchId:branchId,
							IsActive:isChecked
						}

					});
					Utility.successMessage(result.Message);
					// You can now call your AJAX to copy master branch stock
				});
			});


		$('.min, .max, .quantityperUnit, .promotionPrice, .salePrice, .retailPrice, .cost,.barcode').on('focusout', async function() {
			debugger
			var id=$(this).attr('id');
		Utility.SpinnerMessageParent(id,'Loading..');

			var thisValue = $(this).val();
		var variantId = $(this).attr('data-variantId');
		var dataType =  $(this).attr('data-datatype');
		console.log(dataType);
		console.log(variantId);
		var formData={
			Value:thisValue,
			VariantId:variantId,
			DataType:dataType
		}
		var ObjectData={
			data:formData,
			url:'/Products/UpdateVariant'
		}
		const updateStatus = await Utility.RequestDataAjax(ObjectData);
					Utility.StopSpinnerMessageParent(id);
					debugger
		if(updateStatus.statusCode==="200"){
								Utility.successMessage(updateStatus.Message);
		}
		else{
				Utility.failMessage(updateStatus.Message);

		}
	});


	$('.setPrice').click(async function(){
		var id = $(this).attr('id');
		Utility.SpinnerMessageParent(id,'Loading..');
		var priceType = $(this).attr('data-priceType');
		var variantId = $(this).attr('data-variantId');
		var formData={
		 PriceFormat:priceType,
		 VariantId:variantId
		}
		var objectData={
			data:formData,
			url:'/Products/SetPriceFormat'
		}
		const setPriceType = await Utility.RequestDataAjax(objectData);
		Utility.StopSpinnerMessageParent(id);
								Utility.successMessage('Record Updated');

	});


	$('.image-radio').click(async function(){
		var id = $(this).attr('id');

		Utility.SpinnerMessageParent(id,'Loading..');

		var imgId = $(this).attr('data-productImageId');
		var variantId = $(this).attr('data-variantId');
		var formData= {
			ProductImageId:imgId,
			VariantId:variantId
		}
		var objectData={
			data:formData,
			url:'/Products/SetVariantImage'
		}
		const result= await Utility.RequestDataAjax(objectData);
		if (result.statusCode==='200')
		{
		Utility.StopSpinnerMessageParent(id);

								Utility.successMessage('Record Updated');

		}
	});

	$('#formVariant').submit(async function(e){
		e.preventDefault();

		 const serialNumberOption = $('#isSerial').is(':checked');
		 var ProductId = $('#productId').val()
		var formData={
				SubUomid: $('#subUom').val(),
				SizeId: $('#size').val(),
				ColorId: $('#color').val(),
				MaterialId: $('#material').val(),
				QuantityPerUnit: $('#qtyPerUnit').val(),
				BarCode: $('#barCode').val(),
				Cost: $('#cost').val(),
				RetailPrice: $('#retailPrice').val(),
				SalePrice: $('#salePrice').val(),
				PromotionPrice: $('#promotionPrice').val(),
				MinQty: $('#min').val(),
				MaxQty: $('#max').val(),
				IsSerial:serialNumberOption,
				ProductId:ProductId,
				TaxSlabId: $('#taxSlabs').val(),
		}
		var objectData={
			data:formData,
			url:'/Products/AddProductVariant'
		}
		const result = await Utility.RequestDataAjax(objectData);
		if(result.statusCode==='200')
		{
								Utility.successMessage('Record Updated');

			LoadVariantTab();
		}
		else{
				Utility.failMessage(result.Message);

			
		}
	});
	$('#addVariant').click(function () {
		$('#formVariant').toggle();

		if ($('#formVariant').is(':visible')) {
			$('#addVariant').text('Hide Form');
		} else {
			$('#addVariant').text('Show Form');
		}
	});
</script>