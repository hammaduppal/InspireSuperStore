@{
	ViewData["Title"] = "Products";
	Layout = "~/Views/Shared/_Layout.cshtml";
}



<!-- Page header -->
<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">
		<div class="page-title d-flex">
			<h4> <span class="font-weight-semibold">Products</span> </h4>
		</div>

		<div class="header-elements d-none">
			<div class="d-flex justify-content-center">
				<a href="#" class="btn btn-success addOrganization">Add Product</a>

			</div>
		</div>
	</div>

	<div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
				<span class="breadcrumb-item active">Products</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>


	</div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">

	<!-- Basic responsive table -->
	<div class="card shadow">
		<div class="card-header header-elements-inline">
			<h5 class="card-title">Products</h5>
			<div class="header-elements">
				<div class="list-icons">
					<a class="list-icons-item" data-action="collapse"></a>
				</div>
			</div>
		</div>


		<div class="table-responsive">
			<table id="ProductTable" class="table  table-bordered table-striped table-hover  ">
				<thead>
					<tr>
						<th class="text-center">Product Name</th>
						<th class="text-center">Category</th>
						<th class="text-center">Qty</th>
						<th class="text-center">Created On</th>
						<th class="text-center">Status</th>

						<th class="text-center" style="width: 30px;"><i class="icon-menu-open2"></i></th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Marth</td>
						<td><a href="#">Enright</a></td>
						<td>Traffic Court Referee</td>
						<td>22 Jun 1972</td>
						<td>
							<input type="checkbox" class="form-input-styled" checked data-fouc />


						</td>
						<td class="text-center">
							<div class="list-icons">
								<a href="#" class="list-icons-item text-teal-600"><i class="icon-search4"></i></a>

								<a href="#" class="list-icons-item text-primary-600"><i class="icon-pencil7"></i></a>
								<a href="#" class="list-icons-item text-danger-600"><i class="icon-trash"></i></a>
							</div>
						</td>
					</tr>

				</tbody>
			</table>
		</div>
	</div>
	<!-- /basic responsive table -->
</div>

<script>
	$(document).ready(function() {


		window.ProductTable = new DataTable('#ProductTable', {
			processing: true,
			serverSide: true,
			ajax: {
			url:	'/Products/GetProducts',
			method:'POST',
		dataSrc:'data'
			},
			order: [[0, 'asc']],
			  columns: [
		{ data: 'ProductId',visible:false
		},
		{ data: 'ProductName' },
		{ data: 'ProductDescription',
		  className: 'text-center'
		},
		{ data: 'Qoh',
				  className: 'text-center',
		 render: function(data, type, row, meta) {
		return new Date(data).toLocaleDateString();
		 }
		},
		{ data: 'IsActive' ,
		className:'text-center',
		 render: function(data, type, row, meta) {
			return `<input type="checkbox" class="form-input-styled activeUnactive" ${data ? 'checked' : ''} data-value="${row.ProductId}" />`;
		 }

		},
		{ data: 'Action',orderable: false,
		render: function(data, type, row, meta) {

	return `
		<a href="#" class="view list-icons-item text-teal-600" data-value="${row.ProductId}">
			<i class="icon-search4"></i>
		</a>
		<a href="#" class="list-icons-item text-primary-600 edit" data-value="${row.ProductId}">
			<i class="icon-pencil7"></i>
		</a>
		<a href="#" class="list-icons-item text-danger-600 remove" data-value="${row.ProductId}">
			<i class="icon-trash"></i>
		</a>
	`;

		}



		},

		],
	error: function (xhr, error, code) {
		console.error('DataTables Error:', xhr.responseText);
	}
		});


	});

</script>
<script>
	$(document).ready(function(){
		$('.addOrganization').click(function(e){

			e.preventDefault();
			$.ajax({
				url:'/Business/AddOrganizationView',
				method:'POST',
				success:function(e){
					console.log(e);
					debugger
					$('.vertical-modal-title').html('Add Organization');
					$('.vertical-modal-body').html(e);
					$('#vertical-modal').modal('show');
				}
			})
		});

		$(document).on('click', '.view', function (e) {
				e.preventDefault();
				var Id = $(this).attr('data-value');
				var formData={
				OrganizationId:Id
				}
				$.ajax({
					url:'/Business/GetOrganization',
					method:'POST',
					data:formData,
					success:function(e){
						console.log(e);
						debugger
						$('.large-modal-title').html('View Organization');
						$('.large-modal-body').html(e);
						$('#modal_large').modal('show');
					}
				})
			});
				$(document).on('click', '.edit', function (e) {
				e.preventDefault();
				var Id = $(this).attr('data-value');
				var formData={
				OrganizationId:Id
				}
				$.ajax({
					url:'/Business/EditOrganization',
					method:'POST',
					data:formData,
					success:function(e){
						console.log(e);
						debugger
						$('.large-modal-title').html('Edit Organization');
						$('.large-modal-body').html(e);
						$('#modal_large').modal('show');
					}
				})
			});
				$(document).on('click', '.remove', function (e) {
				e.preventDefault();
				var Id = $(this).attr('data-value');
				var formData={
				OrganizationId:Id
				}
				$.ajax({
					url:'/Business/RemoveOrganization',
					method:'POST',
					data:formData,
					success:function(e){
								Utility.successMessage('Record Added');
					ProductTable.ajax.reload(null, false);
					  }
				})
			});
			$(document).on('click', '.activeUnactive', function (e) {
				e.preventDefault();
				debugger
				var Id = $(this).attr('data-value');
				var formData={
				OrganizationId:Id,
					IsActive: $(this).is(':checked')
					}
				$.ajax({
					url:'/Business/ActiveUnactive',
					method:'POST',
					data:formData,
					success:function(result){
							if(result.statusCode==='200'){
								Utility.successMessage('Record Updated');
								location.reload();
							}
							else{
								Utility.failMessage('Some issue in Updating Record');

							}
					}
				})
			});


	})
</script>
