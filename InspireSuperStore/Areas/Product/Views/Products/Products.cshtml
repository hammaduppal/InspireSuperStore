@using MainModels.DTOModels
@using MainModels.Util
@model PagesViewModel

@{
	ViewData["Title"] = "Products | Inspire Nation";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header / Crumb Area -->
<div class="page-header page-header-light  border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border-radius: 12px;">
	<div class="page-header-content header-elements-md-inline py-3 px-4">
		<div class="d-flex align-items-center justify-content-between w-100">
				<div class="d-flex align-items-center">
					<!-- Icon Wrapper with Soft Tint -->
					<div class="mr-3 rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; background-color: rgba(33, 150, 243, 0.1); border: 1px solid rgba(33, 150, 243, 0.2);">
						<i class="icon-cube2 text-primary font-size-xl"></i>
					</div>

					<!-- Title & Breadcrumb -->
					<div>
						<h4 class="font-weight-extrabold mb-1" style="letter-spacing: -0.5px;">Inventory Products</h4>
						<div class="breadcrumb bg-transparent p-0 mb-0 font-size-sm">
							<a href="/" class="breadcrumb-item text-muted"><i class="icon-home2 mr-1"></i> Home</a>
							<span class="breadcrumb-item active font-weight-semibold text-primary">Products Management</span>
						</div>
					</div>
				</div>
			
			<!-- Add Dropdown Action -->
			<div class="header-elements">
				<div class="list-icons">
					<div class="dropdown">
						<a href="#" class="btn btn-primary font-weight-semibold dropdown-toggle shadow-xs" data-toggle="dropdown">
							<i class="icon-plus3 mr-1"></i> Add New
						</a>
						<div class="dropdown-menu dropdown-menu-right shadow-lg border-0 p-3" style="width: 300px; border-radius: 12px;">
							<div class="row no-gutters text-center">
								<div class="col-6 pr-1">
									<a href="#" class="d-block text-default bg-light rounded p-3 addProduct text-decoration-none transition-hover">
										<i class="icon-diff-added text-primary icon-2x mb-1"></i>
										<div class="font-size-sm font-weight-bold text-dark mt-1">Product</div>
									</a>
								</div>
								<div class="col-6 pl-1">
									<a href="#" class="d-block text-default bg-light rounded p-3 addService text-decoration-none transition-hover">
										<i class="icon-add text-success icon-2x mb-1"></i>
										<div class="font-size-sm font-weight-bold text-dark mt-1">Service</div>
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Content Area -->
<div class="content pt-0">

	<!-- Responsive Table Card -->
	<div class="card shadow-sm border-0 theme-color" style="border-radius: 12px; overflow: hidden; ">
		
		<!-- Card Header with Branch Filter -->
		<div class="card-header header-elements-inline py-3 border-bottom">
			<h5 class="card-title font-weight-bold text-dark mb-0"><i class="icon-list3 mr-2 text-primary"></i> Product Catalog</h5>
			
			<div class="header-elements">
				@if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin) && AppDataUtility.SessionUser.Person.Branch.IsMasterBranch == true)
				{
					<div class="form-group mb-0">
						<select class="form-control form-control-sm font-weight-semibold" style="min-width: 200px;">
							<option>Select Branch</option>
							@foreach (var item in Model.Branches)
							{
								<option value="@item.BranchId">@item.BranchName</option>
							}
						</select>
					</div>
				}
			</div>
		</div>

		<!-- Table View -->
		<div class="table-responsive">
			<table id="ProductTable" class="table table-bordered table-striped table-hover align-middle mb-0">
				<thead class=" font-weight-semibold text-uppercase small text-muted">
					<tr>
						<th class="text-center" style="width: 60px;">Id</th>
						<th>Product Name</th>
						<th class="text-center">Brand</th>
						<th class="text-center">Model</th>
						<th class="text-center">SubCategory</th>
						<th class="text-center">QOH</th>
						<th class="text-center">Created</th>
						<th class="text-center">Status</th>
						<th class="text-center" style="width: 50px;"><i class="icon-menu-open2"></i></th>
					</tr>
				</thead>
				<tbody>
					<!-- Datatable rows populated dynamically -->
				</tbody>
			</table>
		</div>
	</div>
	<!-- /responsive table card -->

</div>
<!-- /content area -->

<style>
	.transition-hover {
		transition: all 0.2s ease-in-out;
	}
	.transition-hover:hover {
		background-color: #e3f2fd !important;
		transform: translateY(-2px);
	}
</style>
<script>
	$(document).ready(function() {


		window.ProductTable = new DataTable('#ProductTable', {
			processing: true,
			serverSide: true,
			ajax: {
			url:	'/Products/GetProducts',
			method:'POST',
		dataSrc:'data'
			},
			order: [[0, 'asc']],
		 columns: [
					{ data: 'ProductId',visible:false
					},
					{ data: 'ProductName' },
					{ data: 'BrandName',
					  className: 'text-center'
					},
					{ data: 'ModelName',
					  className: 'text-center'
					},
					{ data: 'SubCategoryName',
					  className: 'text-center'
					},
					{ data: 'Qoh',
							  className: 'text-center',

					},
					{ data: 'CreatedOn',
							  className: 'text-center',
					 render: function(data, type, row, meta) {
					return new Date(data).toLocaleDateString();
					 }
					},
					{ data: 'IsActive' ,
					className:'text-center',
					 render: function(data, type, row, meta) {
						return `<input type="checkbox" class="form-input-styled activeUnactive" ${data ? 'checked' : ''} data-value="${row.ProductId}" />`;
					 }

					},
					{ data: 'Action',orderable: false,
					render: function(data, type, row, meta) {

				return `

					<a href="/Products/EditProduct?productId=${row.ProductId}" class="list-icons-item text-primary-600 edit" data-value="${row.ProductId}">
						<i class="icon-pencil7"></i>
					</a>

				`;

					}



					},

		],
	error: function (xhr, error, code) {
		console.error('DataTables Error:', xhr.responseText);
	}
		});


	});

</script>
<script>
