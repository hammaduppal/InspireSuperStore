@using MainModels.DTOModels
@using MainModels.Util
@model PagesViewModel
@{
	ViewData["Title"] = "Products";
	Layout = "~/Views/Shared/_Layout.cshtml";
}



<!-- Page header -->
<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
				<span class="breadcrumb-item active">Products</span>
			</div>
			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">

	<!-- Basic responsive table -->
	<div class="card shadow-5">
		<div class="card-header header-elements-inline">
			<h5 class="card-title">Products</h5>
			<div class="header-elements">

				<div class="header-elements d-none">
					<div class="d-flex justify-content-center">
						<a href="#" class="btn btn-success addProduct">Add Product</a>

					</div>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-md-4">
				@if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin))
				{
					<select class="form-control">
						<option>Select Branch</option>
						@foreach (var item in Model.Branches)
						{
							<option value="@item.BranchId">@item.BranchName</option>
						}
					</select>
				}
			</div>
		</div>

		<div class="table-responsive">

			<table id="ProductTable" class="table  table-bordered table-striped table-hover  ">
				<thead>
					<tr>
						<th class="text-center">Id</th>
						<th class="text-center">Product Name</th>
						<th class="text-center">Product Description</th>
						<th class="text-center">QOH</th>
						<th class="text-center">Created on</th>

						<th class="text-center">Status</th>

						<th class="text-center" style="width: 30px;"><i class="icon-menu-open2"></i></th>
					</tr>
				</thead>
				<tbody>
				</tbody>
			</table>
		</div>
	</div>
	<!-- /basic responsive table -->
</div>

<script>
	$(document).ready(function() {


		window.ProductTable = new DataTable('#ProductTable', {
			processing: true,
			serverSide: true,
			ajax: {
			url:	'/Products/GetProducts',
			method:'POST',
		dataSrc:'data'
			},
			order: [[0, 'asc']],
		 columns: [
					{ data: 'ProductId',visible:false
					},
					{ data: 'ProductName' },
					{ data: 'ProductDescription',
					  className: 'text-center'
					},
					{ data: 'Qoh',
							  className: 'text-center',

					},
					{ data: 'CreatedOn',
							  className: 'text-center',
					 render: function(data, type, row, meta) {
					return new Date(data).toLocaleDateString();
					 }
					},
					{ data: 'IsActive' ,
					className:'text-center',
					 render: function(data, type, row, meta) {
						return `<input type="checkbox" class="form-input-styled activeUnactive" ${data ? 'checked' : ''} data-value="${row.ProductId}" />`;
					 }

					},
					{ data: 'Action',orderable: false,
					render: function(data, type, row, meta) {

				return `

					<a href="/Products/EditProduct?productId=${row.ProductId}" class="list-icons-item text-primary-600 edit" data-value="${row.ProductId}">
						<i class="icon-pencil7"></i>
					</a>

				`;

					}



					},

		],
	error: function (xhr, error, code) {
		console.error('DataTables Error:', xhr.responseText);
	}
		});


	});

</script>
