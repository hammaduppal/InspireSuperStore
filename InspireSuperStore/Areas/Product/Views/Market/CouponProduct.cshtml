@using MainModels.DTOModels
@model PagesViewModel


@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = "Manage Products for Coupon";

}
<input type="hidden" id="couponId" value="@Model.Coupon.CouponId" />
<div class="container-fluid mt-4">

	<div class="card">
		<div class="card-header">
			<h5>Assign Products to Coupon</h5>
		</div>

		<div class="card-body">
			<!-- Category -->
			<div class="row">
				<div class="col-sm-4">
					<select id="dep" class="form-control">
						<option>Select Department</option>
						@foreach (var item in Model.Departments)
						{
							<option value="@item.DepartmentId">@item.DepartmentName</option>
						}
					</select>
				</div>
				<div class="col-sm-4">
					<select id="cat" class="form-control">
						<option>Please Select Category</option>
					</select>
				</div>
				<div class="col-sm-4">
					<select id="subcat" class="form-control">
						<option>Please Select Sub Category</option>
					</select>
				</div>
			</div>
		

			<!-- Products + Variants -->
			<div id="productVariantList" class="mt-3"></div>

			<button class="btn btn-primary mt-3" id="btnAssignVariants">
				Assign Selected Variants
			</button>
		</div>
	</div>

	<hr />

	<!-- Assigned Variants -->
	<div class="card">
		<div class="card-header">
			<h5>Assigned Variants</h5>
		</div>
		<div class="card-body">
			<table class="table table-bordered" id="assignedVariantsTable">
				<thead>
					<tr>
						<th>Product</th>
						<th>SKU</th>
						<th>Price</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>

</div>


<script>
	const couponId = '@Model.Coupon.CouponId';

</script>

<script>
		$('#btnAssignVariants').on('click', async function () {

		const couponId = $('#couponId').val();

		const variantIds = $('.variant-checkbox:checked')
			.map(function () {
				return $(this).val();
			})
			.get();

		if (!variantIds.length) {
			Utility.failMessage('Please select at least one product variant');
			return;
		}

		try {
			const result = await Utility.RequestDataAjax({
				url: '/Market/AssignVariants',
				data: {
					couponId: couponId,
					variantIds: variantIds
				}
			});

			if (result?.statusCode === '200'	) {
				Utility.successMessage('Products assigned successfully');
				// optional refresh
				loadAssignedVariants();
			} else {
				Utility.failMessage('Unable to assign products');
			}

		} catch (e) {
			console.error(e);
			Utility.failMessage('Something went wrong');
		}
	});

</script>

<script>

	$(document).ready(function(){
	
			$(document).on('click', '.btn-unassign', async function () {

				const couponProductId = $(this).data('id');

				await Utility.RequestDataAjax({
					url: '/Market/UnassignVariant',
					data: { ProductVariantId:couponProductId }
				});

				Utility.successMessage('Variant unassigned');

				// reload assigned ids
				assignedVariantIds = await Utility.RequestDataAjax({
					url: '/Coupon/GetAssignedVariantIds',
					data: { couponId: $('#couponId').val() }
				});

				// refresh UI
				loadAssignedVariants();
				$('#categoryDropdown').trigger('change');
			});


			loadAssignedVariants();
		$('#dep').change(async function () {
				var id = $(this).val(); // "this" refers correctly to the changed element
				var formData = {
					DepartmentId: id
				};
				var dataObject = {
					url: '/AttributeManager/GetCategorybyDepartment',
					data: formData
				};
				var result = await Utility.RequestDataAjax(dataObject);
					$('#cat').empty();
					$('#cat').append(`<option>Select Category</option>`);
									  result.forEach(function(resu) {
											$('#cat').append(`<option value="${resu.CategoryId}">${resu.CategoryName}</option>`);
									  });
		});

		$('#cat').change(async function () {
				var id = $(this).val(); // "this" refers correctly to the changed element
				var formData = {
					CategoryId: id
				};
				var dataObject = {
					url: '/AttributeManager/GetSubCategorybyCategory',
					data: formData
				};
				var result = await Utility.RequestDataAjax(dataObject);
					$('#subcat').empty();
				$('#subcat').append(`<option>Select Category</option>`);
					result.forEach(function(resu) {
				$('#subcat').append(`<option value="${resu.SubCategoryId}">${resu.SubCategoryName}</option>`);
				});
		});

		$('#subcat').change(async function () {
				var id = $(this).val(); // "this" refers correctly to the changed element
				var formData = {
					SubCategoryId: id
				};
				var dataObject = {
					url: '/Products/GetProductBySubCategoryId',
					data: formData
				};
				var result = await Utility.RequestDataAjax(dataObject);
					renderVariants(result.AllProducts);
					loadAssignedVariantIds();
		});

			let assignedVariantIds = [];

			async function loadAssignedVariantIds() {
				const couponId = $('#couponId').val();
				assignedVariantIds = await Utility.RequestDataAjax({
					url: '/Market/GetAssignedVariantIds',
					data: {CouponId: couponId }
				});
			}

		function renderVariants(variants) {

			if (!Array.isArray(variants)) {
				variants = variants.data || variants.result || [];
			}
		
			let html = '';
		
			 variants.forEach(v => {

			const isAssigned = assignedVariantIds.includes(v.VariantId);

			html += `
				<div class="card mb-2">
					<div class="card-body">
						<div class="form-check">
							<input type="checkbox"
								   class="form-check-input variant-checkbox"
								   value="${v.VariantId}"
								   ${isAssigned ? 'checked disabled' : ''}>
							<label class="form-check-label">
								<strong>${v.ProductName}</strong>
								(${v.BarCode}) - ${v.CurrentPrice}
								${isAssigned ? '<span class="badge badge-success ml-2">Assigned</span>' : ''}
							</label>
						</div>
					</div>
				</div>`;
		});


			$('#productVariantList').html(html);
		}
	
		async function loadAssignedVariants() {

			const couponId = $('#couponId').val();

			const variants = await Utility.RequestDataAjax({
				url: '/Market/GetAssignedVariants',
				data: { couponId }
			});

			let html = '';

			variants.forEach(v => {
				html += `
					<tr>
						<td>${v.ProductName}</td>
						<td>${v.BarCode}</td>
						<td>${v.CurrentPrice}</td>
						<td>
							<button class="btn btn-sm btn-danger btn-unassign"
									data-id="${v.CouponProductId}">
								Unassign
							</button>
						</td>
					</tr>`;
			});

			$('#assignedVariantsTable tbody').html(html);
		}

	


	})
		
</script>