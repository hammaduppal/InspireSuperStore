<div class="card shadow-5">
	<div class="card-header header-elements-inline">
		<h5 class="card-title">Brand</h5>
		<div class="header-elements">
			<div class="list-icons">
				<a class="list-icons-item" data-action="collapse"></a>
			</div>
		</div>
	</div>

	<div class="card-body">
		<form id="addBrandForm" action="#">
			<div class="form-group row">
				<label class="col-lg-3 col-form-label">Brand:</label>
				<div class="col-lg-9">
					<input type="text" id="BrandName" name="BrandName" class="form-control" placeholder="Brand">
				</div>
			</div>
			<div class="text-right">
				<button type="submit" id="brandSubmitbtn" class="btn btn-primary">Submit form <i class="icon-paperplane ml-2"></i><span id="departmentLoader"> </span></button>
			</div>
		</form>
	</div>
</div>

<script>
	$(document).ready(function(){
		$('#addBrandForm').submit(function(e){
			e.preventDefault();
				if(!$('#BrandName').val()){
					$('#MessageBox').html('<span style=\"color: red;\">Empty not Allowed</span>');
									Utility.infoMessage('Empty Not Allowed');
				}
				else{
					var formData=$(this).serialize();
					Utility.SpinnerMessageParent('brandSubmitbtn','Loading..');
					$.ajax({
						url:'/AttributeManager/AddBrand',
						type:'POST',
						data:formData,
						success:function(result){
							if(result.statusCode==='200'){
								Utility.successMessage('Record Added');
								$('#addBrandForm')[0].reset();
							$('#MessageBox').html('');

							}else if(result.statusCode==='300'){
									Utility.infoMessage('Record Already Exist');
							$('#MessageBox').html('<span style=\"color: red;\">This value already exists. Duplicate entries are not allowed.</span>');

							}
							else{
								Utility.failMessage('Please Try Again Later');
							$('#MessageBox').html('<span style=\"color: red;\">Some Error</span>');
							}
								setTimeout(function(){
									Utility.StopSpinnerMessageParent('brandSubmitbtn');
								},500);
						}
					});
				}
		});

	});

</script>
