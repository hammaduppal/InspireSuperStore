@using MainModels.DTOModels
@model PagesViewModel

<div class="row">
	<!-- Left Column: Add Brand Form -->
	<div class="col-lg-4">
		<div class="card border-0 shadow-sm rounded-lg overflow-hidden">
			<div class="card-header bg-white header-elements-inline py-3 border-bottom border-light">
				<h6 class="card-title font-weight-semibold text-default mb-0">
					<i class="icon-plus-circle2 mr-2 text-teal"></i> Add Brand
				</h6>
			</div>
			<div class="card-body">
				<form id="addBrandForm" action="#">
					<div class="form-group mb-3">
						<label class="form-label font-weight-semibold text-muted text-uppercase font-size-xs">Brand Name</label>
						<div class="form-group-feedback form-group-feedback-left">
							<input type="text" id="BrandName" name="BrandName" class="form-control" placeholder="e.g., Nike, Samsung">
							<div class="form-control-feedback form-control-feedback-left">
								<i class="icon-certificate text-muted"></i>
							</div>
						</div>
						<div id="MessageBox" class="mt-2 font-size-sm"></div>
					</div>
					<div class="text-right">
						<button type="submit" id="brandSubmitbtn" class="btn bg-teal-400 btn-labeled btn-labeled-left btn-sm font-weight-semibold rounded-pill px-3">
							<b><i class="icon-paperplane"></i></b> Save Brand
							<span id="departmentLoader"></span>
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- Right Column: Existing Brands Directory -->
	<div class="col-lg-8">
		<div class="card border-0 shadow-sm rounded-lg overflow-hidden">
			<div class="card-header bg-white header-elements-inline py-3 border-bottom border-light">
				<h6 class="card-title font-weight-semibold text-default mb-0">
					<i class="icon-list3 mr-2 text-primary"></i> Brand Directory
				</h6>
				<div class="header-elements">
					<span class="badge bg-primary-800 badge-pill font-weight-semibold px-2 py-1">
						Total: @(Model.Brands?.Count ?? 0)
					</span>
				</div>
			</div>

			<div class="table-responsive">
				<table class="table table-striped table-hover datatable-basic mb-0">
					<thead>
						<tr class="bg-light text-muted font-size-xs text-uppercase font-weight-bold">
							<th style="width: 15%;">#</th>
							<th style="width: 85%;">Brand Name</th>
						</tr>
					</thead>
					<tbody>
						@{
							int i = 1;
						}
						@if (Model.Brands != null && Model.Brands.Any())
						{
							@foreach (var item in Model.Brands)
							{
								<tr>
									<td class="text-muted font-size-sm">@i</td>
									<td class="font-weight-semibold text-default">@item.BrandName</td>
								</tr>
								i++;
							}
						}
						else
						{
							<tr>
								<td colspan="2" class="text-center py-4 text-muted font-italic">
									<i class="icon-folder-open3 d-block font-size-lg mb-1 opacity-50"></i>
									No brands added yet.
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<script>
	$(document).ready(function() {
		$('#addBrandForm').submit(function(e) {
			e.preventDefault();
			if (!$('#BrandName').val()) {
				$('#MessageBox').html('<span class="text-danger"><i class="icon-cancel-circle2 mr-1"></i> Brand name cannot be empty.</span>');
				Utility.infoMessage('Empty Not Allowed');
			}
			else {
				var formData = $(this).serialize();
				Utility.SpinnerMessageParent('brandSubmitbtn', 'Loading..');
				$.ajax({
					url: '/AttributeManager/AddBrand',
					type: 'POST',
					data: formData,
					success: function(result) {
						if (result.statusCode === '200') {
							Utility.successMessage('Brand Added Successfully');
							$('#addBrandForm')[0].reset();
							$('#MessageBox').html('');
						} else if (result.statusCode === '300') {
							Utility.infoMessage('Record Already Exists');
							$('#MessageBox').html('<span class="text-danger"><i class="icon-warning2 mr-1"></i> This brand already exists.</span>');
						} else {
							Utility.failMessage('Please Try Again Later');
							$('#MessageBox').html('<span class="text-danger"><i class="icon-cancel-circle2 mr-1"></i> An error occurred.</span>');
						}
						setTimeout(function() {
							Utility.StopSpinnerMessageParent('brandSubmitbtn');
						}, 500);
					}
				});
			}
		});
	});
</script>