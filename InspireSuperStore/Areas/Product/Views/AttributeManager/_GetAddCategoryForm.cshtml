@using MainModels.DTOModels
@model PagesViewModel

<div class="row">
	<!-- Left Column: Add Category Form -->
	<div class="col-lg-4">
		<div class="card border-0 shadow-sm rounded-lg overflow-hidden theme-color">
			<div class="card-header header-elements-inline py-3 border-bottom">
				<h6 class="card-title font-weight-semibold mb-0">
					<i class="icon-plus-circle2 mr-2 text-teal"></i> Add Category
				</h6>
			</div>
			<div class="card-body">
				<form id="addcatForm" action="#">
					<div class="form-group mb-3">
						<label class="form-label font-weight-semibold text-uppercase font-size-xs">Department</label>
						<select id="depforCat" name="DepartmentId" class="form-control select">
							<option value="">Select Department</option>
							@if (Model.Departments != null)
							{
								@foreach (var item in Model.Departments)
								{
									<option value="@item.DepartmentId">@item.DepartmentName</option>
								}
							}
						</select>
					</div>

					<div class="form-group mb-3">
						<label class="form-label font-weight-semibold text-uppercase font-size-xs">Category Name</label>
						<div class="form-group-feedback form-group-feedback-left">
							<input id="CategoryName" name="CategoryName" type="text" class="form-control" placeholder="e.g., Electronics, Footwear">
							<div class="form-control-feedback form-control-feedback-left">
								<i class="icon-tree7 text-muted"></i>
							</div>
						</div>
						<div id="MessageBox" class="mt-2 font-size-sm"></div>
					</div>

					<div class="text-right">
						<button id="catsubbtn" type="submit" class="btn bg-teal-400 btn-labeled btn-labeled-left btn-sm font-weight-semibold rounded-pill px-3">
							<b><i class="icon-paperplane"></i></b> Save Category
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- Right Column: Existing Categories Directory -->
	<div class="col-lg-8">
		<div class="card border-0 shadow-sm rounded-lg overflow-hidden theme-color">
			<div class="card-header header-elements-inline py-3 border-bottom">
				<h6 class="card-title font-weight-semibold mb-0">
					<i class="icon-list3 mr-2"></i> Category Directory
				</h6>
			</div>

			<div class="table-responsive">
				<table id="categoryTable" class="table table-striped table-hover mb-0">
					<thead>
						<tr class="font-size-xs text-uppercase font-weight-bold">
							<th style="width: 10%;">#</th>
							<th style="width: 45%;">Department Name</th>
							<th style="width: 45%;">Category Name</th>
						</tr>
					</thead>
					<tbody>
						@{
							int i = 1;
						}
						@if (Model.Departments != null && Model.Departments.Any())
						{
							@foreach (var deps in Model.Departments)
							{
								if (deps.Categories != null)
								{
									@foreach (var cat in deps.Categories)
									{
										<tr>
											<td class="font-size-sm">@i</td>
											<td class="font-weight-semibold">@deps.DepartmentName</td>
											<td class="font-weight-semibold">@cat.CategoryName</td>
										</tr>
										i++;
									}
								}
							}
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<script>
	$(document).ready(function() {
		if (!$.fn.DataTable.isDataTable('#categoryTable')) {
			$('#categoryTable').DataTable({
				autoWidth: false,
				dom: '<"datatable-header"fl><"datatable-scroll"t><"datatable-footer"ip>',
				language: {
					search: '<span>Filter:</span> _INPUT_',
					searchPlaceholder: 'Type to filter...',
					lengthMenu: '<span>Show:</span> _MENU_',
					paginate: { 'first': 'First', 'last': 'Last', 'next': $('html').attr('dir') == 'rtl' ? '&larr;' : '&rarr;', 'previous': $('html').attr('dir') == 'rtl' ? '&rarr;' : '&larr;' }
				}
			});
		}

		$('#addcatForm').submit(function(e) {
			e.preventDefault();
			if (!$('#depforCat').val() || !$('#CategoryName').val()) {
				$('#MessageBox').html('<span class="text-danger"><i class="icon-cancel-circle2 mr-1"></i> Department and Category Name cannot be empty.</span>');
				Utility.infoMessage('Empty Not Allowed');
			}
			else {
				var formData = {
					CategoryName: $('#CategoryName').val(),
					DepartmentId: $('#depforCat').val()
				};
				Utility.SpinnerMessageParent('catsubbtn', 'Loading..');
				$.ajax({
					url: '/AttributeManager/AddCategory',
					type: 'POST',
					data: formData,
					success: function(result) {
						if (result.statusCode === '200') {
							Utility.successMessage('Category Added Successfully');
							$('#addcatForm')[0].reset();
							$('#MessageBox').html('');
						} else if (result.statusCode === '300') {
							Utility.infoMessage('Record Already Exists');
							$('#MessageBox').html('<span class="text-danger"><i class="icon-warning2 mr-1"></i> This category already exists.</span>');
						} else {
							Utility.failMessage('Please Try Again Later');
							$('#MessageBox').html('<span class="text-danger"><i class="icon-cancel-circle2 mr-1"></i> An error occurred.</span>');
						}
						setTimeout(function() {
							Utility.StopSpinnerMessageParent('catsubbtn');
						}, 500);
					}
				});
			}
		});
	});
</script>