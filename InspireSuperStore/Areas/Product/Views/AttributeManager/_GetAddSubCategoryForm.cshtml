@using MainModels.DTOModels
@model PagesViewModel

<div class="row">
	<!-- Left Column: Add Sub Category Form -->
	<div class="col-lg-4">
		<div class="card border-0 shadow-sm rounded-lg overflow-hidden theme-color">
			<div class="card-header header-elements-inline py-3 border-bottom">
				<h6 class="card-title font-weight-semibold mb-0">
					<i class="icon-plus-circle2 mr-2 text-teal"></i> Add Sub Category
				</h6>
			</div>
			<div class="card-body">
				<form id="adsubCat" action="#">
					<div class="form-group mb-3">
						<label class="form-label font-weight-semibold text-uppercase font-size-xs">Department</label>
						<select id="depforSubCat" name="DepartmentId" class="form-control select">
							<option value="">Select Department</option>
							@if (Model.Departments != null)
							{
								@foreach (var item in Model.Departments)
								{
									<option value="@item.DepartmentId">@item.DepartmentName</option>
								}
							}
						</select>
					</div>

					<div class="form-group mb-3">
						<label class="form-label font-weight-semibold text-uppercase font-size-xs">Category</label>
						<select id="catforSubCat" name="CategoryId" class="form-control select">
							<option value="">Select Department First</option>
						</select>
					</div>

					<div class="form-group mb-3">
						<label class="form-label font-weight-semibold text-uppercase font-size-xs">Sub Category Name</label>
						<div class="form-group-feedback form-group-feedback-left">
							<input id="subCategoryName" name="SubCategoryName" type="text" class="form-control" placeholder="e.g., Smartphones, Running Shoes">
							<div class="form-control-feedback form-control-feedback-left">
								<i class="icon-git-branch text-muted"></i>
							</div>
						</div>
					</div>

					<div class="form-group mb-3">
						<label class="form-label font-weight-semibold text-uppercase font-size-xs">HS Code</label>
						<div class="form-group-feedback form-group-feedback-left">
							<input id="harmonizedSystemCode" name="HarmonizedSystemCode" type="text" class="form-control" placeholder="Harmonized System Code">
							<div class="form-control-feedback form-control-feedback-left">
								<i class="icon-barcode2 text-muted"></i>
							</div>
						</div>
						<div id="MessageBox" class="mt-2 font-size-sm"></div>
					</div>

					<div class="text-right">
						<button id="subcatBtn" type="submit" class="btn bg-teal-400 btn-labeled btn-labeled-left btn-sm font-weight-semibold rounded-pill px-3">
							<b><i class="icon-paperplane"></i></b> Save Sub Category
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- Right Column: Existing Sub Categories Directory -->
	<div class="col-lg-8">
		<div class="card border-0 shadow-sm rounded-lg overflow-hidden theme-color">
			<div class="card-header header-elements-inline py-3 border-bottom">
				<h6 class="card-title font-weight-semibold mb-0">
					<i class="icon-list3 mr-2"></i> Sub Category Directory
				</h6>
			</div>

			<div class="table-responsive">
				<table id="subCategoryTable" class="table table-striped table-hover mb-0">
					<thead>
						<tr class="font-size-xs text-uppercase font-weight-bold">
							<th style="width: 10%;">#</th>
							<th style="width: 45%;">Category Name</th>
							<th style="width: 45%;">Sub Category Name</th>
						</tr>
					</thead>
					<tbody>
						@{
							int i = 1;
						}
						@if (Model.Departments != null && Model.Departments.Any())
						{
							@foreach (var deps in Model.Departments)
							{
								if (deps.Categories != null)
								{
									@foreach (var cat in deps.Categories)
									{
										if (cat.SubCategories != null)
										{
											@foreach (var subCat in cat.SubCategories)
											{
												<tr>
													<td class="font-size-sm">@i</td>
													<td class="font-weight-semibold">@cat.CategoryName</td>
													<td class="font-weight-semibold">@subCat.SubCategoryName</td>
												</tr>
												i++;
											}
										}
									}
								}
							}
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<script>
	$(document).ready(function() {
		if (!$.fn.DataTable.isDataTable('#subCategoryTable')) {
			$('#subCategoryTable').DataTable({
				autoWidth: false,
				dom: '<"datatable-header"fl><"datatable-scroll"t><"datatable-footer"ip>',
				language: {
					search: '<span>Filter:</span> _INPUT_',
					searchPlaceholder: 'Type to filter...',
					lengthMenu: '<span>Show:</span> _MENU_',
					paginate: { 'first': 'First', 'last': 'Last', 'next': $('html').attr('dir') == 'rtl' ? '&larr;' : '&rarr;', 'previous': $('html').attr('dir') == 'rtl' ? '&rarr;' : '&larr;' }
				}
			});
		}

		$('#depforSubCat').change(function(e) {
			var depId = $(this).val();
			if (!depId) {
				$('#catforSubCat').html('<option value="">Select Department First</option>');
				return;
			}
			var formData = {
				DepartmentId: depId
			};
			$.ajax({
				url: '/AttributeManager/GetCategorybyDepartment',
				type: 'POST',
				data: formData,
				success: function(res) {
					$('#catforSubCat').empty();
					$('#catforSubCat').append('<option value="">Select Category</option>');
					res.forEach(function(cat) {
						$('#catforSubCat').append(`<option value="${cat.CategoryId}">${cat.CategoryName}</option>`);
					});
				}
			});
		});

		$('#adsubCat').submit(function(e) {
			e.preventDefault();
			if (!$('#depforSubCat').val() || !$('#catforSubCat').val() || !$('#subCategoryName').val()) {
				$('#MessageBox').html('<span class="text-danger"><i class="icon-cancel-circle2 mr-1"></i> Department, Category, and Sub Category Name are required.</span>');
				Utility.infoMessage('Empty Not Allowed');
			}
			else {
				var formData = {
					CategoryId: $('#catforSubCat').val(),
					DepartmentId: $('#depforSubCat').val(),
					SubCategoryName: $('#subCategoryName').val(),
					HarmonizedSystemCode: $('#harmonizedSystemCode').val()
				};

				Utility.SpinnerMessageParent('subcatBtn', 'Loading..');
				$.ajax({
					url: '/AttributeManager/AddSubCategory',
					type: 'POST',
					data: formData,
					success: function(result) {
						if (result.statusCode === '200') {
							Utility.successMessage('Sub Category Added Successfully');
							$('#adsubCat')[0].reset();
							$('#catforSubCat').html('<option value="">Select Department First</option>');
							$('#MessageBox').html('');
						} else if (result.statusCode === '300') {
							Utility.infoMessage('Record Already Exists');
							$('#MessageBox').html('<span class="text-danger"><i class="icon-warning2 mr-1"></i> This sub category already exists.</span>');
						} else {
							Utility.failMessage('Please Try Again Later');
							$('#MessageBox').html('<span class="text-danger"><i class="icon-cancel-circle2 mr-1"></i> An error occurred.</span>');
						}
						setTimeout(function() {
							Utility.StopSpinnerMessageParent('subcatBtn');
						}, 500);
					}
				});
			}
		});
	});
</script>