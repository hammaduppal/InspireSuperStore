	<div class="card shadow">
				<div class="card-header header-elements-inline">
					<h5 class="card-title">Material</h5>
					<div class="header-elements">
						<div class="list-icons">
							<a class="list-icons-item" data-action="collapse"></a>
						</div>
					</div>
				</div>

				<div class="card-body">
					<form id="addmaterialForm" action="#">
						<div class="form-group row">
							<label class="col-lg-3 col-form-label">Material:</label>
							<div class="col-lg-9">
								<input id="materialName" type="text" class="form-control" placeholder="Material">
							</div>
						</div>
						<div class="text-right">
							<button id="addMaterialBtn" type="submit" class="btn btn-primary">Submit form <i class="icon-paperplane ml-2"></i></button>
						</div>
					</form>
				</div>
				<script>
					$(document).ready(function(){

						$('#addmaterialForm').submit(function(e){
							e.preventDefault();
								if(!$('#materialName').val() ){
									$('#MessageBox').html('<span style=\"color: red;\">Empty not Allowed</span>');
													Utility.infoMessage('Empty Not Allowed');
								}
								else{
									var formData={
										MaterialName : $('#materialName').val()
									}

									debugger
									console.log(formData);
									Utility.SpinnerMessageParent('addMaterialBtn','Loading..');
									$.ajax({
										url:'/AttributeManager/AddMaterial',
										type:'POST',
										data:formData,
										success:function(result){
											if(result.statusCode==='200'){
												Utility.successMessage('Record Added');
												$('#addmaterialForm')[0].reset();
											$('#MessageBox').html('');

											}else if(result.statusCode==='300'){
													Utility.infoMessage('Record Already Exist');
											$('#MessageBox').html('<span style=\"color: red;\">This value already exists. Duplicate entries are not allowed.</span>');

											}
											else{
												Utility.failMessage('Please Try Again Later');
											$('#MessageBox').html('<span style=\"color: red;\">Some Error</span>');
											}
												setTimeout(function(){
													Utility.StopSpinnerMessageParent('addMaterialBtn');
												},500);
										}
									});
								}
						});

					});

				</script>

			</div>
