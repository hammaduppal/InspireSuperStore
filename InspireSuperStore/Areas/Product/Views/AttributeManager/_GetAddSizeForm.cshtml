	<div class="card shadow-5">
				<div class="card-header header-elements-inline">
					<h5 class="card-title">Sizes</h5>
					<div class="header-elements">
						<div class="list-icons">
							<a class="list-icons-item" data-action="collapse"></a>
						</div>
					</div>
				</div>

				<div class="card-body">
					<form id="addsizeForm" action="#">
						<div class="form-group row">
							<label class="col-lg-3 col-form-label">Sizes:</label>
							<div class="col-lg-9">
								<input id="sizeName" type="text" class="form-control" placeholder="Sizes">
							</div>
						</div>
						<div class="text-right">
							<button id="addsizeBtn" type="submit" class="btn btn-primary">Submit form <i class="icon-paperplane ml-2"></i></button>
						</div>
					</form>
					<script>
						$(document).ready(function(){

							$('#addsizeForm').submit(function(e){
								e.preventDefault();
									if(!$('#sizeName').val() ){
										$('#MessageBox').html('<span style=\"color: red;\">Empty not Allowed</span>');
														Utility.infoMessage('Empty Not Allowed');
									}
									else{
										var formData={
											SizeName : $('#sizeName').val()
										}

										debugger
										console.log(formData);
										Utility.SpinnerMessageParent('addsizeBtn','Loading..');
										$.ajax({
											url:'/AttributeManager/AddSize',
											type:'POST',
											data:formData,
											success:function(result){
												if(result.statusCode==='200'){
													Utility.successMessage('Record Added');
													$('#addsizeForm')[0].reset();
												$('#MessageBox').html('');

												}else if(result.statusCode==='300'){
														Utility.infoMessage('Record Already Exist');
												$('#MessageBox').html('<span style=\"color: red;\">This value already exists. Duplicate entries are not allowed.</span>');

												}
												else{
													Utility.failMessage('Please Try Again Later');
												$('#MessageBox').html('<span style=\"color: red;\">Some Error</span>');
												}
													setTimeout(function(){
														Utility.StopSpinnerMessageParent('addsizeBtn');
													},500);
											}
										});
									}
							});

						});

					</script>

				</div>
			</div>
