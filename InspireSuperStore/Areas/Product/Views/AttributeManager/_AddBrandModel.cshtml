@using MainModels.DTOModels
@using MainModels.Util
@model PagesViewModel
@{
	Layout = null;
}
<!-- Form validation -->
<div class="card shadow-5">

	<div class="card-body">

		<form id="addNewbrandModel" class="form-validate-jquery " action="#">


			<fieldset class="mb-3 ">
				<legend class="text-uppercase font-size-sm font-weight-bold">Add Brand Model</legend>



				<div class="row">
					<div class="col-lg-6">
						<div class="form-group row">
							<label for="BrandModel" class="col-form-label col-lg-3">Name <span class="text-danger">*</span></label>
							<div class="col-lg-9">
								<input type="text" id="brandModel" name="BrandModel" class="form-control" autocomplete="off" required placeholder="brandModel" />

							</div>
						</div>
					</div>
					<div class="col-lg-6">
						<div class="form-group row">
							<label for="BrandModel" class="col-form-label col-lg-3">Name <span class="text-danger">*</span></label>
							<div class="col-lg-9">
								<select id="brandId" class="form-control" required>
									<option value="">Please Select Brand</option>
									@foreach (var item in Model.Brands)
									{
										<option value="@item.BrandId">@item.BrandName</option>
									}
								</select>

							</div>
						</div>
					</div>
				</div>



			</fieldset>


			<div class="d-flex justify-content-end align-items-center">
				<button type="reset" class="btn btn-light" id="reset">Reset <i class="icon-reload-alt ml-2"></i></button>
				<button id="submitBtn" type="submit" class="btn btn-primary ml-3">Submit <i class="icon-paperplane ml-2"></i></button>
			</div>
		</form>
	</div>
</div>
<!-- /form validation -->
<script>
	$('#addNewbrandModel').submit(async function(e){
		e.preventDefault();
		var title = $('#brandModel').val();
		var formData={
			ModelName:title,
			BrandId:$('#brandId').val()
		}
		var objectData={
			url:'/AttributeManager/AddBrandModel',
			data:formData
		}
					Utility.SpinnerMessageParent('submitBtn','Loading..');
		const result = await Utility.RequestDataAjax(objectData);
					Utility.StopSpinnerMessageParent('submitBtn');

		if(result.statusCode==='200'){
						Utility.successMessage(result.Message);
						location.reload();


		}
		else{
						Utility.infoMessage(result.Message);

		}
	})
</script>