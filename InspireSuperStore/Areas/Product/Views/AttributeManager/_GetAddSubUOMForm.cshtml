@using MainModels.DTOModels
@model PagesViewModel

<div class="row">
	<!-- Left Column: Add Sub UOM Form -->
	<div class="col-lg-4">
		<div class="card border-0 shadow-sm rounded-lg overflow-hidden theme-color">
			<div class="card-header header-elements-inline py-3 border-bottom">
				<h6 class="card-title font-weight-semibold mb-0">
					<i class="icon-plus-circle2 mr-2 text-teal"></i> Add Sub UoM
				</h6>
			</div>
			<div class="card-body">
				<form id="addsubuomForm" action="#">
					<div class="form-group mb-3">
						<label class="form-label font-weight-semibold text-uppercase font-size-xs">Unit of Measure (UoM)</label>
						<select id="uomforsubuom" name="UOMId" class="form-control select">
							<option value="">Select UOM</option>
							@if (Model.UOMs != null)
							{
								@foreach (var item in Model.UOMs)
								{
									<option value="@item.Uomid">@item.UOMName</option>
								}
							}
						</select>
					</div>

					<div class="form-group mb-3">
						<label class="form-label font-weight-semibold text-uppercase font-size-xs">Sub UoM Name</label>
						<div class="form-group-feedback form-group-feedback-left">
							<input id="subuomValue" name="SubUOMName" type="text" class="form-control" placeholder="e.g., Grams, Carton, Pack">
							<div class="form-control-feedback form-control-feedback-left">
								<i class="icon-ruler text-muted"></i>
							</div>
						</div>
					</div>

					<div class="form-group mb-3">
						<label class="form-label font-weight-semibold text-uppercase font-size-xs">Conversion Factor (F-Factor)</label>
						<div class="form-group-feedback form-group-feedback-left">
							<input id="conversionFactor" name="ConversionFactor" type="number" step="any" class="form-control" placeholder="e.g., 12, 1000">
							<div class="form-control-feedback form-control-feedback-left">
								<i class="icon-calculator3 text-muted"></i>
							</div>
						</div>
						<div id="MessageBox" class="mt-2 font-size-sm"></div>
					</div>

					<div class="text-right">
						<button id="subuomsubmitBtn" type="submit" class="btn bg-teal-400 btn-labeled btn-labeled-left btn-sm font-weight-semibold rounded-pill px-3">
							<b><i class="icon-paperplane"></i></b> Save Sub UoM
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- Right Column: Existing Sub UOM Directory -->
	<div class="col-lg-8">
		<div class="card border-0 shadow-sm rounded-lg overflow-hidden theme-color">
			<div class="card-header header-elements-inline py-3 border-bottom">
				<h6 class="card-title font-weight-semibold mb-0">
					<i class="icon-list3 mr-2"></i> Sub UoM Directory
				</h6>
			</div>

			<div class="table-responsive">
				<table id="subUomTable" class="table table-striped table-hover mb-0">
					<thead>
						<tr class="font-size-xs text-uppercase font-weight-bold">
							<th style="width: 10%;">#</th>
							<th style="width: 35%;">UoM Name</th>
							<th style="width: 35%;">Sub UoM Name</th>
							<th style="width: 20%;">F-Factor</th>
						</tr>
					</thead>
					<tbody>
						@{
							int i = 1;
						}
						@if (Model.UOMs != null && Model.UOMs.Any())
						{
							@foreach (var uom in Model.UOMs)
							{
								if (uom.UOMName != null)
								{
									@foreach (var subUom in uom.subUom)
									{
										<tr>
											<td class="font-size-sm">@i</td>
											<td class="font-weight-semibold">@uom.UOMName</td>
											<td class="font-weight-semibold">@subUom.SubUOMName</td>
											<td class="font-weight-semibold text-teal-600">@subUom.ConversionFactor</td>
										</tr>
										i++;
									}
								}
							}
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<script>
	$(document).ready(function() {
		if (!$.fn.DataTable.isDataTable('#subUomTable')) {
			$('#subUomTable').DataTable({
				autoWidth: false,
				dom: '<"datatable-header"fl><"datatable-scroll"t><"datatable-footer"ip>',
				language: {
					search: '<span>Filter:</span> _INPUT_',
					searchPlaceholder: 'Type to filter...',
					lengthMenu: '<span>Show:</span> _MENU_',
					paginate: { 'first': 'First', 'last': 'Last', 'next': $('html').attr('dir') == 'rtl' ? '&larr;' : '&rarr;', 'previous': $('html').attr('dir') == 'rtl' ? '&rarr;' : '&larr;' }
				}
			});
		}

		$('#addsubuomForm').submit(function(e) {
			e.preventDefault();
			var uomId = $('#uomforsubuom').val();
			var subUomName = $.trim($('#subuomValue').val());

			if (!uomId || !subUomName) {
				$('#MessageBox').html('<span class="text-danger"><i class="icon-cancel-circle2 mr-1"></i> UoM selection and Sub UoM name are required.</span>');
				Utility.infoMessage('Empty Not Allowed');
			}
			else {
				var formData = {
					SubUOMName: subUomName,
					UOMId: uomId,
					ConversionFactor: $('#conversionFactor').val()
				};

				Utility.SpinnerMessageParent('subuomsubmitBtn', 'Loading..');
				$.ajax({
					url: '/AttributeManager/AddSubUOM',
					type: 'POST',
					data: formData,
					success: function(result) {
						if (result.statusCode === '200') {
							Utility.successMessage('Sub UoM Added Successfully');
							$('#addsubuomForm')[0].reset();
							$('#MessageBox').html('');
						} else if (result.statusCode === '300') {
							Utility.infoMessage('Record Already Exists');
							$('#MessageBox').html('<span class="text-danger"><i class="icon-warning2 mr-1"></i> This sub UoM already exists.</span>');
						} else {
							Utility.failMessage('Please Try Again Later');
							$('#MessageBox').html('<span class="text-danger"><i class="icon-cancel-circle2 mr-1"></i> An error occurred.</span>');
						}
						setTimeout(function() {
							Utility.StopSpinnerMessageParent('subuomsubmitBtn');
						}, 500);
					},
					error: function() {
						Utility.failMessage('Please Try Again Later');
						$('#MessageBox').html('<span class="text-danger"><i class="icon-cancel-circle2 mr-1"></i> Server connection error.</span>');
						setTimeout(function() {
							Utility.StopSpinnerMessageParent('subuomsubmitBtn');
						}, 500);
					}
				});
			}
		});
	});
</script>