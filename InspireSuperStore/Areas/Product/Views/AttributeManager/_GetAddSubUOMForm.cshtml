@using MainModels.DTOModels
@model PagesViewModel

<div class="card shadow-5">
	<div class="card-header header-elements-inline">
		<h5 class="card-title">Sub UOM's</h5>
		<div class="header-elements">
			<div class="list-icons">
				<a class="list-icons-item" data-action="collapse"></a>
			</div>
		</div>
	</div>

	<div class="card-body">
		<form id="addsubuomForm" action="#">
			<div class="form-group row">
				<label class="col-lg-3 col-form-label">UoM's:</label>
				<div class="col-lg-9">
					<select id="uomforsubuom" class="form-control">
						<option>Select UOM</option>
						@foreach (var item in Model.UOMs)
						{
							<option value="@item.Uomid">
								@item.UOMName
							</option>
						}
					</select>
				</div>
			</div>
			<div class="form-group row">
				<label class="col-lg-3 col-form-label">Sub UoM's:</label>
				<div class="col-lg-9">
					<input id="subuomValue" type="text" class="form-control" placeholder="UoM's">
				</div>
			</div>
			<div class="form-group row">
				<label class="col-lg-3 col-form-label">F-Factor:</label>
				<div class="col-lg-9">
					<input id="conversionFactor" type="text" class="form-control" placeholder="Conversion Factor">
				</div>
			</div>
			<div class="text-right">
				<button type="submit" id="subuomsubmitBtn" class="btn btn-primary">Submit form <i class="icon-paperplane ml-2"></i></button>
			</div>
		</form>

		<script>
			$(document).ready(function(){

				$('#addsubuomForm').submit(function(e){
					e.preventDefault();
						if(!$('#subuomValue').val()  && !$('#uomforsubuom').val()  ){
							$('#MessageBox').html('<span style=\"color: red;\">Empty not Allowed</span>');
											Utility.infoMessage('Empty Not Allowed');
						}
						else{
							var formData={
								SubUOMName : $('#subuomValue').val(),
								UOMId: $('#uomforsubuom').val(),
								ConversionFactor:  $('#conversionFactor').val()
							}

							debugger
							console.log(formData);
							Utility.SpinnerMessageParent('subuomsubmitBtn','Loading..');
							$.ajax({
								url:'/AttributeManager/AddSubUOM',
								type:'POST',
								data:formData,
								success:function(result){
									if(result.statusCode==='200'){
										Utility.successMessage('Record Added');
										$('#addsubuomForm')[0].reset();
									$('#MessageBox').html('');

									}else if(result.statusCode==='300'){
											Utility.infoMessage('Record Already Exist');
									$('#MessageBox').html('<span style=\"color: red;\">This value already exists. Duplicate entries are not allowed.</span>');

									}
									else{
										Utility.failMessage('Please Try Again Later');
									$('#MessageBox').html('<span style=\"color: red;\">Some Error</span>');
									}
										setTimeout(function(){
											Utility.StopSpinnerMessageParent('subuomsubmitBtn');
										},500);
								}
							});
						}
				});

			});

		</script>

	</div>
</div>
