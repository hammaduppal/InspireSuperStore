	<div class="row">

		<div class="col-md-6">

			<!-- Basic layout-->
			<div class="card shadow">
				<div class="card-header header-elements-inline">
					<h5 class="card-title">Department</h5>
					<div class="header-elements">
						<div class="list-icons">
							<a class="list-icons-item" data-action="collapse"></a>
						</div>
					</div>
				</div>

				<div class="card-body">
					<form id="addDepartmentForm" action="#">
						<div class="form-group row">
							<label class="col-lg-3 col-form-label">Department:</label>
							<div class="col-lg-9">
								<input type="text" id="DepartmentName" name="DepartmentName" class="form-control" placeholder="Department">
							</div>
						</div>





						<div class="text-right">
							<button type="submit" id="departmentSubmitbtn" class="btn btn-primary">Submit form <i class="icon-paperplane ml-2"></i><span id="departmentLoader"> </span></button>
						</div>
					</form>
				</div>
			</div>
			<!-- /basic layout -->
			<script>
				$(document).ready(function(){
					$('#addDepartmentForm').submit(function(e){
						e.preventDefault();
							if(!$('#DepartmentName').val()){
								$('#MessageBox').html('<span style=\"color: red;\">Empty not Allowed</span>');
												Utility.infoMessage('Empty Not Allowed');
							}
							else{
								var formData=$(this).serialize();
								Utility.SpinnerMessageParent('departmentSubmitbtn','Loading..');
								$.ajax({
									url:'/AttributeManager/AddDepartment',
									type:'POST',
									data:formData,
									success:function(result){
										if(result.statusCode==='200'){
											Utility.successMessage('Record Added');
											$('#addDepartmentForm')[0].reset();
										$('#MessageBox').html('');

										}else if(result.statusCode==='300'){
												Utility.infoMessage('Record Already Exist');
										$('#MessageBox').html('<span style=\"color: red;\">This value already exists. Duplicate entries are not allowed.</span>');

										}
										else{
											Utility.failMessage('Please Try Again Later');
										$('#MessageBox').html('<span style=\"color: red;\">Some Error</span>');
										}
											setTimeout(function(){
												Utility.StopSpinnerMessageParent('departmentSubmitbtn');
											},500);
									}
								});
							}
					});

				});
				
			</script>
		</div>

