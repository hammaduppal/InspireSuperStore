@using MainModels.DTOModels
@model PagesViewModel
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = "DCSManager";
}

<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
				<span class="breadcrumb-item active">DCS Manager</span>
			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
		</div>
	</div>


</div>
<!-- Content area -->
<div class="content">

	<!-- Horizontal form options -->

	<div class="row">

		<div id="adddepdiv" class="col-md-6">
		</div>



		<div id="addcolordiv" class="col-md-6">
		</div>


		<div id="addcatdiv" class="col-md-6">

			<!-- Basic layout-->

		</div>



		<div id="adduomdiv" class="col-md-6">
	
		</div>



		<div id="addsubcatdiv" class="col-md-6">

			<!-- Basic layout-->
		
		</div>




		<div id="addsubuomdiv" class="col-md-6">
	
		</div>










		<div id="addsizediv" class="col-md-6">
		
		</div>

		<div id="addmaterialdiv" class="col-md-6">
		
		</div>
		<div id="addBrandDiv" class="col-md-6">
		</div>
	</div>

</div>
<!-- /content area -->
<script>
	$(document).ready(function(){
		$.ajax({
			url:'/AttributeManager/_GetAddDepartmentForm',
			type:'POST',
			success:function(result){
				$('#adddepdiv').html(result)
			}


		})
			$.ajax({
			url:'/AttributeManager/_GetAddBrandForm',
			type:'POST',
			success:function(result){
				$('#addBrandDiv').html(result)
			}


		})
			$.ajax({
			url:'/AttributeManager/_GetAddColorForm',
			type:'POST',
			success:function(result){
				$('#addcolordiv').html(result)
			}


			})
			$.ajax({
			url:'/AttributeManager/_GetAddCategoryForm',
			type:'POST',
			success:function(result){
				$('#addcatdiv').html(result)
				}


			})
					$.ajax({
			url:'/AttributeManager/_GetAddUOMForm',
			type:'POST',
			success:function(result){
				$('#adduomdiv').html(result)
				}


			})
					$.ajax({
			url:'/AttributeManager/_GetAddSubCategoryForm',
			type:'POST',
			success:function(result){
				$('#addsubcatdiv').html(result)
				}


			})
					$.ajax({
			url:'/AttributeManager/_GetAddSubUOMForm',
			type:'POST',
			success:function(result){
				$('#addsubuomdiv').html(result)
				}


			})
						$.ajax({
			url:'/AttributeManager/_GetAddSizeForm',
			type:'POST',
			success:function(result){
				$('#addsizediv').html(result)
				}


			})
							$.ajax({
			url:'/AttributeManager/_GetAddMaterialForm',
			type:'POST',
			success:function(result){
				$('#addmaterialdiv').html(result)
				}


			})
	})
</script>



		