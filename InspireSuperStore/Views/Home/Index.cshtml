@using MainModels.DTOModels
@using MainModels.Util
@model PagesViewModel
@{
    ViewData["Title"] = "ERP | Inspire Nation - POS Dashboard";
}
@{
    string[] application = ["POS"];
}

<style>
    .dashboard-app-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 14px;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
    }

        .dashboard-app-card:hover {
            transform: translateY(-5px);
            border-color: #3b82f6;
            box-shadow: 0 14px 25px -5px rgba(59, 130, 246, 0.12), 0 8px 10px -6px rgba(59, 130, 246, 0.08);
        }

            .dashboard-app-card:hover img {
                transform: scale(1.1);
            }

        .dashboard-app-card img {
            transition: transform 0.25s ease;
        }

    .pos-metric-card {
        border-radius: 12px;
        overflow: hidden;
        border: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .pos-metric-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
</style>

<!-- Dashboard Header / Crumb Area -->
<div class="page-header page-header-light border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border-radius: 12px;">
    <div class="page-header-content header-elements-md-inline py-3 px-4">
        <div class="d-flex align-items-center justify-content-between w-100">
            <div class="d-flex align-items-center">
                <div class="mr-3 text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background-color: rgba(33, 150, 243, 0.12);">
                    <i class="icon-cart5 text-primary font-size-lg"></i>
                </div>
                <div>
                    <h4 class="font-weight-bold text-dark mb-0">POS & Inventory Dashboard</h4>
                    <div class="breadcrumb bg-transparent p-0 mb-0 font-size-sm">
                        <a href="/" class="breadcrumb-item text-muted"><i class="icon-home2 mr-1"></i> Home</a>
                        <span class="breadcrumb-item active text-primary font-weight-semibold">Point of Sale Terminal</span>
                    </div>
                </div>
            </div>
            <div class="header-elements d-none d-md-block">
                <div id="MessageBox" class="mb-0"></div>
            </div>
        </div>
    </div>
</div>

<div class="content">

    <!-- POS Quick-Access Module Grid -->
    <div class="row mb-4">
        @if (application.Contains("POS"))
        {
            @if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin, UserRolesConstants.POSUser))
            {
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/InvoiceManager/CreateInvoice" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/poscounter.png" alt="Sale" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">Sale</div>
                        </div>
                    </a>
                </div>
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/InvoiceManager/Invoices" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/invoices.png" alt="Invoices" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">Invoices</div>
                        </div>
                    </a>
                </div>
            }

            @if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin, UserRolesConstants.DataEntry, UserRolesConstants.Product))
            {
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/Products/Products" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/inventory.png" alt="Inventory" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">Inventory</div>
                        </div>
                    </a>
                </div>
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/AttributeManager/DCSManager" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/masterdata.png" alt="Data" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">Data</div>
                        </div>
                    </a>
                </div>
            }

            @if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin, UserRolesConstants.Purchase))
            {
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/Purchase/AddRequisitionForm" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/purchase.png" alt="Purchase" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">Purchase</div>
                        </div>
                    </a>
                </div>
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/Purchase/GoodReceivedNote" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/grn.png" alt="GRN" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">GRN</div>
                        </div>
                    </a>
                </div>
            }

            @if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin) || CheckPermissions.HasAnyRole(UserRolesConstants.Purchase))
            {
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/Supplier/Suppliers" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/supplierslist.png" alt="Suppliers" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">Suppliers</div>
                        </div>
                    </a>
                </div>
            }

            @if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin))
            {
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/collection/collections" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/colection.png" alt="Collection" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">Collection</div>
                        </div>
                    </a>
                </div>

                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/AdminPanel/LoginUser" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/loginusers.png" alt="Users" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">Users</div>
                        </div>
                    </a>
                </div>
            }

            @if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin, UserRolesConstants.Accounts))
            {
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/Accounting/ChartOfAccounts" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/coa.png" alt="COA" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">COA</div>
                        </div>
                    </a>
                </div>
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/Accounting/JournalEntries" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/journalentry.png" alt="Journals" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">Journals</div>
                        </div>
                    </a>
                </div>
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/Accounting/Ledger" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/ledgers.png" alt="Ledgers" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">Ledgers</div>
                        </div>
                    </a>
                </div>
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/Accounting/Receivables" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/receivable.png" alt="Receivables" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">Rcvable</div>
                        </div>
                    </a>
                </div>
                <div class="col-xl-1 col-lg-2 col-md-3 col-sm-4 col-6 mb-3">
                    <a href="/Accounting/Payables" class="text-decoration-none">
                        <div class="card dashboard-app-card p-3 text-center h-100">
                            <img src="~/assets/img/icons/payables.png" alt="Payables" class="img-fluid mb-2 mx-auto d-block" style="width: 44px; height: 44px;">
                            <div class="text-dark font-weight-bold text-truncate" style="font-size: 12px;">Payables</div>
                        </div>
                    </a>
                </div>
            }
        }
    </div>

    <!-- POS Metric Stat Widgets (Products, Variants, Categories, Suppliers) -->
    @if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin))
    {
        <div class="row">
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body pos-metric-card text-white shadow-sm" style="background: linear-gradient(135deg, #2196f3 0%, #1976d2 100%);">
                    <div class="media align-items-center">
                        <div class="media-body">
                            <h3 class="mb-0 font-weight-bold">@PagesViewModel.DashBoardSetting.TotalProducts</h3>
                            <span class="text-uppercase font-size-xs font-weight-semibold opacity-75">Total Products</span>
                        </div>
                        <a href="/Products/Products" class="text-white">
                            <div class="ml-3 align-self-center">
                                <i class="icon-cube2 icon-2x opacity-75"></i>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card card-body pos-metric-card text-white shadow-sm" style="background: linear-gradient(135deg, #ef5350 0%, #e53935 100%);">
                    <div class="media align-items-center">
                        <div class="media-body">
                            <h3 class="mb-0 font-weight-bold">@PagesViewModel.DashBoardSetting.TotalVariants</h3>
                            <span class="text-uppercase font-size-xs font-weight-semibold opacity-75">Total Variants</span>
                        </div>
                        <a href="/Products/Products" class="text-white">
                            <div class="ml-3 align-self-center">
                                <i class="icon-bag icon-2x opacity-75"></i>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card card-body pos-metric-card text-white shadow-sm" style="background: linear-gradient(135deg, #ab47bc 0%, #8e24aa 100%);">
                    <div class="media align-items-center">
                        <div class="media-body">
                            <h3 class="mb-0 font-weight-bold">0</h3>
                            <span class="text-uppercase font-size-xs font-weight-semibold opacity-75">Total Categories</span>
                        </div>
                        <a href="/AttributeManager/DCSManager" class="text-white">
                            <div class="ml-3 align-self-center">
                                <i class="icon-grid3 icon-2x opacity-75"></i>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card card-body pos-metric-card text-white shadow-sm" style="background: linear-gradient(135deg, #26a69a 0%, #00897b 100%);">
                    <div class="media align-items-center">
                        <div class="media-body">
                            <h3 class="mb-0 font-weight-bold">0</h3>
                            <span class="text-uppercase font-size-xs font-weight-semibold opacity-75">Total Suppliers</span>
                        </div>
                        <a href="/Supplier/Suppliers" class="text-white">
                            <div class="ml-3 align-self-center">
                                <i class="icon-users4 icon-2x opacity-75"></i>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }


  
    @if (CheckPermissions.HasAnyRole(UserRolesConstants.Accounts, UserRolesConstants.Purchase, UserRolesConstants.Admin, UserRolesConstants.POSUser))
    {
        <div class="row mt-2">
            <div class="col-lg-8">

                <div class="card border-0 shadow-lg rounded-xl h-100 theme-color overflow-hidden" style="backdrop-filter: blur(10px); border-left: 4px solid #FF9800 !important;">
                    <div class="card-header bg-transparent header-elements-inline pb-2 pt-3 border-bottom-0">
                        <div class="d-flex align-items-center">
                            <div class="mr-2 rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px; background: rgba(255, 152, 0, 0.15);">
                                <i class="icon-stats-bars2 text-warning font-size-base"></i>
                            </div>
                            <h6 class="card-title font-weight-bold mb-0" style="letter-spacing: -0.3px;">Daily Sales & Profit Analysis</h6>
                        </div>
                        <div class="header-elements">
                            <span class="badge badge-flat border-warning text-warning font-size-xs rounded-pill px-2">Real-Time</span>

                        </div>
                    </div>

                    <div class="card-body pt-1">
                        <div class="chart-container w-100">
                            <div class="chart" id="c3-bar-stacked-chart" style="width: 100%; min-height: 400px;"></div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-lg-4">
                <!-- Low Stock Alert Card -->
                <div class="card border-0 shadow-lg rounded-xl h-100 theme-color overflow-hidden" style="backdrop-filter: blur(10px); border-left: 4px solid #F44336 !important;">
                    <div class="card-header bg-transparent header-elements-inline pb-2 pt-3 border-bottom-0">
                        <div class="d-flex align-items-center">
                            <div class="mr-2 rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px; background: rgba(244, 67, 54, 0.15);">
                                <i class="icon-alert text-danger font-size-base"></i>
                            </div>
                            <h6 class="card-title font-weight-bold mb-0 text-danger" style="letter-spacing: -0.3px;">Low Stock Item Alert</h6>
                        </div>
                        <div class="header-elements">
                            <span id="lowStockBadge" class="badge badge-flat border-danger text-danger font-size-xs rounded-pill px-2">Checking...</span>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table text-nowrap table-hover mb-0">
                                <thead class="bg-light font-weight-semibold text-muted small text-uppercase">
                                    <tr>
                                        <th class="w-100 pl-3">Item</th>
                                        <th>Qty</th>
                                        <th class="text-center pr-3">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="lowStockTableBody">
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">
                                            <i class="spinner-border spinner-border-sm mr-2 text-danger"></i> Loading alerts...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            $.ajax({
                                url: '/Reports/GetLowStockAlerts', // Adjust controller route if needed
                                type: 'GET',
                                success: function (response) {
                                    var $tbody = $('#lowStockTableBody');
                                    $tbody.empty();

                                    if (response && response.statusCode === '200' && response.data && response.data.length > 0) {
                                        $('#lowStockBadge').text(response.data.length + ' Critical');

                                        response.data.forEach(function (item) {
                                            var row = `
                                                                            <tr>
                                                                                <td class="pl-3 font-weight-semibold text-dark">${item.ItemName}</td>
                                                                                <td>
                                                                                    <span class="badge badge-flat border-danger text-danger font-weight-bold px-2">${item.Quantity}</span>
                                                                                </td>
                                                                                <td class="text-center pr-3">
                                                                                    <a href="#" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-1 font-size-xs" title="Restock Item">
                                                                                        <i class="icon-cart-add mr-1"></i> Restock
                                                                                    </a>
                                                                                </td>
                                                                            </tr>
                                                                        `;
                                            $tbody.append(row);
                                        });
                                    } else {
                                        $('#lowStockBadge').text('Optimal').removeClass('border-danger text-danger').addClass('border-success text-success');
                                        $tbody.append(`
                                                                        <tr>
                                                                            <td colspan="3" class="text-center text-success py-4">
                                                                                <i class="icon-checkmark3 mr-1 text-success"></i> All stocks are optimal! No alerts found.
                                                                            </td>
                                                                        </tr>
                                                                    `);
                                    }
                                },
                                error: function (err) {
                                    console.error('Error fetching low stock alerts:', err);
                                    $('#lowStockBadge').text('Error');
                                    $('#lowStockTableBody').html(`
                                                                    <tr>
                                                                        <td colspan="3" class="text-center text-danger py-4">
                                                                            <i class="icon-cross2 mr-1"></i> Failed to load stock alerts.
                                                                        </td>
                                                                    </tr>
                                                                `);
                                }
                            });
                        });
            </script>
        </div>



        <div class="row mt-2">
            <!-- Daily Sales Chart Card -->
            <div class="col-xl-8">
              <div class="row">
    <!-- Chart 1: Monthly Sale Summary -->
    <div class="col-md-6 mb-4">
        <div class="card border-0 shadow-lg rounded-xl h-100 theme-color overflow-hidden" style="backdrop-filter: blur(10px); border-left: 4px solid #2196F3 !important;">
            <div class="card-header bg-transparent header-elements-inline pb-2 pt-3 border-bottom-0">
                <div class="d-flex align-items-center">
                    <div class="mr-2 rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px; background: rgba(33, 150, 243, 0.15);">
                        <i class="icon-stats-growth text-primary font-size-base"></i>
                    </div>
                    <h6 class="card-title font-weight-bold mb-0" style="letter-spacing: -0.3px;">Monthly Sale Summary</h6>
                </div>
                <div class="header-elements">
                    <span class="badge badge-flat border-primary text-primary font-size-xs rounded-pill px-2">Live</span>
                    <div class="list-icons ml-2">
                        <a class="list-icons-item" data-action="collapse"></a>
                        <a class="list-icons-item" data-action="reload"></a>
                    </div>
                </div>
            </div>

            <div class="card-body pt-1">
                <div class="chart-container" style="width: 100%;">
                    <div class="chart" id="c3-axis-tick-rotation" style="width: 100%; min-height: 300px;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart 2: Sales & Profit Summary -->
    <div class="col-md-6 mb-4">
        <div class="card border-0 shadow-lg rounded-xl h-100 theme-color overflow-hidden" style="backdrop-filter: blur(10px); border-left: 4px solid #26A69A !important;">
            <div class="card-header bg-transparent header-elements-inline pb-2 pt-3 border-bottom-0">
                <div class="d-flex align-items-center">
                    <div class="mr-2 rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px; background: rgba(38, 166, 154, 0.15);">
                        <i class="icon-graph text-teal font-size-base"></i>
                    </div>
                    <h6 class="card-title font-weight-bold mb-0" style="letter-spacing: -0.3px;">Sales & Profit Summary</h6>
                </div>
                <div class="header-elements">
                    <span class="badge badge-flat border-teal text-teal font-size-xs rounded-pill px-2">Optimized</span>
                    <div class="list-icons ml-2">
                        <a class="list-icons-item" data-action="collapse"></a>
                        <a class="list-icons-item" data-action="reload"></a>
                    </div>
                </div>
            </div>

            <div class="card-body pt-1">
                <div class="chart-container" style="width: 100%;">
                    <div class="chart" id="c3-axis-labels" style="width: 100%; min-height: 300px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
              
            </div>

    
        </div>
    }


</div>
<!-- /content area -->