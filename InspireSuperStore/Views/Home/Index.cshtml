                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>



                </div>
                <div class="col-lg-6">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white header-elements-inline pb-2">
                            <h5 class="card-title font-weight-bold text-dark"><i class="icon-users4 mr-2 text-indigo"></i> Team Allocation & Workflow Loads</h5>
                        </div>
                        <div class="table-responsive">
