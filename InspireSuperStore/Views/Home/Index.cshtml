@using MainModels.DTOModels
@using MainModels.Util
@{
	ViewData["Title"] = "Home Page";
}


<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">

		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>

			</div>

			<a href="#" class="header-elements-toggle text-default d-md-none"><i class="icon-more"></i></a>
			<div class="header-elements d-none">
				<div id="MessageBox" class="col-lg-12"></div>
			</div>
		</div>
	</div>


</div>

<div class="content">

	<div class="row">
		@if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin) || CheckPermissions.HasAnyRole(UserRolesConstants.POSUser))
		{
			<div class="col-1">
				<a href="/InvoiceManager/CreateInvoice" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/poscounter.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">Sale</div>
					</div>
				</a>
			</div>
			<div class="col-1">
				<a href="/InvoiceManager/Invoices" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/invoices.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">Invoices</div>
					</div>
				</a>
			</div>
		}

		@if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin, UserRolesConstants.DataEntry, UserRolesConstants.Product))
		{
			<div class="col-1">
				<a href="/Products/Products" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/inventory.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">Inventory</div>
					</div>
				</a>
			</div>
			<div class="col-1">
				<a href="/AttributeManager/DCSManager" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/masterdata.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">Data</div>
					</div>
				</a>
			</div>
		}
		@if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin,UserRolesConstants.Purchase))
		{
			<div class="col-1">
				<a href="/Purchase/AddRequisitionForm" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/purchase.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">Purchase</div>
					</div>
				</a>
			</div>
			<div class="col-1">
				<a href="/Purchase/GoodReceivedNote" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/grn.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">GRN</div>
					</div>
				</a>
			</div>

		}

		@if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin) || CheckPermissions.HasAnyRole(UserRolesConstants.Purchase))
		{
			<div class="col-1">
				<a href="/Supplier/Suppliers" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/supplierslist.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">Suppliers</div>
					</div>
				</a>
			</div>
			<div class="col-1">
				<a href="/collection/collections" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/colection.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">Collection</div>
					</div>
				</a>
			</div>

			<div class="col-1">
				<a href="/Accounting/ChartOfAccounts" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/coa.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">COA</div>
					</div>
				</a>
			</div>
			<div class="col-1">
				<a href="/Accounting/JournalEntries" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/journalentry.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">Journals</div>
					</div>
				</a>
			</div>
			<div class="col-1">
				<a href="/InvoiceManager/CreateInvoice" class="text-Accounting/Ledger-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/ledgers.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">Ledgers</div>
					</div>
				</a>
			</div>
			<div class="col-1">
				<a href="/Accounting/Receivables" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/receivable.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">Rcvable</div>
					</div>
				</a>
			</div>
			<div class="col-1">
				<a href="/Accounting/Payables" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/payables.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">Payables</div>
					</div>
				</a>
			</div>
			<div class="col-1">
				<a href="/AdminPanel/LoginUser" class="text-decoration-none">
					<div class="card shadow-sm border-0 p-2 text-center" style="background-color: #fce4ec; border-radius: 10px;">
						<img src="~/assets/img/icons/loginusers.png" alt="PosCounter" class="img-fluid mb-1 mx-auto d-block" style="width: 40px; height: 40px;">
						<div class="small text-dark fw-semibold">Users</div>
					</div>
				</a>
			</div>
		}
	</div>



	@if (CheckPermissions.HasAnyRole(UserRolesConstants.SuperAdmin))
	{
		<div class="row">
			<div class="col-sm-4 col-xl-3">
				<div class="card card-body bg-teal-300 has-bg-image shadow-3">
					<div class="media">
						<div class="media-body">
							<h3 class="mb-0">@PagesViewModel.DashBoardSetting.TotalOrganizations</h3>
							<span class="text-uppercase font-size-xs">Total Organizations</span>
						</div>
						<a href="/AdminPanel/Organizations" class="text-white">
							<div class="ml-3 align-self-center">
								<i class="icon-office icon-3x opacity-75"></i>
							</div>
						</a>
					</div>
				</div>
			</div>
			<div class="col-sm-4 col-xl-3">
				<div class="card card-body bg-blue-400 has-bg-image shadow-3">

					<div class="media">
						<div class="media-body">
							<h3 class="mb-0">@PagesViewModel.DashBoardSetting.TotalBranches</h3>
							<span class="text-uppercase font-size-xs">Total Branches</span>
						</div>
						<a href="/AdminPanel/Branches" class="text-white">
							<div class="ml-3 align-self-center">
								<i class="icon-home7  icon-3x opacity-75"></i>
							</div>
						</a>
					</div>


				</div>
			</div>
			<div class="col-sm-4 col-xl-3">
				<div class="card card-body bg-danger-400 has-bg-image shadow-3">
					<div class="media">
						<div class="media-body">
							<h3 class="mb-0">@PagesViewModel.DashBoardSetting.TotalUsers</h3>
							<span class="text-uppercase font-size-xs">Total Users</span>
						</div>
						<a href="/AdminPanel/LoginUser" class="text-white">
							<div class="ml-3 align-self-center">
								<i class="icon-users  icon-3x opacity-75"></i>
							</div>
						</a>
					</div>
				</div>
			</div>

			<div class="col-sm-4 col-xl-3">
				<div class="card card-body bg-brown has-bg-image shadow-3">
					<div class="media">
						<div class="media-body">
							<h3 class="mb-0"></h3>
							<span class="text-uppercase font-size-xs">System Prefrences</span>
						</div>
						<a href="/AdminPanel/SystemPrefrences" class="text-white">
							<div class="ml-3 align-self-center">
								<i class="icon-gear  icon-3x opacity-75"></i>
							</div>
						</a>
					</div>
				</div>
			</div>
			<div class="col-sm-4 col-xl-3">
				<div class="card card-body bg-blue-800 has-bg-image shadow-3">
					<div class="media">
						<div class="media-body">
							<h3 class="mb-0"></h3>
							<span class="text-uppercase font-size-xs">Account Prefrences</span>
						</div>
						<a href="/AdminPanel/AccountPrefrences" class="text-white">
							<div class="ml-3 align-self-center">
								<i class="icon-paste2 icon-3x opacity-75"></i>
							</div>
						</a>
					</div>
				</div>
			</div>

		</div>

	}



	@if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin))
	{
		<div class="row">
			<div class="col-sm-4 col-xl-3">
				<div class="card card-body bg-teal-300 has-bg-image shadow-3">
					<div class="media">
						<div class="media-body">
							<h3 class="mb-0">@PagesViewModel.DashBoardSetting.TotalOrganizations</h3>
							<span class="text-uppercase font-size-xs">Total Organizations</span>
						</div>
						<a href="/AdminPanel/Organizations" class="text-white">
							<div class="ml-3 align-self-center">
								<i class="icon-bag icon-3x opacity-75"></i>
							</div>
						</a>
					</div>
				</div>
			</div>
			<div class="col-sm-4 col-xl-3">
				<div class="card card-body bg-blue-400 has-bg-image shadow-3">

					<div class="media">
						<div class="media-body">
							<h3 class="mb-0">@PagesViewModel.DashBoardSetting.TotalProducts</h3>
							<span class="text-uppercase font-size-xs">Total Products</span>
						</div>
						<a href="/Products/Products" class="text-white">
							<div class="ml-3 align-self-center">
								<i class="icon-cube2 icon-3x opacity-75"></i>
							</div>
						</a>
					</div>


				</div>
			</div>
			<div class="col-sm-4 col-xl-3">
				<div class="card card-body bg-danger-400 has-bg-image shadow-3">
					<div class="media">
						<div class="media-body">
							<h3 class="mb-0">@PagesViewModel.DashBoardSetting.TotalVariants</h3>
							<span class="text-uppercase font-size-xs">Total Variants</span>
						</div>
						<a href="/Products/Products" class="text-white">
							<div class="ml-3 align-self-center">
								<i class="icon-bag icon-3x opacity-75"></i>
							</div>
						</a>
					</div>
				</div>
			</div>

			<div class="col-sm-4 col-xl-3">
				<div class="card card-body bg-brown has-bg-image shadow-3">
					<div class="media">
						<div class="media-body">
							<h3 class="mb-0">0</h3>
							<span class="text-uppercase font-size-xs">Total Categories</span>
						</div>
						<a href="/AttributeManager/DCSManager" class="text-white">
							<div class="ml-3 align-self-center">
								<i class="icon-bag icon-3x opacity-75"></i>
							</div>
						</a>
					</div>
				</div>
			</div>
			<div class="col-sm-4 col-xl-3">
				<div class="card card-body bg-blue-800 has-bg-image shadow-3">
					<div class="media">
						<div class="media-body">
							<h3 class="mb-0">0</h3>
							<span class="text-uppercase font-size-xs">Total Suppliers</span>
						</div>
						<a href="/Supplier/Suppliers" class="text-white">
							<div class="ml-3 align-self-center">
								<i class="icon-bag icon-3x opacity-75"></i>
							</div>
						</a>
					</div>
				</div>
			</div>

		</div>

	}


</div>
<!-- /content area -->