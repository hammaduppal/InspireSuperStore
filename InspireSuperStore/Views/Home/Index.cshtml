@using MainModels.DTOModels
@using MainModels.Util
@{
	ViewData["Title"] = "Home Page";
}


<!-- Page header -->
<div class="page-header page-header-light">
	<div class="page-header-content header-elements-md-inline">
		<div class="page-title d-flex">
			<h4><i class="icon-arrow-left52 mr-2"></i> <span class="font-weight-semibold">Dashboard</span> </h4>
		</div>

		<div class="header-elements d-none">
			<div class="d-flex justify-content-center">
				@if (CheckPermissions.HasAnyRole(UserRolesConstants.Admin))
				{
					<a href="#" class="btn btn-link btn-float font-size-sm font-weight-semibold text-default">
						<i class="icon-bars-alt text-pink-300"></i>
						<span>Statistics</span>
					</a>
					<a href="#" class="btn btn-link btn-float font-size-sm font-weight-semibold text-default">
						<i class="icon-calculator text-pink-300"></i>
						<span>Invoices</span>
					</a>
					<a href="#" class="btn btn-link btn-float font-size-sm font-weight-semibold text-default">
						<i class="icon-calendar5 text-pink-300"></i>
						<span>Schedule</span>
					</a>
				}
			</div>
		</div>
	</div>

	<div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline">
		<div class="d-flex">
			<div class="breadcrumb">
				<a href="/" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Home</a>
			</div>

		</div>

		<div class="header-elements d-none">
			<div id="MessageBox" class="col-lg-12"></div>
		</div>

	</div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">


	
<div class="row">
		<div class="col-sm-4 col-xl-3">
			<div class="card card-body bg-teal-300 has-bg-image shadow-3">
				<div class="media">
					<div class="media-body">
						<h3 class="mb-0">0</h3>
						<span class="text-uppercase font-size-xs">Total Invoices</span>
					</div>
					<a href="/POSManager/CreateInvoice" class="text-white">
						<div class="ml-3 align-self-center">
							<i class="icon-bag icon-3x opacity-75"></i>
						</div>
					</a>
				</div>
			</div>
		</div>
		<div class="col-sm-4 col-xl-3">
			<div class="card card-body bg-blue-400 has-bg-image shadow-3">

				<div class="media">
					<div class="media-body">
						<h3 class="mb-0">@PagesViewModel.DashBoardSetting.TotalProducts</h3>
						<span class="text-uppercase font-size-xs">Total Products</span>
					</div>
					<a href="/Products/Products" class="text-white">
						<div class="ml-3 align-self-center">
							<i class="icon-cube2 icon-3x opacity-75"></i>
						</div>
					</a>
				</div>


			</div>
		</div>
		<div class="col-sm-4 col-xl-3">
			<div class="card card-body bg-danger-400 has-bg-image shadow-3">
				<div class="media">
					<div class="media-body">
						<h3 class="mb-0">@PagesViewModel.DashBoardSetting.TotalVariants</h3>
						<span class="text-uppercase font-size-xs">Total Variants</span>
					</div>
					<a href="/Products/Products" class="text-white">
						<div class="ml-3 align-self-center">
							<i class="icon-bag icon-3x opacity-75"></i>
						</div>
					</a>
				</div>
			</div>
		</div>

		<div class="col-sm-4 col-xl-3">
			<div class="card card-body bg-brown has-bg-image shadow-3">
				<div class="media">
					<div class="media-body">
						<h3 class="mb-0">0</h3>
						<span class="text-uppercase font-size-xs">Total Categories</span>
					</div>
					<a href="/AttributeManager/DCSManager" class="text-white">
						<div class="ml-3 align-self-center">
							<i class="icon-bag icon-3x opacity-75"></i>
						</div>
					</a>
				</div>
			</div>
		</div>
		<div class="col-sm-4 col-xl-3">
			<div class="card card-body bg-blue-800 has-bg-image shadow-3">
				<div class="media">
					<div class="media-body">
						<h3 class="mb-0">0</h3>
						<span class="text-uppercase font-size-xs">Total Suppliers</span>
					</div>
					<a href="/Supplier/Suppliers" class="text-white">
						<div class="ml-3 align-self-center">
							<i class="icon-bag icon-3x opacity-75"></i>
						</div>
					</a>
				</div>
			</div>
		</div>
		
	</div>

</div>
<!-- /content area -->