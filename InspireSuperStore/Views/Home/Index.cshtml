                                                            }
                                                            else
                                                            {
                                                                <img src="@PagesViewModel.SystemSettings.ContentAPIUrl/@user.ImageUrl" class="rounded-circle" style="width:32px; height:32px; object-fit:cover;" />
                                                            }
                                                        </div>
                                                        <span class="font-weight-semibold text-body">@user.FullName</span>
                                                    </div>
                                                </td>
                                                <td class="text-center font-weight-bold text-dark font-size-sm">@user.TotalAssigned</td>
                                                <td class="text-center"><span class="badge badge-light badge-striped text-muted font-weight-semibold px-2">@user.BacklogCount</span></td>
                                                <td class="text-center"><span class="badge badge-primary font-weight-semibold px-2">@user.InProgressCount</span></td>
