@using MainModels.DTOModels
@{
    ViewData["Title"] = "Select Counter / Till";
    int maxTills = PagesViewModel.SystemSettings.AllowedTills; // Reads 3 from your SystemSettings config
}

<div class="card col-md-6 offset-md-3 mt-5 shadow-sm">
    <div class="card-header bg-transparent text-center">
        <h5 class="card-title font-weight-semibold">Select Your Counter / Till</h5>
        <span class="text-muted font-size-sm">Please choose your register terminal before continuing.</span>
    </div>
    <div class="card-body">
        <form asp-action="SelectTill" method="post">
            <div class="form-group mb-4">
                <label class="font-weight-semibold">Active Register</label>
                <select name="tillName" class="form-control" required>
                    <option value="">-- Choose Till --</option>
                    @for (int i = 1; i <= maxTills; i++)
                    {
                        <option value="Till-@i">Till-@i (Counter @i)</option>
                    }
                </select>
            </div>
            <div class="text-right">
                <button type="submit" class="btn btn-primary">
                    Confirm & Proceed <i class="icon-arrow-right14 ml-2"></i>
                </button>
            </div>
        </form>
    </div>
</div>