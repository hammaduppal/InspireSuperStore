@using MainModels.DTOModels
@using MainModels.Util
@using MarketBal.Helper
<div class="navbar-brand">
	<a href="/" class="d-inline-block">
		<img src="/assets/img/logo/logo_main.jpg"  alt="Inspire E-Comm" />
	</a>
</div>

<div class="d-md-none">
	<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbar-mobile">
		<i class="icon-tree5"></i>
	</button>
	<button class="navbar-toggler sidebar-mobile-main-toggle" type="button">
		<i class="icon-paragraph-justify3"></i>
	</button>
</div>

<div class="collapse navbar-collapse" id="navbar-mobile">
	<ul class="navbar-nav">
		<li class="nav-item">
			<a id="toggleSideBar" href="#" class="navbar-nav-link sidebar-control sidebar-main-toggle d-none d-md-block">
				<i class="icon-paragraph-justify3"></i>
			</a>
		</li>
	</ul>

	<span class="navbar-text ml-md-3">
		<span class="badge badge-mark border-orange-300 mr-2"></span>
		@if(string.IsNullOrEmpty(AppDataUtility.SessionUser.WelcomeMessage))
		{
			@GreetingHelper.GetGreeting();
		}
		else
		{
			@AppDataUtility.SessionUser.WelcomeMessage;
		}
	</span>
	&nbsp;&nbsp;&nbsp; 
	@if (AppDataUtility.SessionUser.Person != null)
	{
		<span>(@AppDataUtility.SessionUser.Person.Branch.BranchName) </span>
	}
	else
	{
		<span> (Super Admin) </span>
	}

	<ul class="navbar-nav ml-md-auto">
		<li class="nav-item dropdown">
			<a href="#" class="navbar-nav-link dropdown-toggle" data-toggle="dropdown">
				<i class="icon-paint-format mr-2"></i>
				Theme
			</a>

			<div class="dropdown-menu dropdown-menu-right dropdown-content wmin-md-250">
				<div class="dropdown-content-body p-2">
					<div class="row no-gutters text-center">

						@{
							var themes = new[] {  "blue", "green", "teal", "purple", "orange", "danger", "dark","light" };
							foreach (var color in themes)
							{
								<div class="col-3">
									<a href="#" class="d-block ripple-dark rounded p-2" onclick="changeTheme('@color')">
										<div class="rounded-circle mx-auto mb-1 bg-@color" style="width:30px; height:30px;"></div>
										<div class="font-size-xs text-uppercase">@color</div>
									</a>
								</div>
							}
						}

					</div>
				</div>
			</div>
		</li>

		
		<li class="nav-item dropdown">
			<a href="#" class="navbar-nav-link  dropdown-toggle" data-toggle="dropdown">
				<i class="icon-make-group mr-2"></i>
				Applications
			</a>

			<div class="dropdown-menu dropdown-menu-right dropdown-content wmin-md-350">
				<div class="dropdown-content-body p-2">
					<div class="row no-gutters">
						<div class="col-12 col-sm-4">
							@if (PagesViewModel.Settings.Where(x=>x.ApplicationId==1001).Any())
							{
								var cmssetting = PagesViewModel.Settings.Where(x => x.ApplicationId == 1001).FirstOrDefault();
								<a href="@AppHelper.CreateSSOURL(1001)" class="d-block text-default text-center ripple-dark rounded p-3">
									<i class="icon-diff-added text-blue-400 icon-2x"></i>
									<div class="font-size-sm font-weight-semibold text-uppercase mt-2">@cmssetting.ApplicationName</div>
								</a>
							}
							@if (PagesViewModel.Settings.Where(x => x.ApplicationId == 1003).Any())
							{
								var websetupsetting = PagesViewModel.Settings.Where(x => x.ApplicationId == 1003).FirstOrDefault();
								<a href="@AppHelper.CreateSSOURL(1003)" class="d-block text-default text-center ripple-dark rounded p-3">
									<i class="icon-versions icon-2x"></i>
									<div class="font-size-sm font-weight-semibold text-uppercase mt-2">@websetupsetting.ApplicationName</div>
								</a>
								
							}
							
							
						</div>

						<div class="col-12 col-sm-4">
							
							@if (PagesViewModel.Settings.Where(x => x.ApplicationId == 1002).Any())
							{
								var marketsetting = PagesViewModel.Settings.Where(x => x.ApplicationId == 1002).FirstOrDefault();
								<a href="@AppHelper.CreateSSOURL(1002)" class="d-block text-default text-center ripple-dark rounded p-3">
									<i class="icon-store text-pink-400 icon-2x"></i>
									<div class="font-size-sm font-weight-semibold text-uppercase mt-2">@marketsetting.ApplicationName</div>
								</a>

							}
							@if (PagesViewModel.Settings.Where(x => x.ApplicationId == 1004).Any())
							{
								var setting = PagesViewModel.Settings.Where(x => x.ApplicationId == 1004).FirstOrDefault();
								<a href="@AppHelper.CreateSSOURL(1004)" class="d-block text-default text-center ripple-dark rounded p-3">
									<i class="icon-store2 text-success-400 icon-2x"></i>
									<div class="font-size-sm font-weight-semibold text-uppercase mt-2">@setting.ApplicationName</div>
								</a>

							}

							
						</div>

					</div>
				</div>
			</div>
		</li>

		<li class="nav-item dropdown">
			<a href="#" class="navbar-nav-link dropdown-toggle" data-toggle="dropdown">
				<i class="icon-pulse2 mr-2"></i>
				Notification
			</a>

			<div class="dropdown-menu dropdown-menu-right dropdown-content wmin-md-350">
				<div class="dropdown-content-header">
					<span class="font-size-sm line-height-sm text-uppercase font-weight-semibold">Latest activity</span>
				</div>

				<div class="dropdown-content-body dropdown-scrollable">
					<ul class="media-list notificationList">
						@if(AppDataUtility.UserNotifications==null  || AppDataUtility.UserNotifications.Count==0)
						{
							<li class="media">
								<div class="mr-3">
									<a href="#" class="btn bg-success-400 rounded-round btn-icon"><i class="icon-mention"></i></a>
								</div>

								<div class="media-body">
									No Notification
								</div>
							</li>
						}
						
					

					

					
					</ul>
				</div>

				<div class="dropdown-content-footer bg-light">
					<a href="#" class="font-size-sm line-height-sm text-uppercase font-weight-semibold text-grey mr-auto">All activity</a>
					<div>
						<a href="#" class="text-grey" data-popup="tooltip" title="Clear list"><i class="icon-checkmark3"></i></a>
						<a href="#" class="text-grey ml-2" data-popup="tooltip" title="Settings"><i class="icon-gear"></i></a>
					</div>
				</div>
			</div>
		</li>

		<li class="nav-item">
			<a href="/Account/Logout" class="navbar-nav-link">
				<i class="icon-switch2"></i>
				<span class="d-md-none ml-2">Logout</span>
			</a>
		</li>
	</ul>
</div>
