@using MainModels.DTOModels
@model PagesViewModel


<div class="row">

	<div class="col-lg-4">
		<div class="form-group">
			<label>Country:</label>
			<select id="country" data-placeholder="Enter 'Country'" class="form-control select-minimum" data-fouc>
				<option>Select Country</option>
				<optgroup label="Country">
					@foreach (var country in Model.Countries)
					{
						<option value="@country.CountryId">@country.CountryName</option>
					}
				</optgroup>
			</select>
		</div>
	</div>

	<div class="col-lg-4">
		<div class="form-group">
			<label>State Province:</label>
			<select id="province" data-placeholder="Enter 'State'" class="form-control select-minimum" data-fouc>
				<option>Select</option>
				<optgroup label="State">

				</optgroup>
			</select>
		</div>
	</div>
	<div class="col-lg-4">
		<div class="form-group">
			<label>City:</label>
			<select id="city" data-placeholder="Enter 'cat'" class="form-control select-minimum" data-fouc>
				<option>Select</option>
				<optgroup label="City">

				</optgroup>
			</select>
		</div>
	</div>


</div>

<script>
					$('#country').change(async function(){
			var CountryId=$(this).val();
		var states = await GetStates(CountryId);
		debugger

							$('#province').empty();
							$('#city').empty();


								  states.forEach(function(province) {
										$('#province').append(`<option value="${province.StateProvinceId}">${province.StateProvinceName}</option>`);
								  });
								  var firstState = states[0];
								  var cities = await GetCities(firstState.StateProvinceId);
									cities.forEach(function(city) {
										$('#city').append(`<option value="${city.CityId}">${city.CityName}</option>`);
								  });
								  console.log(firstState);
		})
		$('#province').change(async function(){
			debugger
			var StateId=$(this).val();
			var formData={
				StateProvinceId:StateId
			}
			var objectData={
				data:formData,
				url:'/AdminPanel/GetCityByStateId/'
			}
			const result = await Utility.RequestDataAjax(objectData);
							$('#city').empty();
								  result.forEach(function(province) {
										$('#city').append(`<option value="${province.CityId}">${province.CityName}</option>`);
								  });
		})

				async function GetCities(Id){
		debugger
			var formData={
				StateProvinceId:Id
			}
			var objectData={
				data:formData,
				url:'/AdminPanel/GetCityByStateId/'
			}
			const result = await Utility.RequestDataAjax(objectData);
			return result
	}
	async function GetStates(Id){
		debugger
			var formData={
				CountryId:Id
			}
			var objectData={
				data:formData,
				url:'/AdminPanel/GetStatesByCountryId/'
			}
			const result = await Utility.RequestDataAjax(objectData);
			return result
	}
</script>