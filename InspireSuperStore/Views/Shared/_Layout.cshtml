            &copy; 2024 - InspireSuperStore - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script>
        $('#toggleSideBar').on('click',function(){
             $.ajax({
                url:'/Home/ToggleSideMenu/',
                type:'POST',
                success:function(e){
                    console.log(e);
                }
            })
        })
                document.addEventListener('DOMContentLoaded', () => {
                    
          const currentPath = window.location.pathname.toLowerCase();

          document.querySelectorAll('.nav-sidebar .nav-link').forEach(link => {
            if (link.getAttribute('href').toLowerCase() === currentPath) {
              link.classList.add('active');

              let li = link.closest('.nav-item-submenu');
              while (li) {
                li.classList.add('nav-item-expanded', 'nav-item-open');
                li = li.parentElement.closest('.nav-item-submenu');
              }
            }
          });
        });

     
