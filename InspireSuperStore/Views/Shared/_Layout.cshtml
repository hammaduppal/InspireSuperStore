	<script>
		 const connection = new signalR.HubConnectionBuilder()
		.withUrl("/notificationHub")
		.withAutomaticReconnect() // <--- this enables default retry behavior
		.configureLogging(signalR.LogLevel.Information)
		.build();

		connection.on("ReceiveNotification", function (messageJson) {
			debugger
			var message = JSON.parse(messageJson);
			renderNotification(message, true); 

					   playalarmnewOrder();
			Utility.successMessage('New Order Recieved');
		});
		function renderNotification(message, prepend = false) {
			var params = {};
			try {
				params = JSON.parse(message.Params || "{}");
			} catch (e) {
				console.warn("Invalid Params JSON:", message.Params);
			}

			var createdAt = new Date(message.CreatedAt);

			var li = `
				<li class="media">
					<div class="mr-3">
						<a href="/PosManager/Order/${params.OrderId ?? ''}"
						   class="btn bg-purple-300 rounded-round btn-icon">
							<i class="icon-truck"></i>
						</a>
					</div>
					<div class="media-body">
						<div>
							<strong>${message.GroupName}</strong> – ${message.Message ?? "New notification"}
						</div>
						<div class="text-muted font-size-sm">
							${params.OrderNumber ?? "Order"} | ${params.CustomerName ?? ""}
						</div>
						<div class="font-size-sm text-muted mt-1">
							${createdAt.toLocaleString("en-GB", {
								day: "2-digit", month: "short", year: "numeric",
								hour: "2-digit", minute: "2-digit"
							})}
						</div>
					</div>
				</li>
			`;

			var $list = $(".notificationList");

			if ($list.find("li").length === 1 &&
				$list.find("li .media-body").text().trim() === "No Notification") {
				$list.empty();
			}

			if (prepend) {
				$list.prepend(li);
			} else {
				$list.append(li);
			}
		}

		var notifications = @Html.Raw(JsonConvert.SerializeObject(AppDataUtility.UserNotifications));
		notifications.forEach(n => renderNotification(n));

		
		connection.start().then(function () {
		}).catch(function (err) {
			return console.error(err.toString());
		});

		connection.onreconnecting((error) => {
			console.warn("SignalR connection lost. Attempting to reconnect...", error);
			// Optionally show a message to the user
		});
			connection.onreconnected((connectionId) => {
						// Optionally update UI or re-sync data
			});
		
			function sendTest() {
			  fetch('/Home/SendTestMessage', { method: 'POST' });
			}
		
		function playalarmnewOrder() {
					var audio = document.getElementById("newOrderSound");
					if (audio) {
						audio.currentTime = 0; // restart if already playing
						audio.play().catch(err => console.warn("Autoplay blocked:", err));
					}
				}

	</script>

