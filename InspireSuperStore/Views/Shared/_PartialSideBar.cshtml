<script>
	document.addEventListener("DOMContentLoaded", function () {
		const searchInput = document.getElementById("searchmenu");
		const submenus = document.querySelectorAll(".nav-item-submenu");

		searchInput.addEventListener("keyup", function () {
			const filter = this.value.toLowerCase().trim();
			const allItems = document.querySelectorAll(".nav-sidebar .nav-item");

			// reset all visibility
			allItems.forEach(item => item.style.display = "");

			if (filter === "") {
				// collapse all submenus
				submenus.forEach(submenu => {
					submenu.classList.remove("nav-item-open");
					const subGroup = submenu.querySelector(".nav-group-sub");
					if (subGroup) subGroup.style.display = "none";
				});
				return;
			}

			submenus.forEach(submenu => {
				let matchFound = false;

				const mainLink = submenu.querySelector(".nav-link"); // ✅ fixed selector
				const subLinks = submenu.querySelectorAll(".nav-group-sub .nav-item");

				// check parent link text
				if (mainLink && mainLink.textContent.toLowerCase().includes(filter)) {
					matchFound = true;
				}

				// check sub links
				subLinks.forEach(sub => {
					const linkText = sub.textContent.toLowerCase();
					if (linkText.includes(filter)) {
						matchFound = true;
						sub.style.display = "";
					} else {
						sub.style.display = "none";
					}
				});

				// toggle submenu visibility
				const subGroup = submenu.querySelector(".nav-group-sub");
				if (matchFound) {
					submenu.classList.add("nav-item-open");
					if (subGroup) subGroup.style.display = "block";
					submenu.style.display = "";
				} else {
					submenu.classList.remove("nav-item-open");
					if (subGroup) subGroup.style.display = "none";
					submenu.style.display = "none";
				}
			});

			// handle top-level items (like Dashboard)
			document.querySelectorAll(".nav-sidebar > .nav-item:not(.nav-item-submenu)").forEach(item => {
				const text = item.textContent.toLowerCase();
				item.style.display = text.includes(filter) ? "" : "none";
			});
		});
	});
</script>
