@{
	Layout = null;
}
<form>
	<div class="row">
		<div class="col-lg-6">
			<div class="form-group row">
				<label for="name" class="col-form-label col-lg-3">Name <span class="text-danger">*</span></label>
				<div class="col-lg-9">
					<input type="text" id="name" name="name" class="form-control" autocomplete="off" required placeholder="Enter Name" />

				</div>
			</div>
		</div>
		<div class="col-lg-6">
			<div class="form-group row">
				<label for="Second Value" class="col-form-label col-lg-3">Password <span class="text-danger">*</span></label>
				<div class="col-lg-9">
					<div class="form-group-feedback form-group-feedback-right">
						<input type="text" id="secondName" name="secondName" class="form-control" autocomplete="off" required placeholder="Second Name" />
					
					</div>
				</div>
			</div>
		</div>
	</div>
</form>
